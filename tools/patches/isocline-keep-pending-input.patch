Keep queued terminal input across raw-mode switches, so a multi-line paste runs
every line instead of only the first.

A terminal delivers a pasted block in one go, with each line break as CR.
isocline reads up to the first CR (KEY_ENTER in editline.c ends the line) and
returns it; the rest of the paste sits in the tty input queue waiting for the
next ic_readline. TCSAFLUSH discards exactly that queue — POSIX defines it as
"change attributes after draining output, discarding any input not yet read" —
so every line after the first is thrown away when tty_end_raw runs.

TCSADRAIN still waits for pending output to drain before changing the mode, but
leaves unread input alone. Stray terminal replies (a late cursor-position
report, say) are already dropped explicitly by the `tty->cpush_count = 0` on the
line above.

--- a/src/tty.c
+++ b/src/tty.c
@@ -653,7 +653,7 @@
 ic_private bool tty_start_raw(tty_t* tty) {
   if (tty == NULL) return false;
   if (tty->raw_enabled) return true;
-  if (tcsetattr(tty->fd_in,TCSAFLUSH,&tty->raw_ios) < 0) return false;
+  if (tcsetattr(tty->fd_in,TCSADRAIN,&tty->raw_ios) < 0) return false;
   tty->raw_enabled = true;
   return true;
 }
@@ -662,7 +662,7 @@
 ic_private void tty_end_raw(tty_t* tty) {
   if (tty == NULL) return;
   if (!tty->raw_enabled) return;
   tty->cpush_count = 0;
-  if (tcsetattr(tty->fd_in,TCSAFLUSH,&tty->orig_ios) < 0) return;
+  if (tcsetattr(tty->fd_in,TCSADRAIN,&tty->orig_ios) < 0) return;
   tty->raw_enabled = false;
 }

