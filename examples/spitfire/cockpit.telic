	[ [ 102 "HEAT" ] [ 118 "NAV" ] [ 134 "CINE" ] ] ( toggle |
		toggle spread to name to x
		x panel-top 207 + name 4 dial-ink centred-lettering
		x panel-top 230 + draw-toggle
	) each ;

\ the fuel gauge's selector beside the boost gauge, following the cock: on the centre tank, the reserve, while the engine draws from it, otherwise toward the port wing tank for the main tanks read together; PUSH FOR READING under it as the plate reads
: draw-fuel-selector ( cx cy -- )
	| cx cy |
	plane@fuel-cock :reserve = if 0 else -1.2 then to angle
	cx cy 4 dial-ink draw-circle
	cx cy 4 angle 1.75 needle-colour hand
	cx 10 - cy 2 + "P" dial-ink centred-text
	cx cy 16 - "C" dial-ink centred-text
	cx 10 + cy 2 + "S" dial-ink centred-text
