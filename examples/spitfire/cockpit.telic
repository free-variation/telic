	| left right top colour |
	left top right left - screen-height top - colour fill-span
	left top right left - screen-height top - edge-colour outline ;

\ the undercarriage indicator, as the labelled cockpit shows it: UP over two windows and DOWN under two more, P and S either side, the upper pair red while the wheels are locked up, the lower pair green when locked down, all dark while they travel
: draw-hurricane-undercarriage ( cx cy -- )
	| cx cy |
	plane@gear-position to position
	cx cy small-radius dial-face
	cx cy 14 - "UP" 4 dial-ink centred-lettering
	cx cy 9 + "DOWN" 4 dial-ink centred-lettering
	cx 13 - cy 2 - "P" 4 dial-ink centred-lettering
	cx 13 + cy 2 - "S" 4 dial-ink centred-lettering
	[ -7 2 ] ( x | cx x + cy 7 - 5 3 position 0 = if 0xe04030 else 0x401010 then fill-span ) each
	[ -7 2 ] ( x | cx x + cy 1 + 5 3 position 1 = if 0x40e040 else 0x103010 then fill-span ) each ;

\ the oxygen regulator, its dials of a radius 20, the picture's size against the flying six: its nameplate across the top, DELIVERY and SUPPLY over its two dials; the delivery dial set for the height above 10,000 ft, the supply dial full, the upper left of its face red; the brass handle of its valve between them
: draw-hurricane-oxygen ( cx cy -- )
	| cx cy |
	20 to radius
	cx 46 - cy 40 - 92 11 0x050505 fill-span
	cx 46 - cy 40 - 92 11 dial-ink 0.6 dimmed outline
	cx cy 38 - "OXYGEN REGULATOR" dial-ink centred-text
	cx 24 - cy 27 - "DELIVERY" 4 dial-ink centred-lettering
	cx 24 + cy 27 - "SUPPLY" 4 dial-ink centred-lettering
	plane@position second 3.28084 * 1000 / to thousands
	thousands 10 < if 0 else thousands then to delivery
	cx 24 - cy radius delivery 0 40 6 [ ] "" sweep-dial
	cx 24 + to supply-x
	supply-x cy radius dial-face
	0 17 1 do k
		k 0.1 * 1.9 - to angle
		supply-x angle sin radius 0.35 * * + cy angle cos radius 0.35 * * -
		supply-x angle sin radius 0.9 * * + cy angle cos radius 0.9 * * -
		warning-colour 0.7 dimmed draw-segment
	loop
	supply-x cy radius 4 sweep-ticks
	supply-x cy radius 1 0 1 sweep 0.85 needle-colour hand
	cx 9 - cy 5 + 18 3 brass-colour fill-span
	cx cy 6 + 3 brass-colour fill-disc ;

\ the clock, after the Smiths eight-day with trip hands, of the medium radius, the picture's size against the flying six: numerals 1 to 12 inside a ring of hour ticks, the hour and minute hands moved on from twelve by the flight's time and the seconds hand sweeping; at the twelve position the Time of Trip register, a subsidiary dial whose own hour and minute hands read the flight's time from zero
: draw-trip-clock ( cx cy -- )
	| cx cy |
	game :flight-time 0 @or to seconds
	cx cy medium-radius dial-face
	0 12 1 do k
		k 12 / TAU * to angle
		cx angle sin medium-radius 0.9 * * + cy angle cos medium-radius 0.9 * * -
		cx angle sin medium-radius * + cy angle cos medium-radius * - dial-ink draw-segment
		cx angle sin medium-radius 0.76 * * + cy angle cos medium-radius 0.76 * * - 2.5 -
		k 0 = if 12 else k then "{0}" format 5 dial-ink centred-lettering
	loop
	cy medium-radius 0.36 * - to trip-y
	medium-radius 0.23 * to trip-radius
	cx trip-y trip-radius dial-ink draw-circle
	cx trip-y trip-radius 12 dial-ticks
	cx trip-y trip-radius seconds 43200 / TAU * 0.55 dial-ink hand
	cx trip-y trip-radius seconds 3600 / TAU * 0.85 dial-ink hand
	cx cy medium-radius seconds 43200 / TAU * 0.5 dial-ink hand
	cx cy medium-radius seconds 3600 / TAU * 0.78 needle-colour hand
	cx cy medium-radius seconds 60 / TAU * 0.9 dial-ink hand
	cx cy 2 dial-ink fill-disc ;

