	60 panel-top 176 + 580 panel-top 176 + edge-colour draw-segment
	60 panel-top 176 + 60 panel-top 228 + edge-colour draw-segment
	580 panel-top 176 + 580 panel-top 228 + edge-colour draw-segment
	236 gladiator-gauge-row draw-gladiator-fuel
	278 gladiator-gauge-row draw-brake-gauge
	362 gladiator-gauge-row plane@oil-temperature 0 140 "OIL" draw-foot-dial
	362 gladiator-gauge-row small-radius 1 + oil-gauge-colour draw-circle
	420 gladiator-gauge-row 6 - plane@cranking if 0xff5040 else 0x902018 then "" draw-push-button
	403 gladiator-gauge-row 6 + 34 9 warning-colour 0.6 dimmed fill-span
	420 gladiator-gauge-row 8 + "STARTER" dial-ink centred-text
