	cx cy 15 + "READING" 4 dial-ink centred-lettering ;

\ the Hurricane's fuel gauge, the hanging-needle face: the gallons in the tanks the cock draws from, the main tanks together or the reserve, over that store's capacity
: draw-hurricane-fuel ( cx cy -- )
	| cx cy |
	plane@reserve-fuel to reserve
	plane@fuel-cock :reserve = if
		reserve plane@type@reserve-capacity
	else
		plane@fuel reserve - plane@fuel-capacity plane@type@reserve-capacity -
	then to capacity to gallons
	cx cy gallons capacity / capacity draw-hanging-fuel ;

\ the oil temperature's dial rim and the oil pressure's frame, orange as in photographs of the cockpit; the radiator temperature's rim, brass
0xc07028 constant oil-gauge-colour

\ an upright strip gauge in a coloured frame: its window, five ticks, the pointer at a share of the scale, its name under it
: draw-strip-gauge ( x top width height share colour name -- )
	| x top width height share colour name |
	x width 2 / - top width height colour fill-span
	x width 2 / - 3 + top 3 + width 6 - height 6 - dial-colour fill-span
	0 5 1 do k
		x width 2 / - 3 + top 5 + k height 10 - 4 / * + x top 5 + k height 10 - 4 / * + dial-ink draw-segment
	loop
	top height + 5 - share 0 1 clamp height 10 - * - to level
	x width 2 / - 3 + level x width 2 / + 3 - level needle-colour draw-segment
	x top height + 2 + name dial-ink centred-text ;

\ the fuel pressure, as a share of its scale: steady while the engine runs on the tanks the cock draws from (the figure an estimate), none once they are dry or the engine dead
: fuel-pressure-share ( -- share )
	plane@engine-dead plane@fuel-starved or if 0 else 0.6 then ;

\ the Hurricane's revolution counter, a single hand over hundreds of revolutions a minute from 16 to 40, R.P.M. on its face above the centre
: draw-hundreds-revolutions ( cx cy -- )
	| cx cy |
	plane@revolutions plane@type@rated-revolutions * 100 / to hundreds
	cx cy medium-radius hundreds 16 40 6 [ [ 16 "16" ] [ 24 "24" ] [ 32 "32" ] [ 40 "40" ] ] "" sweep-dial
	cx cy 4 - "R.P.M." 4 dial-ink centred-lettering ;

\ the Hurricane's boost gauge in its red rim, BOOST and PRESS on its face
: draw-hurricane-boost ( cx cy -- )
	| cx cy |
	cx cy medium-radius dial-face
	cx cy medium-radius 9 sweep-ticks
	cx cy medium-radius -6 12 [ [ -4 "-4" ] [ 0 "0" ] [ 4 "4" ] [ 8 "8" ] [ 12 "12" ] ] sweep-numerals
	cx cy 9 - "BOOST" 4 dial-ink centred-lettering
	cx cy 5 + "PRESS" 4 dial-ink centred-lettering
	cx cy medium-radius plane@boost -6 12 sweep 0.85 needle-colour hand
	cx cy medium-radius boost-rim-colour draw-circle
	cx cy medium-radius 1 + boost-rim-colour draw-circle ;

\ the right board of the Hurricane's panel, after the labelled cockpit: the revolution counter at the top left and the gunsight's switch at the top right; the boost gauge under the counter and the fuel gauge's selector under the switch; the oil pressure's orange strip and the fuel pressure's red one side by side under the boost gauge, the fuel gauge beside them; the oil and radiator temperatures along the foot, their rims orange and brass, the starting magneto's switch and the primer's knob at the right. The sight switch, the starting magneto switch and the primer are drawn and do nothing
: draw-hurricane-right ( -- )
	448 590 panel-top 40 + board-colour draw-tall-board
	486 panel-top 68 + draw-hundreds-revolutions
	560 panel-top 70 + draw-toggle
	560 panel-top 72 + "SIGHT" 4 dial-ink centred-lettering
	486 panel-top 122 + draw-hurricane-boost
	560 panel-top 116 + draw-fuel-selector
	466 panel-top 150 + 20 28 plane@oil-pressure 120 / oil-gauge-colour "OIL" draw-strip-gauge
	490 panel-top 150 + 20 28 fuel-pressure-share boost-rim-colour "FUEL" draw-strip-gauge
	560 panel-top 176 + draw-hurricane-fuel
	470 panel-top 204 + plane@oil-temperature "OIL" null draw-temperature
	470 panel-top 204 + small-radius 1 + oil-gauge-colour draw-circle
	512 panel-top 204 + plane@coolant-temperature "RAD" plane@type@temperature-limit draw-temperature
	512 panel-top 204 + small-radius 1 + brass-colour 0.8 dimmed draw-circle
	552 panel-top 204 + "START" 4 dial-ink centred-lettering
	552 panel-top 226 + draw-toggle
	576 panel-top 209 + "PRIMER" 4 dial-ink centred-lettering
	576 panel-top 222 + 5 brass-colour fill-disc ;

\ how long the Hurricane's wheels and flaps lever stays in its slot after it is moved, seconds: the flaps' travel, and an estimate for the wheels
2 constant selector-hold

\ the right wall: the flaps' indicator, their placard, and the wheels and flaps lever in its gate: after G or F, in the wheels' slot (W) or the flaps' (F), at UP or DOWN as they were sent, until it is put back in neutral
: draw-selector-gate ( -- )
	615 to cx
	cx panel-top 58 + 12 dial-face
	cx panel-top 58 + 12 plane@flap-setting 0 1 sweep 0.85 needle-colour hand
	cx panel-top 40 + "FLAPS" dial-ink centred-text
	panel-top 76 + to plate-top
	594 plate-top 42 58 0x050505 fill-span
	594 plate-top 42 58 dial-ink outline
	[ "DO NOT" "LOWER" "FLAPS" "ABOVE" plane@type@flap-limit "{0} MPH" format ] to plate-lines
	0 plate-lines size 1 do k
		cx plate-top 4 + k 10 * + plate-lines k @i k 4 = if warning-colour else dial-ink then centred-text
	loop
	plate-top 64 + to gate-top
	604 gate-top 604 gate-top 44 + dial-ink draw-segment
	626 gate-top 626 gate-top 44 + dial-ink draw-segment
	604 gate-top 22 + 626 gate-top 22 + dial-ink draw-segment
	plane :selector-left 0 @or 0 > if
		plane :selector-slot :wheels @or to slot
		slot :wheels = if 604 plane@gear else 626 plane@flaps then to lowered to knob-x
		knob-x gate-top lowered if 40 else 4 then + 5 needle-colour fill-disc
	else
		cx gate-top 22 + 5 needle-colour fill-disc
	then
	604 gate-top 48 + "W" dial-ink centred-text
	626 gate-top 48 + "F" dial-ink centred-text ;

\ the compass low beside the column: its bowl, the lubber line, and the needle pointing north as the aircraft turns
: draw-compass ( cx cy -- )
	| cx cy |
	cx cy 15 dial-face
	cx cy 15 - cx cy 11 - dial-ink draw-segment
	plane@attitude@forward heading-of negate PI 180 / * to north
	cx cy 15 north 0.8 needle-colour hand
	cx cy 15 north PI + 0.5 dial-ink hand ;

\ the control column standing at a place across and its ring grip at a row, as the Spitfire's
: draw-ring-column ( centre-x grip-row -- )
	| centre-x grip-row |
	centre-x controls@roll 14 * + to grip-x
	grip-row controls@pitch 10 * + to grip-y
	grip-y 42 + to shaft-top
	-5 6 1 do k
		centre-x k + screen-height grip-x k + shaft-top grip-colour draw-segment
	loop
	centre-x 6 - screen-height grip-x 6 - shaft-top grip-edge-colour draw-segment
	centre-x 6 + screen-height grip-x 6 + shaft-top grip-edge-colour draw-segment
	grip-x grip-y 30 42 grip-colour fill-ring
	grip-x grip-y 42 grip-edge-colour draw-circle
	grip-x grip-y 30 grip-edge-colour draw-circle
	grip-x 25 - grip-y 25 - 7 :firing game@ if 0xff4030 else brass-colour then fill-disc ;

\ the Hurricane's column, its grip over its lower row
: draw-hurricane-column ( -- ) 320 hurricane-lower-row draw-ring-column ;

\ the reflector sight's pedestal on the coaming above the blind-flying panel, and its padded crash pad
: draw-sight-pedestal ( -- )
	306 panel-top 12 + 28 blind-panel-top panel-top - 12 - 0x0a0a0a fill-span
	306 panel-top 12 + 28 blind-panel-top panel-top - 12 - edge-colour outline
	296 panel-top 2 + 48 10 0x8a7a58 fill-span
	296 panel-top 2 + 48 10 edge-colour outline ;

\ the Hurricane's elevator trim handwheel on the left wall, seen edge-on: its wooden rim, the grain bars rolling up with the setting as the wheel is turned aft for nose up, a faint outline for a control mostly off the screen
: draw-wooden-wheel ( cx cy half-width half-height setting -- )
	| cx cy half-width half-height setting |
	cx half-width - cy half-height - half-width 2 * half-height 2 * 0x6a4420 wall-colour translucent fill-span
	cx half-width - cy half-height - half-width 2 * half-height 2 * pedal-colour lighting dimmed outline
	half-height 2 * to span
	0 span 8 / round 1 do k
		k 8 * setting 15 * + span mod span + span mod cy half-height - + round to y
		cx half-width - y cx half-width + y 0x3a2410 wall-colour translucent draw-segment
	loop ;

\ the elevator trim's indicator beside the wheel: a plate lettered NOSE DOWN above and NOSE UP below, the pointer on its threaded rod between them, down for nose up with the tab's share
: draw-trim-indicator ( cx top -- )
	| cx top |
	cx 11 - top 22 46 0x101010 wall-colour translucent fill-span
	cx 11 - top 22 46 dial-ink 0.6 dimmed wall-colour translucent outline
	cx top 2 + "NOSE" 4 dial-ink wall-colour translucent centred-lettering
	cx top 7 + "DOWN" 4 dial-ink wall-colour translucent centred-lettering
	cx top 34 + "NOSE" 4 dial-ink wall-colour translucent centred-lettering
	cx top 39 + "UP" 4 dial-ink wall-colour translucent centred-lettering
	cx top 13 + cx top 32 + edge-colour wall-colour translucent draw-segment
	top 22 + plane@trim -1 1 clamp 7 * + round to y
	cx 3 - y cx y 3 - cx 3 + y needle-colour wall-colour translucent fill-face
	cx 3 - y cx y 3 + cx 3 + y needle-colour wall-colour translucent fill-face ;

\ the rudder bias knob on the frame tube above the wheel, face-on as the cockpit models show it: a black dodecagon with a lug on every other side, turning with the setting, a white arc across its top with the index line under it turning too, lettered RUDDER TRIM
: draw-bias-knob ( cx cy radius -- )
	| cx cy radius |
	plane@rudder-trim 0.6 * to turn
	pedal-colour lighting dimmed to colour
	0 12 1 do k
		k 30 * PI * 180 / turn + to from
		k 1+ 30 * PI * 180 / turn + to onto
		cx from sin radius * + to from-x
		cy from cos radius * - to from-y
		cx onto sin radius * + to onto-x
		cy onto cos radius * - to onto-y
		cx cy from-x from-y onto-x onto-y 0x101010 wall-colour translucent fill-face
		from-x from-y onto-x onto-y colour draw-segment
		k 2 mod 0 = if
			k 0.5 + 30 * PI * 180 / turn + to normal
			normal sin 2.5 * to lug-dx
			normal cos 2.5 * negate to lug-dy
			from-x 0.85 * onto-x 0.15 * + to a-x
			from-y 0.85 * onto-y 0.15 * + to a-y
			onto-x 0.85 * from-x 0.15 * + to b-x
			onto-y 0.85 * from-y 0.15 * + to b-y
			a-x a-y b-x b-y b-x lug-dx + b-y lug-dy + 0x101010 wall-colour translucent fill-face
			a-x a-y b-x lug-dx + b-y lug-dy + a-x lug-dx + a-y lug-dy + 0x101010 wall-colour translucent fill-face
			a-x a-y a-x lug-dx + a-y lug-dy + colour draw-segment
			a-x lug-dx + a-y lug-dy + b-x lug-dx + b-y lug-dy + colour draw-segment
			b-x lug-dx + b-y lug-dy + b-x b-y colour draw-segment
		then
	loop
	radius 0.8 * to arc
	0 20 1 do k
		k 20 / 100 * 50 - PI * 180 / to from
		k 1+ 20 / 100 * 50 - PI * 180 / to onto
		cx from sin arc * + cy from cos arc * - cx onto sin arc * + cy onto cos arc * - dial-ink wall-colour translucent draw-segment
	loop
	cx turn sin arc 0.4 * * + cy turn cos arc 0.4 * * - cx turn sin arc * + cy turn cos arc * - dial-ink wall-colour translucent draw-segment
	cx cy 3 - "RUDDER" 4 dial-ink wall-colour translucent centred-lettering
	cx cy 3 + "TRIM" 4 dial-ink wall-colour translucent centred-lettering ;

\ the Hurricane's cockpit below the windscreen
: draw-hurricane-panel ( -- )
	0 arched-view-rows view-width screen-height arched-view-rows - wall-colour fill-span
	0 64 1 do k k 10 * k 1+ 10 * 0 arched-view-rows wall-colour fill-under-arch loop
	draw-hurricane-left
	draw-hurricane-right
	194 446 blind-panel-colour draw-board
	draw-sight-pedestal
	236 hurricane-upper-row draw-airspeed
	320 hurricane-upper-row draw-horizon
	404 hurricane-upper-row draw-climb
	236 hurricane-lower-row draw-altimeter
	320 hurricane-lower-row draw-gyro
	404 hurricane-lower-row draw-turn-and-slip
	draw-selector-gate
	draw-throttle-lever
	20 panel-top 70 + 16 draw-bias-knob
	9 panel-top 128 + 5 40 plane@trim draw-wooden-wheel
	28 panel-top 105 + draw-trim-indicator
	320 panel-top 208 + draw-bowl-compass
	236 404 draw-frame-pedals
	draw-hurricane-column ;

\ the Hurricane's windscreen in the view, faint: the armoured centre panel's frame, its two posts rising from the coaming either side of the sight, leaning in, to the top rail across them; from the rail's ends the side panes' top edges running back over the pilot's head out of the view (positions in the view estimates)
: draw-hurricane-windscreen ( -- )
	sight-frame-colour lighting dimmed to colour
	view-centre-x to cx
	30 to rail-top
	view-height 1 - rail-top - 12 * 150 / to lean
	[ -1 1 ] ( side |
		cx side 96 * + panel-top 4 + cx side 96 lean - * + rail-top colour draw-clipped
		cx side 100 * + panel-top 4 + cx side 100 lean - * + rail-top colour draw-clipped
		cx side 100 lean - * + rail-top cx side view-width 2 / * + 0 colour draw-clipped
		cx side 100 lean - * + rail-top 4 + cx side view-width 2 / * + 4 colour draw-clipped
	) each
	cx 100 lean - - rail-top cx 100 lean - + rail-top colour draw-clipped
	cx 96 lean - - rail-top 4 + cx 96 lean - + rail-top 4 + colour draw-clipped ;

\ === the Lysander's cockpit ===

\ The Lysander's cockpit, laid out from two photographs of Lysanders'
\ instrument panels: one black board across the cockpit, the blind-flying
\ panel's six dials in its middle. To their right the fuel contents' red
\ strip gauge at the top, the priming button, the starter's red button,
\ the boost pump's and the starting magneto's switches and a green lamp,
\ the cylinder temperature's large dial, 100 to 300°C, the Perseus's
\ air-cooled cylinders taking the place of a radiator, the boost gauge in
\ its red rim, the revolution counter numbered 12 to 34 hundred, and along
\ the foot the oil's pressure and temperature and the free air's
\ temperature. To their left the magneto switches, the clock and the
\ brakes' pressure, a row of toggle switches and four banks of four
\ switches. Below the panel the fire extinguisher's red button and the
\ cockpit cooling's white knob, the compass, the throttle and the
\ two-pitch propeller's lever, the tailplane's trim wheel on the left
\ wall, the variable-incidence tailplane the Lysander trimmed by, the
\ pedals and the column's ring grip. The switches, the lamp, the priming
\ button, the fire button and the cooling knob are drawn and do nothing.
\ There is no flaps' lever and no undercarriage's indicator: the slats
\ work the flaps and the wheels are fixed. The cylinder temperature's red
\ mark is at the engine model's limit, an estimate. The photographs'
\ carburettor temperature is left out, the engine model having none.

\ the angle of a cylinder temperature on the photographed dial's scale, 0°C at nine o'clock round over the top to 300°C at three
: cylinder-angle ( celsius -- angle ) 0 300 clamp 300 / 0.5 - PI * ;

\ the cylinder heads' temperature, 0 to 300°C over the top of the dial, numbered 100, 200 and 300 as the photographed dial is, CYL TEMP on its face below them, a red mark at the type's limit
: draw-cylinder-temperature ( cx cy -- )
	| cx cy |
	cx cy medium-radius dial-face
	0 7 1 do k cx cy medium-radius k 50 * cylinder-angle tick loop
	[ 100 200 300 ] ( celsius | cx cy medium-radius celsius cylinder-angle 0.7 celsius "{0:.0f}" format face-text ) each
	plane@type@temperature-limit cylinder-angle to angle
	cx angle sin medium-radius 0.7 * * + cy angle cos medium-radius 0.7 * * -
	cx angle sin medium-radius * + cy angle cos medium-radius * -
	warning-colour draw-segment
	cx cy 8 + "CYL TEMP" dial-ink centred-text
	cx cy medium-radius plane@coolant-temperature cylinder-angle 0.85 needle-colour hand ;

\ the revolution counter as the photographed one: 1,200 to 3,400 a minute on a sweep, numbered in hundreds every 400
: draw-lysander-revolutions ( cx cy -- )
	| cx cy |
	plane@revolutions plane@type@rated-revolutions * to rpm
	cx cy medium-radius rpm 1200 3400 11 [ [ 1200 "12" ] [ 1600 "16" ] [ 2000 "20" ] [ 2400 "24" ] [ 2800 "28" ] [ 3200 "32" ] ] "R.P.M." sweep-dial ;

\ a small dial along the panel's foot, its name on its face and its hand on a sweep, nothing under it
: draw-foot-dial ( cx cy value low high name -- )
	| cx cy value low high name |
	cx cy small-radius dial-face
	cx cy small-radius 4 sweep-ticks
	cx cy 4 + name dial-ink centred-text
	cx cy small-radius value low high sweep 0.85 needle-colour hand ;

\ a bank of four small switches on a plate of their own
: draw-switch-bank ( x top -- )
	| x top |
	x top 64 18 0x050505 fill-span
	x top 64 18 dial-ink 0.6 dimmed outline
	0 4 1 do k
		x 10 + k 15 * + to lever-x
		lever-x top 11 + 2 0x707070 fill-disc
		lever-x 1 - top 3 + 3 7 0xd8d8d0 fill-span
	loop ;

\ a push button with a rim, in a colour, its name under it
: draw-push-button ( cx cy colour name -- )
	| cx cy colour name |
	cx cy 6 dial-ink 0.6 dimmed draw-circle
	cx cy 5 colour fill-disc
	cx cy 9 + name dial-ink centred-text ;

\ the Lysander's cockpit below the windscreen
: draw-lysander-panel ( -- )
	0 panel-top view-width screen-height panel-top - wall-colour fill-span
	0 panel-top view-width 4 edge-colour fill-span
	30 610 board-colour draw-board
	194 446 blind-panel-colour draw-board
	236 hurricane-upper-row draw-airspeed
	320 hurricane-upper-row draw-horizon
	404 hurricane-upper-row draw-climb
	236 hurricane-lower-row draw-altimeter
	320 hurricane-lower-row draw-gyro
	404 hurricane-lower-row draw-turn-and-slip
	52 panel-top 62 + draw-magnetos
	52 panel-top 66 + "MAGS" dial-ink centred-text
	108 panel-top 56 + draw-clock
	160 panel-top 56 + draw-brakes
	[ 46 70 94 118 142 166 ] ( x | x panel-top 122 + draw-toggle ) each
	[ 40 116 ] ( x | [ 136 160 ] ( down | x panel-top down + draw-switch-bank ) each ) each
	466 panel-top 36 + 18 40 plane@fuel plane@fuel-capacity / boost-rim-colour "FUEL" draw-strip-gauge
	494 panel-top 44 + 0x303030 "PRIME" draw-push-button
	526 panel-top 44 + plane@cranking if 0xff5040 else 0x902018 then "START" draw-push-button
	[ 494 526 ] ( x | x panel-top 86 + draw-toggle ) each
	510 panel-top 76 + 3 0x205020 fill-disc
	570 panel-top 62 + draw-cylinder-temperature
	488 panel-top 118 + draw-boost
	568 panel-top 120 + draw-lysander-revolutions
	466 panel-top 172 + plane@oil-pressure 0 200 "PSI" draw-foot-dial
	504 panel-top 172 + plane@oil-temperature 0 140 "OIL" draw-foot-dial
	542 panel-top 172 + plane@position second air-temperature -40 40 "AIR" draw-foot-dial
	172 floor-top 14 + warning-colour "FIRE" draw-push-button
	204 floor-top 14 + 0xe0e0d8 "COOL" draw-push-button
	draw-throttle-lever
	92 floor-top 20 + plane@trim "DN" "UP" "TAIL" draw-wall-wheel
	282 floor-top 12 + draw-compass
	draw-pedals
	draw-hurricane-column ;

\ === the Gladiator's cockpit ===

\ The Gladiator's cockpit, laid out after a photograph of the Shuttleworth
\ Gladiator's panel, with the controls the Historic Aircraft Association's
\ account of flying it and the CAA's airworthiness notes for G-GLAD
\ describe. One grey plate from the panel's top to the floor, its top edge
\ sloping down from the blind panel to the sides with the view showing
\ above the slope, every name on its face (the front view is drawn 44 rows
\ deeper for it, gladiator-view-rows, so the scene runs on behind the
\ slope). The black blind-flying panel in the middle with the six
\ dials in two rows, the column's ring grip over the directional gyro as
\ in the other cockpits. The left board: the oxygen regulator's nameplate
\ and the DELIVERY and SUPPLY labels over its two dials; under them the
\ cylinder temperature's small gauge, lettered ENG as the photograph's
\ (its other lettering unreadable), a riveted plate over the PRESSURE HEAD HEAT
\ label, drawn with a toggle switch on it that the photograph's fittings
\ on that plate do not show, the switch an inference from the label, and
\ the magneto switches' plate at the lower left. The
\ right board: the revolution counter and the boost gauge in its red rim
\ below it (the photograph's OPERATING LIMITS plate between them left
\ out); at its right edge
\ the oil pressure's upright strip gauge in its yellow housing and the
\ oil cooler's cock, a white disc with a red arrow, which every
\ photograph of the type's cockpit shows there (the Swedish J 8's reads
\ KRAN OLJEKYLARE). Under the blind
\ panel a row of three: the fuel contents in a red rim, the pneumatic
\ brakes' triple gauge, the supply needle and one for each wheel, the
\ bicycle lever on the spade grip sending the air to the wheel on the
\ rudder's side, and the oil temperature in an orange rim; the red
\ STARTER button beside them, the Mk II's electric starter. Below them
\ the compass bowl under the column's shaft at the centre; at the left
\ the tailplane trim's indicator dial, the Gladiator's pitch trim being
\ its tailplane's incidence (no rudder bias, none being recorded), and
\ the star-shaped hand wheel that sets it; at the plate's lower left the
\ throttle in its quadrant box, no pitch lever for the fixed-pitch
\ propeller. No flaps' indicator, the photograph having none; no
\ carburettor temperature gauge, as the account has none; the cylinder
\ temperature on the left board's ENG gauge. The account puts the feet on
\ trays below the view, so the Spitfire's frame pedals show only their
\ tops over the foot of the lower slab. The heater's switch and the cooler's
\ cock are drawn and do nothing. The placings follow the photograph,
\ scaled to the view.

\ the Gladiator's plate top, the blind panel's two dial rows, the row of gauges under it, the row along its foot, and its grey
panel-top 4 + constant gladiator-panel-top
\ the rows the Gladiator's front view is drawn in: the plate's top slopes 40 px down from the blind panel to the sides, so the scene runs on behind the slope to the foot of the plate's upper corners
panel-top 44 + constant gladiator-view-rows
panel-top 48 + constant gladiator-upper-row
panel-top 128 + constant gladiator-lower-row
panel-top 194 + constant gladiator-gauge-row
panel-top 202 + constant gladiator-band-row
0x4c4e46 constant gladiator-board-colour

\ the fuel contents gauge in a red rim, FUEL on its face, 0 to the tank's capacity in gallons
: draw-gladiator-fuel ( cx cy -- )
	| cx cy |
	cx cy small-radius plane@fuel 0 plane@fuel-capacity 4 [ [ 0 "0" ] [ plane@fuel-capacity plane@fuel-capacity "{0:.0f}" format ] ] "" sweep-dial
	cx cy 8 - "FUEL" dial-ink centred-text
	cx cy small-radius boost-rim-colour draw-circle
	cx cy small-radius 1 + boost-rim-colour draw-circle ;

\ the boost gauge in its red rim, 32 px in radius, smaller than the revolution counter as the screenshot shows it, BOOST on its face below the centre
: draw-gladiator-boost ( cx cy -- ) draw-boost-inside ;

\ a small gauge as the photographed engine gauge: a round bezel whose face is its upper part, the scale an arc of marks across the top with the lowest and highest readings at its ends, the name in the middle, the needle rising from a pivot at the bottom of the bezel over a bar that closes the face
: draw-arc-gauge ( cx cy value low high name -- )
	| cx cy value low high name |
	cx cy 20 dial-face
	cy 12 + to pivot-y
	0 7 1 do k
		k 6 / 1.7 * 0.85 - to angle
		cx angle sin 20 * + pivot-y angle cos 20 * - cx angle sin 24 * + pivot-y angle cos 24 * - dial-ink draw-segment
	loop
	cx 11 - cy 3 - low "{0:.0f}" format 5 dial-ink centred-lettering
	cx 10 + cy 3 - high "{0:.0f}" format 5 dial-ink centred-lettering
	cx cy 3 + name dial-ink centred-text
	cx 16 - cy 10 + cx 16 + cy 10 + dial-ink 0.6 dimmed draw-segment
	cx pivot-y 24 value low high clamp low - high low - / 1.7 * 0.85 - 0.9 needle-colour hand ;

\ the oil cooler's cock, a white disc with a red arrow, as the photographs show it, at open
: draw-cooler-cock ( cx cy -- )
	| cx cy |
	cx cy 20 0xe8e8e0 fill-disc
	cx cy 20 edge-colour draw-circle
	cx 11 + cy 11 + cx 11 - cy 11 - warning-colour draw-segment
	cx 11 - cy 2 - cx 11 - cy 11 - warning-colour draw-segment
	cx 2 - cy 11 - cx 11 - cy 11 - warning-colour draw-segment ;

\ the tailplane trim's indicator as the photographed one: its needle pivoted near the top of the face, hanging down over an arc of marks along the bottom, DN at the arc's left end and UP at its right, TRIM between the pivot and the arc
: draw-trim-dial ( cx cy -- )
	| cx cy |
	cx cy 25 dial-face
	cy 13 - to pivot-y
	0 7 1 do k
		PI k 6 / 1.2 * 0.6 - - to angle
		cx angle sin 26 * + pivot-y angle cos 26 * - cx angle sin 30 * + pivot-y angle cos 30 * - dial-ink draw-segment
	loop
	cx 13 - cy 1 + "DN" dial-ink centred-text
	cx 13 + cy 1 + "UP" dial-ink centred-text
	cx cy 8 - "TRIM" dial-ink centred-text
	cx pivot-y 30 PI plane@trim -1 1 clamp 0.6 * - 0.85 needle-colour hand ;

\ the oxygen regulator as the Gladiator's plate carries it: OXYGEN REGULATOR engraved across the top, DELIVERY and SUPPLY under it, the two dials close together below them with a bracket between, the delivery's set for the height above 10,000 ft and the supply's full with the lower left of its face red, as the Hurricane's
: draw-gladiator-oxygen ( cx cy -- )
	| cx cy |
	cx cy 48 - "OXYGEN REGULATOR" dial-ink centred-text
	cx 27 - cy 36 - "DELIVERY" dial-ink centred-text
	cx 27 + cy 36 - "SUPPLY" dial-ink centred-text
	cx cy 22 - cx cy 22 + edge-colour draw-segment
	plane@position second 3.28084 * 1000 / to thousands
	thousands 10 < if 0 else thousands then to delivery
	cx 27 - cy medium-radius delivery 0 40 8 [ [ 0 "0" ] [ 20 "20" ] [ 40 "40" ] ] "" sweep-dial
	cx 27 + to supply-x
	supply-x cy medium-radius dial-face
	0 17 1 do k
		k 0.1 * 1.9 - to angle
		supply-x angle sin medium-radius 0.35 * * + cy angle cos medium-radius 0.35 * * -
		supply-x angle sin medium-radius 0.9 * * + cy angle cos medium-radius 0.9 * * -
		warning-colour 0.7 dimmed draw-segment
	loop
	supply-x cy medium-radius 4 sweep-ticks
	supply-x cy medium-radius 1 0 1 sweep 0.85 needle-colour hand ;

\ the revolution counter as the Lysander's, 1,200 to 3,400 a minute numbered in hundreds, at the large size with R.P.M. on its face below the centre
: draw-gladiator-revolutions ( cx cy -- )
	| cx cy |
	plane@revolutions plane@type@rated-revolutions * to rpm
	cx cy large-radius rpm 1200 3400 11 [ [ 1200 "12" ] [ 1600 "16" ] [ 2000 "20" ] [ 2400 "24" ] [ 2800 "28" ] [ 3200 "32" ] ] "" sweep-dial
	cx cy 22 + "R.P.M." dial-ink centred-text ;

\ the trim's hand wheel, a six-pointed star, its points 26 px out, each pair of points joined by one concave arc that passes 18 px from the centre midway between them: the circle through the two points and that midpoint has its centre 38.96 px out along the bisector and a radius of 20.96 px, and the arc runs round its inner side; filled in gunmetal and turned with its setting
0x6e7074 constant gunmetal-colour
: draw-star-wheel ( cx cy setting -- )
	| cx cy setting |
	6 iota ( k |
		setting 15 * k PI * 3 / + PI 6 / + to bisector
		9 iota ( t |
			3.810 t 0.1671 * - to arc-angle
			38.96 arc-angle cos 20.96 * + to out
			arc-angle sin 20.96 * to across
			[ cx bisector sin out * + bisector cos across * + cy bisector cos out * - bisector sin across * + ]
		) map
	) map [ ] ' concat reduce to outline
	outline size to n-points
	0 n-points 1 do k
		outline k @i spread to y0 to x0
		outline k 1+ n-points mod @i spread to y1 to x1
		x0 y0 x1 y1 cx cy gunmetal-colour blind-panel-colour translucent fill-face
		x0 y0 x1 y1 grip-edge-colour blind-panel-colour translucent draw-segment
	loop ;

\ the throttle quadrant on the left wall under the magneto plate, seen side-on from the seat as a photograph of a Gladiator's shows it: a light metal housing with two slots up it and two levers with black ball knobs, their rods rising from below the screen's edge, the throttle's knob travelling up its slot as the throttle opens and the mixture's up the other as it goes richer (the photograph's second lever, taken for the mixture's); no pitch lever, the propeller fixed-pitch, and no cut-out, the Mercury's rated boost its most
0xb4b4ac constant quadrant-colour
: draw-gladiator-throttle ( -- )
	6 panel-top 178 + 36 50 quadrant-colour fill-span
	6 panel-top 178 + 36 50 grip-edge-colour outline
	[ [ 16 plane@throttle ] [ 30 plane@mixture ] ] ( lever |
		lever spread to setting to x
		x panel-top 184 + x panel-top 222 + grip-colour draw-segment
		panel-top 220 + setting 34 * - to knob-y
		-1 2 1 do k x k + screen-height x k + knob-y grip-colour draw-segment loop
		x knob-y 5 0x101010 fill-disc
		x knob-y 5 grip-edge-colour draw-circle
		x 2 - knob-y 2 - 1 0xd8d8d0 fill-disc
	) each ;

