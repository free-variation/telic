		x 16 - top 32 26 pedal-colour outline
		x 12 - top 8 + x 12 + top 8 + pedal-colour draw-segment
		x 12 - top 16 + x 12 + top 16 + pedal-colour draw-segment
	loop
	240 floor-top 32 + 400 floor-top 32 + pedal-colour draw-segment ;

