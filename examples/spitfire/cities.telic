	  :george-street [ 18 [ -1 1 ] ] :south-bridge [ 22 [ -1 1 ] ] :leith-walk [ 16 [ -1 1 ] ]
	  :lothian-road [ 18 [ -1 1 ] ] } to styles
	streets styles edinburgh-squares edinburgh-stations { :edinburgh-waverley 12 :haymarket 10 } edinburgh-railways keep-city ;

