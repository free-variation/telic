	             "AND THE DESCENT UNTIL THE RUNWAY SHOWS." ]
	    :start [ :abbotsinch landmark-ground 50 0 150 -3600 placed 50 55 false ]
	    :raid null :target :abbotsinch :landing-on "ABBOTSINCH"
	    :night false :landing true :visibility 1600 :cover 0 :base 1500 :wind [ 50 1 ]
	    :propeller :constant-speed :emergency true
	    :message "FOG AT ABBOTSINCH  -  HOLD 050 AND 120 MPH, THE RUNWAY IS AHEAD"
	    :group :training
	    :briefing "LAND IN FOG WITH A MILE'S VISIBILITY. YOU ARE TRIMMED, THE RUDDER TRIM A LITTLE RIGHT AGAINST THE ENGINE'S SWING; AS THE POWER CHANGES, WIND IT WITH . AND , TO KEEP THE SLIP NEEDLE CENTRED. THE RUNWAY IS AHEAD ON 050 BUT OUT OF SIGHT: HOLD THE HEADING ON THE GYRO, 120 MPH, AND A STEADY DESCENT ON THE CLIMB INDICATOR UNTIL THE RUNWAY SHOWS, THEN LAND AS IN CLEAR AIR." } ] ;

\ each mission's squadron code and its fighters' own letters, the player's first and then each wingman's: 603's XT at Turnhouse from September 1939, 43's FT at Wick, 46's PO in Norway, 72's RN, 602's LO in the Clyde's defence in 1941 (en.wikipedia.org's squadron pages, aviation-safety.net's L1023 coded XT-N in October 1939); the training missions in the code of their base's squadron, Turnhouse's 603 and Abbotsinch's 602; the PR Spitfire uncoded; every letter a choice, none recorded
[ [ "THE FORTH, 16 OCTOBER 1939" "XT" [ "D" ] ]
  [ "SCAPA FLOW, 16 MARCH 1940" "FT" [ "K" ] ]
  [ "NARVIK, 28 MAY 1940" "PO" [ "E" ] ]
  [ "HMS GLORIOUS, 7 JUNE 1940" "PO" [ "F" ] ]
  [ "FARNE ISLANDS, 15 AUGUST 1940" "RN" [ "E" "B" "D" "G" "H" "K" ] ]
  [ "CLYDEBANK, 13 MARCH 1941" "LO" [ "F" ] ]
  [ "GREENOCK, 6 MAY 1941" "LO" [ "H" ] ]
  [ "TIRPITZ AT TRONDHEIM, 5 MARCH 1942" "" [ "" ] ]
  [ "FLYING LESSON AT TURNHOUSE" "XT" [ "A" ] ]
  [ "AIR FIRING OVER THE FORTH" "XT" [ "C" ] ]
  [ "FREE FLIGHT FROM TURNHOUSE" "XT" [ "B" ] ]
  [ "LANDING AT ABBOTSINCH" "LO" [ "L" ] ]
  [ "FOG AT ABBOTSINCH" "LO" [ "M" ] ] ] constant mission-markings

\ a mission's code and its fighters' letters, the player's first, from its row by its name; no code and a blank letter for a mission the table lacks
: mission-code ( mission -- code letters )
	| mission |
	mission-markings ( row | row first mission@name = ) filter to rows
	rows size 0 = if "" [ "" ] exit then
	rows first second rows first 2 @i ;

\ the letter of a mission's fighter, the player's at 0 and each wingman's after; blank past the list's end
: mission-letter ( mission index -- letter )
	| mission index |
	mission mission-code to letters drop
	index letters size < if letters index @i else "" then ;

\ the model of a mission's wingman, by its index from 1, built in its squadron's markings and kept among the models under its own key
: wingman-model ( mission index -- key )
	| mission index ^models |
	mission mission-code drop to code
	index "wingman-{0}" format string>symbol to key
	models :spitfire code mission index mission-letter false marked-model key ! to models
	key ;

\ the mission's wingmen, each drawn by its own model in the squadron's markings, and the mission's raid, or none
: start-raid ( mission -- )
	| mission ^bombers ^sight-span ^wingmen |
	[ ] to wingmen
	mission :wingmen [ ] @or to placements
	0 placements size 1 do k
		placements k @i spread to turned to along to up to across
		mission@start first mission@start second across up along placed to position
		mission@start second turned + 360 + 360 mod to heading
		mission k 1+ wingman-model to model-key
		wingmen
		{ :kind :spitfire :model model-key :role :spitfire :position position :heading heading :pitch 0 :bank 0 :speed mission@start 2 @i
		  :attitude heading 0 0 flying-attitude :height position second :target [ 0 0 0 ] :state :flying :hits 0
		  :smoke [ ] :smoke-left 0 }
		add-last! drop
	loop
	mission@raid to plan
	plan null? if [ ] to bombers exit then
	plan@kind :ju-88 = if 20.08 else 22.6 then to sight-span
	mission :sight-span sight-span @or to sight-span
	plan@kind plan@n-vics plan@start plan@target plan@height plan@speed new-raid
	mission :escort [ ] @or to escort
	mission@start first to origin
	mission@start second to start-heading
	escort ( placement |
		placement spread to turned to along to up to across
		origin start-heading across up along placed to position
		start-heading turned + 360 + 360 mod to heading
		bombers
		{ :kind :bf-110 :role :fighter :position position :heading heading :pitch 0 :bank 0 :speed fighter-cruise-speed
		  :attitude heading 0 0 flying-attitude
		  :height position second :target plan@target :state :inbound :hits 0
		  :smoke [ ] :smoke-left 0 }
		add-last! drop
	) each ;

\ the raid's end: every bomber down or gone home past 50 km
: check-raid-over ( -- )
	:raid-over game@ if exit then
	bombers ( bomber |
		bomber@state :falling = bomber@state :down = or
		bomber@state :outbound = bomber@position bomber@target v- v-length 50000 > and or
	) all? if
		true :raid-over game!
		:kills game@ "THE RAID IS OVER: {0} DESTROYED  -  LAND, OR ESCAPE FOR THE MISSIONS" format say
		12 :message-left game!
	then ;

\ the controller's vector to the raid, the rounds left, the bombers destroyed and the damage taken
: draw-raid-panel ( -- )
	436 to x
	plane@position raid-vector to distance to bearing
	bearing null? if "RAID -" else distance 1609.34 / bearing "RAID {0:03.0f} {1:.0f} MI" format then to vector-line
	x floor-top 4 + vector-line 0xffe080 draw-text
	:kills game@ plane@ammunition plane@type@fire-seconds / plane@type@rounds-per-gun * round "ROUNDS {0:.0f} KILLS {1}" format to score-line
	x floor-top 17 + score-line dial-ink draw-text
	plane@damage 0 > if x floor-top 30 + plane@damage round "DAMAGE {0}%" format 0xff6040 draw-text then ;

\ the place to land, its bearing and distance, and the height above it: on a carrier the deck's, with the speed closing on her along her heading; else the field's
: draw-landing-panel ( -- )
	436 to x
	deck null? if :target game@ else deck@centre [ 0 deck@height 0 ] v+ then to place
	place plane@position v- spread to dz to dy to dx
	[ dx 0 dz ] v-length 1609.34 / [ dx 0 dz ] heading-of :landing-on game@ "{0} {1:03.0f} {2:.1f} MI" format to place-line
	x floor-top 4 + place-line 0xffe080 draw-text
	dy negate 3.28084 * round deck null? if "FIELD {0} FT BELOW" else "DECK {0} FT BELOW" then format to height-line
	x floor-top 17 + height-line dial-ink draw-text
	deck null? not if
		plane@velocity deck-velocity v- deck@heading heading-attitude :forward @ v-dot 2.23694 * round "CLOSING {0} MPH" format to closing-line
		x floor-top 30 + closing-line dial-ink draw-text
	then ;
