	    :start [ turnhouse-runway 60 0 true ]
	    :raid null
	    :night false :landing false :visibility clear-visibility :cover 0.2 :base 1500 :wind [ 60 5 ]
	    :propeller :two-pitch :emergency false :lesson true :target :turnhouse
	    :message ""
	    :group :training
	    :briefing "THE INSTRUCTOR'S EACH STEP SHOWS AT THE TOP OF THE SCREEN, AND THE NEXT COMES WHEN YOU HAVE DONE IT: THE TAKE-OFF, THE CLIMB, CRUISE POWER, TRIM, TURNS, THE STALL AND ITS RECOVERY, THE RETURN AND THE LANDING. THE TURNHOUSE LINE BELOW THE PANEL GIVES THE FIELD'S BEARING AND DISTANCE FOR THE RETURN." }
	  { :name "AIR FIRING OVER THE FORTH"
	    :story [ "AN OPERATIONAL TRAINING UNIT'S AIR FIRING: A LYSANDER"
