	[ [ -4.87 0.85 ] [ -5.02 1.22 ] [ -5.53 1.9 ] [ -5.76 2.17 ] [ -5.92 2.41 ] [ -6.13 2.66 ] [ -6.33 2.75 ] [ -6.61 2.66 ] [ -6.86 2.41 ] [ -7.02 2.09 ]
	  [ -7.14 1.68 ] [ -7.24 1.23 ] [ -7.26 0.86 ] [ -7.22 0.62 ] [ -7.1 0.38 ] [ -6.89 0.21 ] [ -6.65 0.15 ] [ -6.44 0.25 ] [ -5.0 0.8 ] ] to fin
