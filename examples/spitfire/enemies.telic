	    :start [ tirpitz-berth 47 0 9144 -6000 placed 47 140 false ]
	    :raid null
	    :night false :landing false :visibility clear-visibility :cover 0.3 :base 1200 :wind [ 260 10 ]
	    :propeller :constant-speed :emergency true
	    :aircraft :reconnaissance :target :faettenfjord
	    :message "30,000 FT OVER THE TRONDHEIMSFJORD  -  THE TIRPITZ IS 4 MILES AHEAD, C RUNS THE CAMERAS"
