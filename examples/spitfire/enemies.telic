	    :start [ turnhouse-runway 60 0 true ]
	    :raid null
	    :night false :landing false :visibility clear-visibility :cover 0.35 :base 1200 :wind [ 70 7 ]
	    :propeller :constant-speed :emergency true
	    :message "FREE FLIGHT  -  Q FOR THROTTLE, PULL BACK AT 100 MPH"
	    :group :free
	    :briefing "NO RAID AND NO TARGET. THE MAP RUNS FROM THE CLYDE TO THE FORTH, SOUTH-EAST TO THE FARNE ISLANDS AND TYNESIDE, NORTH UP THE GREAT GLEN TO INVERNESS, UP THE EAST COAST BY MONTROSE, ABERDEEN AND PETERHEAD, AND ON OVER WICK TO ORKNEY, SCAPA FLOW AND SHETLAND. T RUNS TIME FASTER." }
	  { :name "LANDING AT ABBOTSINCH"
	    :story [ "LANDING PRACTICE: ON THE APPROACH TO"
