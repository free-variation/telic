	    :raid :he-111 4 heinkels :tynemouth landmark-ground 4600 100 raid-plan
	    :escort [ [ 60 40 700 70 ] [ -470 140 -800 0 ] [ 350 -80 700 190 ] [ -500 180 350 -100 ] [ 550 150 -250 120 ] [ 150 -250 950 30 ] ]
	    :wingmen [ [ -60 10 -90 0 ] [ 70 -10 -100 0 ] [ -450 120 -350 0 ] [ 350 160 -450 0 ] [ 40 -220 -700 0 ] ]
	    :sight-span 16.25
