\ === the Closet ===

\ a walk-in closet of shelves: cleaning things, stacks of linen, a bucket and mop, under a bare bulb
: closet-11-picture ( -- )
	0 1.6 2.45 PI -0.25 215 new-picture
	[ 0 2.05 1.2 ] lamp!
	[ [ [ -0.4 0 0.85 ] 0.1 ] [ [ 0.35 0 1.15 ] -0.15 ] ] spots!
	[ -1.2 0 0 ] [ 1.2 0 0 ] [ 1.2 0 2.5 ] [ -1.2 0 2.5 ] 7 floorboards
	0.4 pen!
	-1.2 1.2 0 2.5 2.5 room-shell
	0.3 pen!
	-0.9 0 0.02 -0.9 2.3 0.02 edge
	0.9 0 0.02 0.9 2.3 0.02 edge
	[ 0.3 0.8 1.4 1.95 ] ( board |
		0.5 pen!
		-0.9 board 0 0.9 board 0 edge
		-0.9 board 0.4 0.9 board 0.4 edge
		-0.9 board 0 -0.9 board 0.4 edge
		0.9 board 0 0.9 board 0.4 edge
	) each
	[ 0.8 ] ( board |
		0 5 1 do k
			k 0.42 * -1.0 + to left
			board 131 * k 17 * + hash-fraction 0.1 * 0.12 + to box-height
			0.45 pen!
			left board 0.1 left 0.3 + board box-height + 0.32 solid-box
			0.25 pen!
			left 0.05 + board box-height 0.5 * + 0.32 left 0.25 + board box-height 0.5 * + 0.32 edge
		loop
	) each
	0.55 pen!
	[ -0.85 -0.5 -0.15 0.2 0.55 ] ( left |
		left 0.3 0.1 left 0.3 + 0.3 0.12 + 0.35 solid-box
		0.3 pen!
		left 0.3 0.06 + 0.1 left 0.3 + 0.3 0.06 + 0.1 edge
		0.55 pen!
	) each
	0.6 pen!
	[ -0.82 -0.52 -0.22 0.08 0.38 0.68 ] ( left |
		left 977 * hash-fraction 0.08 * 0.2 + to bottle-height
		left 0.06 + 1.4 0.2 0.04 detail-scale * 8 ring to base-ring
		left 0.06 + 1.4 bottle-height + 0.2 0.04 detail-scale * 8 ring to shoulder
		base-ring 0 fill
		0.65 pen!
		0 8 2 do k base-ring k @i shoulder k @i segment loop
		shoulder outline
		left 0.06 + 1.4 bottle-height + 0.2 left 0.06 + 1.4 bottle-height + 0.07 + 0.2 edge
	) each
	0.75 pen!
	[ -0.8 -0.2 0.4 ] ( left |
		0 4 1 do k
			left 1.95 k 0.05 * + 0.1 left 0.45 + 1.95 k 0.05 * + 0.045 + 0.34 solid-box
		loop
	) each
	0.6 pen!
	-0.8 0 0.75 0.14 10 ring to bucket-bottom
	-0.8 0.3 0.75 0.17 10 ring to bucket-top
	bucket-bottom 0 fill
	0 10 1 do k bucket-bottom k @i bucket-top k @i segment loop
	bucket-top outline
	0.45 pen!
	[ [ -0.8 0.3 0.6 ] [ -0.83 0.42 0.75 ] [ -0.8 0.3 0.9 ] ] path
	0.4 pen!
	-0.8 0.25 0.75 -1.1 1.6 0.2 edge
	0.35 pen!
