	0.85 pen!
	mirror outline
	0.2 pen!
	[ -2.48 1.1 1.25 ] [ -2.48 1.6 1.55 ] segment
	0.7 pen!
	-2.15 0.72 1.15 0.025 detail-scale * 8 ring outline
	-2.15 0.72 1.15 -2.15 0.8 1.15 edge
