\ === Ms. Dunbar's Bathroom ===

\ a medicine bottle standing on a shelf: its body, shoulder and cap
: shelf-bottle ( x y z height -- )
	| x y z height |
	x y z 0.02 detail-scale * 8 ring to bottom-ring
	x y height + z 0.02 detail-scale * 8 ring to top-ring
	bottom-ring 0 fill
	0.75 pen!
	0 8 2 do k bottom-ring k @i top-ring k @i segment loop
	top-ring outline
	0.9 pen!
	x y height + z x 0.012 detail-scale * + y height + 0.02 + z edge ;

\ a toilet with its tank against a south wall, its bowl reaching north: tank, the bowl's sides, the seat and lid ring
: toilet-against-south-wall ( x wall-z -- )
	| x wall-z |
	0.55 pen!
	x 0.27 - 0 wall-z 0.1 - x 0.27 + 0.8 wall-z 0.1 + solid-box
	x 0.4 wall-z 0.42 + 0.2 12 ring to seat
	x 0 wall-z 0.35 + 0.12 12 ring to toilet-base
	0 12 1 do k
		k 1 + 12 mod to next
		[ toilet-base k @i toilet-base next @i seat next @i seat k @i ] 0 fill
	loop
	seat 0 fill
	0.35 pen!
	0 12 2 do k toilet-base k @i seat k @i segment loop
	0.7 pen!
	seat outline
	0.85 pen!
	x 0.42 wall-z 0.42 + 0.16 12 ring outline ;

