			[ -1.1 0.8 0 ] sunlight floor-hit to lower-left
			[ 1.1 0.8 0 ] sunlight floor-hit to lower-right
			[ -1.1 2.3 0 ] sunlight floor-hit to upper-left
			[ 1.1 2.3 0 ] sunlight floor-hit to upper-right
			lower-left upper-left k 2 * 1 + 9 / between [ 0 0.2 0 ] ' + 2 nmap to band-left
			lower-right upper-right k 2 * 1 + 9 / between [ 0 0.2 0 ] ' + 2 nmap to band-right
