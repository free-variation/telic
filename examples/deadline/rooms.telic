\ ---- Master Bathroom ----

{ :name "Master Bathroom"
  :description "This is Mr. and Mrs. Robner's private bathroom, accessible
                only from the bedroom through a door to the west. On one wall
                is a mirror over a long counter containing two sinks, and in
                addition to the usual bathroom fixtures is a jacuzzi. Hanging
                plants give the room an almost tropical atmosphere."
  :synonyms [ "bath" "bathroom" ]
  :adjectives [ "master" ]
  :flags [< :room :lit >]
  :globals [ :shower :toilet :sink ]
  :pseudo [ [ "toothpaste" :random-pseudo ] ]
  :exits { :west :master-bedroom
