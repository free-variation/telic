\ ---- North Lawn ----

{ :name "North Lawn"
  :description "This idyllic spot lies on a jut of land well north of the
                house and is surrounded on three sides by lake shore.  Its
                charm includes the sweet smell of roses blown on a southwest
                breeze from the rose garden and by the sound of the leaves
                rustling in the orchard to the southeast."
  :synonyms [ "lawn" ]
  :adjectives [ "north" ]
  :flags [< :room :lit >]
  :globals [ :lawn :house :lake ]
  :line 2
  :station :north-lawn
  :corridor 128
  :exits { :northeast "You can't go into the lake."
           :northwest "You can't go into the lake."
           :north     "You can't go into the lake."
           :east      "You can't go into the lake."
           :west      "You can't go into the lake."
           :southwest :rose-garden
           :southeast :orchard
           :south     :rose-garden
         }
} :north-lawn :rooms place

\ ---- In the Orchard ----

{ :name "In the Orchard"
