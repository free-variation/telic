\ Deadline: the rooms, each a frame placed in the world under its name. The
\ keys are those the world model reads (world.telic); an exit is a room name,
\ a refusal string, or a frame naming the room with the door or state flag
\ that must be open or set, and the refusal otherwise.

\ ---- South Lawn ----

{ :name "South Lawn"
  :description "You are on a wide lawn just north of the entrance to the
                Robner estate. Directly north at the end of a pebbled path is
                the Robner house, flanked to the northeast and northwest by a
                vast expanse of well-kept lawn. Beyond the house can be seen
                the lakefront."
  :synonyms [ "lawn" ]
  :adjectives [ "south" ]
  :flags [< :room :lit >]
  :globals [ :lawn :house ]
  :line 2
  :station :front-path
  :corridor 64
  :exits { :north     :front-path
           :south     "Leaving the estate would mean quitting the case and,
                       most probably, your job."
           :northwest :west-lawn
           :northeast :east-lawn
         }
} :south-lawn :rooms place

