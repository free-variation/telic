} :in-orchard :rooms place

\ ---- Orchard Path ----

{ :name "Orchard Path"
  :description "You are on a path at the edge of a small orchard of fruit
                trees which abuts the eastern side of the back of the house.
                The orchard is obviously intended more to display the beauty of
                the blossoms in spring than to produce significant amounts of
                fruit. The windows of the kitchen look out onto the orchard,
                although your view of them is blocked by the trees and a small
                grape arbor.  To the west is a path along a rose garden, and
                lawns sweep out to the north and east."
  :synonyms [ "path" ]
  :adjectives [ "orchard" ]
  :flags [< :room :lit >]
  :globals [ :kitchen-window :house :fruit-trees ]
  :line 2
  :station :orchard
  :corridor 2176
  :exits { :east      :east-lawn
           :southeast :east-lawn
           :north     :north-lawn
           :northwest :north-lawn
           :northeast :north-lawn
           :west      :rose-garden
           :south     :in-orchard
           :southwest :in-orchard
         }
} :orchard :rooms place

