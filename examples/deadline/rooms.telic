           :southeast :west-of-door
           :south     :west-of-door
           :east      "You can't enter the house here."
         }
} :west-side :rooms place

\ ---- East Side of House ----

{ :name "East Side of House"
  :description "There are no windows or entries of any kind here at the east
                side of the house. To the north is the orchard, and the front
                lawn lies to the south. A lawn also slopes down toward the
                shore of a lake to the east."
  :flags [< :room :lit >]
  :globals [ :house ]
  :line 2
  :station :east-side
  :corridor 64
  :exits { :north     :orchard
