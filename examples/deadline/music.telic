: queue-failed-ending ( -- )
	standard-mix!
	theme-effects!
	60 sequence-tempo
	failed-sax-part :sax 0.6 0.97 queue-part
	failed-piano-part :piano 0.45 1 queue-part
	failed-fill-part :piano-fill 0.4 0.95 queue-part
	failed-bass-part :bass 0.65 1 queue-part
	failed-brush-part :brush 1 queue-hits
	failed-kick-part :kick 0.5 queue-hits ;
