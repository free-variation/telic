	confrontation-piano-part :piano 0.6 1 queue-part
	confrontation-bass-part :bass 0.8 0.85 queue-part
	confrontation-brush-part :brush 1 queue-hits
	confrontation-snare-part :snare 0.5 queue-hits
	confrontation-hihat-part :hihat 0.5 queue-hits
	confrontation-kick-part :kick 0.5 queue-hits ;

\ === the resolved ending ===
\ six bars at 72 beats a minute, the theme taken up in D major: the saxophone
\ plays the motif in the major, A G F# E D, through the major key's own
\ progression, and lands on D over Dmaj9; the piano's last arpeggio ends on the ninth
\ bars 1-6  Dmaj9 | Gmaj9 | Em9 | A13 | Dmaj9 | Dmaj9

[ :a4 3/8 :g4 1/8 :f#4 1/4 :e4 1/4
  :d4 1/2 :rest 1/4 :a4 1/4
  :b4 3/8 :a4 1/8 :g4 1/4 :e4 1/4
  :f#4 1/2 :e4 1/4 :c#4 1/4
  :d4 1 :rest 1 ] to resolved-sax-part

[ [ :f#3 :a3 :c#4 :e4 ] 3/4 :rest 1/4
  [ :f#3 :a3 :b3 :d4 ] 3/4 :rest 1/4
  [ :g3 :b3 :d4 :f#4 ] 3/4 :rest 1/4
  [ :g3 :c#4 :f#4 ] 1
  [ :f#3 :a3 :c#4 :e4 ] 2 ] to resolved-piano-part

[ :rest 4
  :a5 1/6 :f#5 1/12 :e5 1/6 :c#5 1/12 :a4 1/2
  :e5 1 ] to resolved-fill-part

[ :d2 1/2 :a1 1/2  :g1 1/2 :d2 1/2  :e2 1/2 :b1 1/2  :a1 1/2 :e2 1/4 :c#2 1/4  :d2 2 ] to resolved-bass-part

[ 1/2 0.45 1/2 0.4 ] 4 bars-of [ 1 0.4 1 0.2 ] concat to resolved-brush-part
[ 1/4 0 1/4 0.4 1/4 0 1/4 0.4 ] 3 bars-of [ 1/4 0 1/4 0.4 1/4 0 1/12 0.25 1/12 0.3 1/12 0.35 ] concat [ 2 0 ] concat to resolved-snare-part
[ 1/4 0 1/4 0.35 1/4 0 1/4 0.35 ] 4 bars-of [ 2 0 ] concat to resolved-hihat-part
[ 1/4 0.25 3/4 0 ] 4 bars-of [ 1/4 0.3 7/4 0 ] concat to resolved-kick-part

\ queue the resolved ending from the present
: queue-resolved-ending ( -- )
	standard-mix!
	theme-effects!
	72 sequence-tempo
	resolved-sax-part :sax 0.66 0.97 queue-part
	resolved-piano-part :piano 0.5 1 queue-part
	resolved-fill-part :piano-fill 0.5 0.95 queue-part
	resolved-bass-part :bass 0.7 0.9 queue-part
	resolved-brush-part :brush 1 queue-hits
	resolved-snare-part :snare 0.5 queue-hits
	resolved-hihat-part :hihat 0.5 queue-hits
	resolved-kick-part :kick 0.5 queue-hits ;

\ === the failed ending ===
\ five slow bars at 60 beats a minute: the A7 the confrontation holds turns
\ aside to Bbmaj7#11 instead of D; the saxophone climbs the motif's first steps
\ turned upward, A Bb C D, reaches F, and crashes down through D Bb G to E,
\ falls silent, and holds E over a bare D minor, never reaching the D; one high
\ E rings out over the low chord
\ bars 1-5  Bbmaj7#11 | Gm9 | Ebmaj7#11 over D | Dm(add9) | Dm(add9)

[ :a4 1/4 :bb4 1/4 :c5 1/4 :d5 1/4
  :f5 1/2 :d5 1/12 :bb4 1/12 :g4 1/12 :e4 1/4
  :rest 1
  :e4 3/4 :rest 5/4 ] to failed-sax-part

[ [ :a3 :d4 :e4 ] 1
  [ :bb3 :d4 :f4 :a4 ] 1
  [ :g3 :a3 :d4 ] 1
  [ :d2 :a2 :f3 :e4 ] 2 ] to failed-piano-part

[ :rest 3 :rest 1/2 :e6 1/2 :rest 1 ] to failed-fill-part
[ :bb1 1 :g1 1 :d2 1 :d2 2 ] to failed-bass-part
[ 1 0.4 1 0.35 1 0.4 1 0.3 1 0.15 ] to failed-brush-part
[ 1/4 0.25 19/4 0 ] to failed-kick-part

