	[ -4.9 1.5 -3.99 ] [ 1 0 0 ] 0.7 0.9 portrait-frame
	[ -3.4 1.5 -3.99 ] [ 1 0 0 ] 0.7 0.9 portrait-frame
	[ 2.7 1.5 -3.99 ] [ 1 0 0 ] 0.7 0.9 portrait-frame
	[ 4.2 1.5 -3.99 ] [ 1 0 0 ] 0.7 0.9 portrait-frame
	[ -0.3 2.78 -4.99 ] [ 1 0 0 ] 0.6 0.55 portrait-frame
