	-6 1.35 log-pile
	0.5 pen!
	-4.6 -1.5 3.6 4 1.1 walnut-cabinet
	-0.6 1.5 3.6 4 1.1 walnut-cabinet
	0.55 pen!
	[ -3.4 0 0.3 ] PI -2 / 2.2 sofa-piece
