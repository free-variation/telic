	{ :dunbar { :sitting [ [ -1.52 0 -1.4 ] PI 2 / ] } :baxter { :sitting [ [ -0.5 0 -3.12 ] 0 ] }
	  :mrs-robner { :sitting [ [ -4.28 0 -1.52 ] 0.25 ] } } seats!
	0.09 pen!
	[ -6 0 -4 ] [ 6 0 -4 ] [ 6 0 4 ] [ -6 0 4 ] 24 16 grid
	[ [ -2 0 -4 ] [ -1.2 0 -5 ] [ 1.2 0 -5 ] [ 2 0 -4 ] ] 0.02 fill
	-1.1 -0.4 0.5 2.7 -5 south-pane-light
	-0.35 0.35 0.5 2.7 -5 south-pane-light
	0.4 1.1 0.5 2.7 -5 south-pane-light
	[ 0 1.6 -5 ] 2.4 0.2 glow
