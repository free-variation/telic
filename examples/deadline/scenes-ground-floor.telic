	-0.55 0.55 -3.6 2.6 runner-rug
	[ 0 0 3.2 ] 1.3 0.08 glow
	0.5 pen!
	-6 2.3 -6 3.3 2.3 false 1 0 wall-panel-door
	-6 4.3 -6 3.3 2.3 false 1 0 wall-panel-door
	0.3 pen!
	-6 2.5 2 -6 2.5 4.6 edge
	0.45 pen!
	[ [ -1.3 0 -4 ] [ -1.3 0 2 ] [ -6 0 2 ] [ -6 0 4.6 ] [ 1.3 0 4.6 ] [ 1.3 0 -4 ] ] path
	[ [ -1.3 3 -4 ] [ -1.3 3 2 ] [ -6 3 2 ] [ -6 3 4.6 ] [ 1.3 3 4.6 ] [ 1.3 3 -4 ] ] path
