\ === the Master Bedroom ===

\ a turned bedpost from the floor to the canopy, its rings catching the light
: upper-bedpost ( x z top -- )
	| x z top |
	0.6 pen!
	x top z 0.03 8 ring outline
	[ -1 1 ] ( side | x side 0.04 * + 0 z x side 0.03 * + top z edge ) each
	0.45 pen!
	[ 0.3 0.75 1.2 top 0.1 - ] ( height | x height z 0.055 8 ring outline ) each ;

\ a desk telephone on a table top 0.62 high: a base narrowing upward, its dial, and the handset lying across the cradle with its earpiece and mouthpiece
: upper-telephone ( x z -- )
	| x z |
	0.62 to table
	0.08 detail-scale * to half-width
	0.06 detail-scale * to half-depth
	0.05 detail-scale * table + to cradle
	[ [ x half-width - table z half-depth + ] [ x half-width + table z half-depth + ]
	  [ x half-width 0.7 * + cradle z half-depth 0.6 * + ] [ x half-width 0.7 * - cradle z half-depth 0.6 * + ] ] to front
	[ [ x half-width 0.7 * - cradle z half-depth 0.6 * - ] [ x half-width 0.7 * + cradle z half-depth 0.6 * - ]
	  [ x half-width 0.7 * + cradle z half-depth 0.6 * + ] [ x half-width 0.7 * - cradle z half-depth 0.6 * + ] ] to top
	[ [ x half-width + table z half-depth + ] [ x half-width + table z half-depth - ]
	  [ x half-width 0.7 * + cradle z half-depth 0.6 * - ] [ x half-width 0.7 * + cradle z half-depth 0.6 * + ] ] to side
	[ front top side ] ( face | face 0 fill ) each
	0.7 pen!
	[ front top side ] ( face | face outline ) each
	0.55 pen!
	[ x table cradle + 2 / z half-depth 0.8 * + 0.004 + ] [ 1 0 0 ] [ 0 0.86 0.5 ] half-width 0.3 * 10 circle-points outline
	cradle 0.025 + to grip
	[ -1 1 ] ( end |
		x end half-width 0.85 * * + to end-x
		end-x cradle 0.012 + z 0.028 detail-scale * 10 ring to cup
		cup 0 fill
		0.95 pen!
		cup outline
	) each
	0.95 pen!
	[ -0.01 0.01 ] ( offset |
		[ [ x half-width 0.85 * - cradle 0.012 + z offset + ] [ x half-width 0.5 * - grip z offset + ]
		  [ x half-width 0.5 * + grip z offset + ] [ x half-width 0.85 * + cradle 0.012 + z offset + ] ] path
	) each ;

