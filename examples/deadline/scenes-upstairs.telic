	[ [ -3 0 0 ] [ 1.6 0 0 ] [ 2.4 0 0.8 ] [ 3 0 2 ] [ -3 0 2 ] ] 0.07 fill
	0 40 1 do k
		k 40 / 6 * -3 + to baluster
		[ [ baluster 0.012 - 0 2 ] [ baluster 0.012 + 0 2 ] [ baluster 0.462 + 0 1.05 ] [ baluster 0.438 + 0 1.05 ] ] 0 fill
	loop
	[ [ -2.55 0 1.02 ] [ 2.3 0 1.02 ] [ 2.3 0 1.1 ] [ -2.55 0 1.1 ] ] 0 fill
	0.05 pen!
	[ -3 0 0.2 ] [ 3 0 0.2 ] [ 3 0 2 ] [ -3 0 2 ] 1 9 grid
	\ the house wall and the glass door to the bedroom
	0.5 pen!
	-3 0 0 -3 3.2 0 edge
	-3 0 0 3 0 0 edge
	0.25 pen!
	-3 3.2 0 3 3.2 0 edge
	:bedroom-balcony-door :open flag? if
		[ [ -0.6 0 0 ] [ 0.6 0 0 ] [ 0.6 2.4 0 ] [ -0.6 2.4 0 ] ] 0 fill
		[ 0 1.2 -2 ] 1.5 0.14 glow
		0.08 pen!
		[ -0.6 0 0 ] [ 0.6 0 0 ] [ 0.6 0 -1.6 ] [ -0.6 0 -1.6 ] 3 4 grid
		0.7 pen!
		[ [ -0.6 0 0 ] [ 0.6 0 0 ] [ 0.6 2.4 0 ] [ -0.6 2.4 0 ] ] outline
		[ [ -0.6 0 0 ] [ -0.05 0 -0.85 ] [ -0.05 2.4 -0.85 ] [ -0.6 2.4 0 ] ] to leaf
		leaf 0.03 fill
		0.55 pen!
		leaf first leaf second leaf 2 @i leaf 3 @i 1 5 pane-grid
		[ [ [ -3 0 0 ] [ -0.6 0 0 ] [ -0.6 3.2 0 ] [ -3 3.2 0 ] ]
		  [ [ 0.6 0 0 ] [ 1.6 0 0 ] [ 1.6 3.2 0 ] [ 0.6 3.2 0 ] ]
		  [ [ -0.6 2.4 0 ] [ 0.6 2.4 0 ] [ 0.6 3.2 0 ] [ -0.6 3.2 0 ] ] ] ( wall | wall 0 fill ) each
		0.5 pen!
		-3 0 0 -3 3.2 0 edge
		-3 0 0 -0.6 0 0 edge
		0.6 0 0 3 0 0 edge
		0.25 pen!
		-3 3.2 0 3 3.2 0 edge
		0.7 pen!
		[ [ -0.6 0 0 ] [ 0.6 0 0 ] [ 0.6 2.4 0 ] [ -0.6 2.4 0 ] ] outline
	else
		0.7 pen!
		[ -0.6 0 0 ] [ 0.6 0 0 ] [ 0.6 2.4 0 ] [ -0.6 2.4 0 ] 2 5 pane-grid
	then
	[ -3 0 2 ] [ 3 0 2 ] 40 upper-railing
	[ -3 0 0 ] [ -3 0 2 ] 16 upper-railing ;

