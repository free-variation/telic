	[ 24 1.4 -4.8 ] lamp!
	[ [ [ 26.1 0 -5.1 ] 0.15 ] [ [ 26.9 0 -5.4 ] -0.2 ] ] spots!
	0.35 pen!
	25 28 -6 -3.6 2.3 room-shell
	[ [ 25 2.3 -3.6 ] [ 26.5 3.1 -3.6 ] [ 28 2.3 -3.6 ] ] path
	[ [ 25 2.3 -6 ] [ 26.5 3.1 -6 ] [ 28 2.3 -6 ] ] path
	26.5 3.1 -3.6 26.5 3.1 -6 edge
	0.08 pen!
	[ 25 0 -6 ] [ 28 0 -6 ] [ 28 0 -3.6 ] [ 25 0 -3.6 ] 12 hatch
	[ 25.03 1.0 -5.3 ] 0.5 0.12 glow
	[ [ 25.02 1.0 -5.3 ] [ 25.02 1.0 -4.3 ] [ 25.02 1.8 -4.3 ] [ 25.02 1.8 -5.3 ] ] to grimy
	grimy 0.12 near-fill
	0.75 pen!
	grimy outline
	0.22 pen!
	[ 25.03 1.0 -5.3 ] [ 25.03 1.0 -4.3 ] [ 25.03 1.8 -4.3 ] [ 25.03 1.8 -5.3 ] 7 hatch
	0.06 pen!
	0 5 1 do k
		k 0.5 * -5.3 + to z
		[ 25.02 1.8 z ] [ 26.6 0 z 0.15 + ] segment
	loop
	[ [ 25.8 0 -5.3 ] [ 26.6 0 -5.3 ] [ 26.6 0 -4.3 ] [ 25.8 0 -4.3 ] ] 0.05 near-fill
	0.5 pen!
	0 3 1 do shelf
		shelf 0.55 * 0.5 + to board
		27.6 board -5.95 28 board -3.65 solid-box
		0 5 1 do k
			shelf 5 * k + 13.1 * hash-fraction to chance
			k 0.44 * -5.8 + to z
			chance 0.4 > if
				0.6 pen!
				27.65 board 0.04 + z 27.95 board chance 0.25 * + 0.1 + z 0.18 + solid-box
			then
		loop
	loop
	[ [ 26.0 1.95 :spade ] [ 26.5 1.95 :rake ] [ 27.0 1.95 :hoe ] [ 25.6 1.9 :saw ] ]
	( tool | tool spread to head to top to x x top 1.2 head -5.97 hanging-tool ) each
	0.55 pen!
	[ 26.3 1.3 -5.95 ] [ 1 0 0 ] [ 0 1 0 ] 0.12 12 circle-points outline
	[ 26.3 1.3 -5.95 ] [ 1 0 0 ] [ 0 1 0 ] 0.08 12 circle-points outline
	:shed-room [ 27.2 0 -5.3 ] [ 27.85 2.25 -5.9 ] [ 0 0 0 ] [ 0 0 0 ] true ladder-for ;

