\ Deadline: what the things do. A thing's handler is asked first whenever a
\ command names the thing, directly or indirectly, and answers 1 when it
\ dealt with the command, 0 to leave it to the action's default. The few
\ things that can be sat on are also asked at the start (:begin) and end
\ (:end) of every command given from them, and take no part then.

\ whether anyone is in a room
: inhabited? ( room -- flag )
	| room |
	room null? if false exit then
	room contents-of ( item | item :person flag? ) find-first null? not ;

"You would be an impolite guest to fool with these things without cause." to no-touch

\ === the grounds ===

: lawn-handler ( context -- result )
	drop
	[< :examine >] verb? not if 0 exit then
	"The lawn is well manicured." tell-line
	1 ;

' lawn-handler :lawn handles

: bay-window-handler ( context -- result )
	drop
	[< :look-inside >] verb? if
		here :west-of-door = if
			"You see the living room through the window." tell-line
		else :gardener :south-lawn inside? if
			"Through the bay windows the gardener, Mr. McNabb, can be seen " tell
			lawn-activities pick-one tell
			" on the south lawn." tell-line
		else
			"You can see the south lawn." tell-line
		then then
		1 exit
	then
	[< :open >] verb? :foyer :touched flag? not and if
		"The window seems to be latched from the inside." tell-line
		1 exit
	then
	0 ;

' bay-window-handler :bay-window handles

: rose-handler ( context -- result )
	drop
	[< :smell >] verb? if "They smell nice." tell-line 1 exit then
	[< :examine >] verb? if
		"There are rows of yellow, red, pink, and white roses here." tell-line
		1 exit
	then
	[< :take >] verb? if
		"Taking a rose would be most ungracious, and possibly dangerous if Mr. McNabb
		found out." tell-line
		1 exit
	then
	0 ;

' rose-handler :rose handles

: house-handler ( context -- result )
	drop
	[< :find >] verb? if "It's right here. Some inspector you are." tell-line 1 exit then
	[< :through >] verb? if
		here :front-path = :front-door :open flag? and if
			:foyer true goto
		else here :east-of-door = :bay-window :open flag? and if
			:living-room true goto
		else
			"You might try the front door." tell-line
		then then
		1 exit
	then
	[< :examine >] verb? if
		"The house is a magnificent New England colonial, like many other houses
		around the lake. It is painted slate gray with white trim." tell-line
		1 exit
	then
	0 ;

' house-handler :house handles

: ground-handler ( context -- result )
	drop
	[< :brush >] verb? :fragment :player inside? and :fragment-cleaned state not and if
		:brush :fragment null perform drop
		1 exit
	then
	[< :examine :search :search-around >] verb? not if 0 exit then
	here :rourke-room = if "The floor is hardwood." tell-line 1 exit then
	here :foyer = if "The floor is marble." tell-line 1 exit then
	here :in-roses = not if "You don't find anything new there." tell-line 1 exit then
	:hole :invisible flag? not if
		:search-around :hole null perform drop
		1 exit
	then
	"There are rows upon rows of roses here. It would take you the best part of
	a day to search the ground in great detail." tell-line
	1 ;

' ground-handler :ground handles

\ a breeze through the first open door among the room's exits; true when there is one
: fresh-air? ( -- flag )
	here :exits property to exits
	exits null? if false exit then
	compass [ :in :out ] concat ( direction |
		exits direction null @or to way
		way null? if false exit then
		way exit-kind :door = if way :door @ :open flag? else false then
	) find-first to direction
	direction null? if false exit then
	"There is a pleasant breeze coming through the " tell
	exits direction @ :door @ tell-name
	"." tell-line
	true ;

: air-handler ( context -- result )
	drop
	[< :smell >] verb? not if 0 exit then
	[ :rose-garden :in-roses ] here position-of 0 >= if
		"The smell of roses permeates everything." tell-line
	else [ :north-lawn :east-lawn :west-lawn ] here position-of 0 >= if
		"A breeze carries the faint smell of roses through the air." tell-line
	else here :line property outside-line = if
		"The air is clear and fresh here." tell-line
	else fresh-air? not if
		"The air is rather musty here." tell-line
	then then then then
	1 ;

' air-handler :air handles

: lake-handler ( context -- result )
	drop
	[< :swim :leap :through >] verb? if
		"You're not on vacation, but with ideas like that you will probably be given
		a rather long one." tell-line
		1 exit
	then
	[< :look-inside :examine >] verb? if
		here :north-lawn = :soggy-will :lake inside? and if
			"A crumpled piece of paper is floating on the water a few feet from shore.
			With an uncommonly agile motion, you retrieve the drenched paper." tell-line
			:soggy-will winner move-to
		else
			"Surely you don't suspect the fish also?" tell-line
		then
		1 exit
	then
	0 ;

' lake-handler :lake handles

: shed-handler ( context -- result )
	drop
	[< :through >] verb? if
		[ :east-lawn :behind-shed ] here position-of 0 >= if
			:shed-room true goto
		else
			"Senility strikes!" tell-line
		then
		1 exit
	then
	[< :listen >] verb? if
		:secret-meeting state 0 = if 0 exit then
		"You hear two muffled voices inside the shed." tell-line
		1 exit
	then
	[< :hide-behind >] verb? if
		here :east-lawn = if
			"You carefully sneak behind the shed. It seems that no one saw you." tell-line
		else
			"You leave the shed and quietly slip behind it. Nobody appears to have seen
			you." tell-line
		then
		:behind-shed true goto
		1 exit
	then
	0 ;

' shed-handler :shed handles

: tools-handler ( context -- result )
	drop
	[< :take >] verb? not if 0 exit then
	"The tools are standard gardening tools, in excellent condition. You have no
	use for them, unless you are looking for a new profession." tell-line
	1 ;

' tools-handler :tools handles

: shed-shelves-handler ( context -- result )
	drop
	[< :examine >] verb? not if 0 exit then
	"The shelves contain various garden tools." tell-line
	1 ;

' shed-shelves-handler :s-shelves handles

: ladder-handler ( context -- result )
	drop
	[< :put >] verb? indirect :hole = and if
		"The ladder fits perfectly in the holes! You slowly release the
		ladder and it rests on the railing of the balcony above." tell-line
		true :ladder-flag state!
		:ladder here move-to
		true :ladder-positioned state!
		:ladder :undescribed set-flag
		1 exit
	then
	[< :climb-up >] verb? :ladder-flag state not and :ladder-flag-2 state not and if
		"Climbing a ladder while it is horizontal is, at best, a contradiction
		in terms." tell-line
		1 exit
	then
	[< :lean >] verb? [< :house :balcony >] indirect has? and if
		here :in-roses = if
			true :ladder-flag state!
			false :ladder-flag-2 state!
			true :ladder-positioned state!
			:ladder here move-to
			"The ladder is now leaning against the railing of a balcony above." tell-line
		else here :in-orchard = if
			false :ladder-flag state!
			true :ladder-flag-2 state!
			:ladder here move-to
			"The ladder, firmly planted in the soil of the orchard, is now leaning
			against the balcony above." tell-line
		else
			"There is no good spot to lean it against here." tell-line
			1 exit
		then then
		:ladder :undescribed set-flag
		1 exit
	then
	[< :take :move >] verb? if
		:ladder :undescribed clear-flag
		false :ladder-flag state!
		false :ladder-flag-2 state!
		0 exit
	then
	[< :examine >] verb? if
		"The ladder is a typical gardening ladder, about fifteen feet long and caked
		with dirt and dried mud." tell-line
		1 exit
	then
	0 ;

' ladder-handler :ladder handles

\ the ladder seen from the balcony it leans against
: global-ladder-handler ( context -- result )
	drop
	here :library-balcony = :ladder-flag state and
	here :bedroom-balcony = :ladder-flag-2 state and or not if 0 exit then
	[< :take >] verb? if "It's too difficult from here." tell-line 1 exit then
	[< :rub >] verb? if 0 exit then
	[< :examine >] verb? if
		"The top of the ladder is visible, but the rest is hard to see." tell-line
		1 exit
	then
	"You can't do that from here." tell-line
	1 ;

' global-ladder-handler :global-ladder handles

[ "You are making quite a mess, but you do run across some tiny pieces of a
  hard, shiny substance, which drop from your fingers and back onto the ground."
  "Although everything is coming up roses, you haven't found anything unusual
  except for a few pieces of a hard substance which fall back to the ground."
] to rose-digs

: hole-handler ( context -- result )
	drop
	:hole-tell state not if "What hole?" tell-line 1 exit then
	[< :ask-about >] verb? if 0 exit then
	[< :find >] verb? if
		here :in-roses = not if
			"They're among the roses, or have you forgotten?" tell-line
		else :hole :invisible flag? not if
			"They're right here!" tell-line
		else :hole-shown state if false else 80 probability then if
			"The rose garden is vast and full of thorny roses. You might look
			for the rest of the day before you find them." tell-line
		else
			"The garden is rather big, even just the area you are searching now, and the
			holes were small. They're not here, but are probably nearby." tell-line
		then then then
		1 exit
	then
	object :hole = indirect :hole = or not if
		"There is no hole here." tell-line
		1 exit
	then
	[< :examine :look-inside >] verb? if
		"There are two holes here, each about two inches by four inches. They are at
		least three inches deep and the soil is compacted around them." tell-line
		1 exit
	then
	[< :search-ground-around >] verb? object :ground = and [< :search-around >] verb? or not if 0 exit then
	:gardener location-of here = if
		"Mr. McNabb watches you with ill-concealed irritation." tell-line
	then
	:fragment-found state if
		"Aside from dirt, organic fertilizer, and small crawly creatures, you turn
		up nothing but roses." tell-line
		1 exit
	then
	:rst state 1+ dup :rst state! to digs
	digs 2 > if true else 30 probability then if
		"Ouch! You cut your finger on a sharp edge as you dig. You search carefully
		in the dirt, now that you are sure something is there, and pull up a piece
		of porcelain, covered with dirt and dried mud." tell-line
		:fragment this-is-it
		:fragment winner move-to
		:fragment :invisible clear-flag
		true :fragment-found state!
		true :fragment-felt state!
		1 exit
	then
	rose-digs digs 1- @i tell-line
	1 ;

' hole-handler :hole handles

: fragment-handler ( context -- result )
	drop
	[< :examine >] verb? if
		:fragment-cleaned state if
			"The fragment is beautifully hand-painted" tell
			true :fragment-flag state!
			:china-examined state if
				", exactly like those you
				saw in the kitchen" tell
			then
			"." tell-line
		else
			"The piece of porcelain is filthy, coated with dried mud. You can barely
			make out some design underneath the dirt." tell-line
		then
		1 exit
	then
	[< :fingerprint >] verb? if
		"It's covered with dirt and mud. You realize that there would be no good
		fingerprints on it." tell-line
		1 exit
	then
	[< :analyze >] verb? if analyze-in-laboratory exit then
	[< :brush >] verb? if
		true :fragment-cleaned state!
		"As you wipe off the piece of porcelain, you notice that it is a fragment of
		some very beautiful piece, handsomely painted." tell
		:china-examined state if
			"  The markings are identical
			to those you saw on the china in the kitchen." tell
		then
		end-line
		1 exit
	then
	0 ;

' fragment-handler :fragment handles

: fruit-trees-handler ( context -- result )
	drop
	[< :pick :eat :take >] verb? not if 0 exit then
	"The fruits are not abundant, and those within reach are far from ripe." tell-line
	1 ;

' fruit-trees-handler :fruit-trees handles

: berry-bush-handler ( context -- result )
	drop
	[< :pick :eat :take >] verb? not if 0 exit then
	"You pick a few berries and pop them into your mouth. Delicious!" tell-line
	1 ;

' berry-bush-handler :berry-bush handles

: grape-arbor-handler ( context -- result )
	drop
	[< :eat >] verb? not if 0 exit then
	"You pick a few grapes and eat them. Mmmm!" tell-line
	1 ;

' grape-arbor-handler :grape-arbor handles

: tree-tops-handler ( context -- result )
	drop
	"You can't reach the tree tops from here." tell-line
	1 ;

' tree-tops-handler :tree-tops handles

\ === doors and windows ===

{ :master-bedroom-door :master-bedroom :george-door :george-room
  :dunbar-door :dunbar-room :rourke-door :rourke-room
} to rooms-behind-doors

: door-handler ( context -- result )
	drop
	[< :listen >] verb? if "You can't hear anything through the door." tell-line 1 exit then
	[< :knock >] verb? not if 0 exit then
	object :front-door = :welcomed state not and present-time 700 < and here :front-path = and if
		"You hear footsteps inside the house. Mrs. Robner, dressed in black,
		opens the door and greets you." tell-line
		welcome
		1 exit
	then
	rooms-behind-doors object null @or inhabited? if
		"A muffled voice says, ""Come in!""" tell-line
	else
		"There is no answer at the door." tell-line
	then
	1 ;

' door-handler :door handles

: master-bedroom-door-handler ( context -- result )
	| context |
	[< :listen >] verb? :call-in-progress state and if
		"You can hear the muffled voice of Mrs. Robner through the door." tell-line
		1 exit
	then
	[< :knock >] verb? not if 0 exit then
	:call-in-progress state not if context door-handler exit then
	"Mrs. Robner's calls out. ""Wait just one minute!""" tell-line
	1 ;

' master-bedroom-door-handler :master-bedroom-door handles

: balcony-door-handler ( context -- result )
	drop
	[< :hide-behind >] verb? if
		object :open flag? not if
			"You open the balcony door carefully." tell-line
			object :open set-flag
		then
		here :library = if
			:library-balcony
		else here :library-balcony = if
			:library
		else here :master-bedroom = if
			:bedroom-balcony
		else
			:master-bedroom
		then then then true goto
		1 exit
	then
	[< :look-inside >] verb? if
		[ :master-bedroom :library ] here position-of 0 >= if
			"You can see the balcony, but not much beyond." tell-line
		else here :library-balcony = if
			"You can see into the library from here." tell-line
		else
			"You can see the bedroom from here." tell-line
		then then
		1 exit
	then
	0 ;

' balcony-door-handler :balcony-door handles

\ what a dirty window answers to
: dirty-window ( -- result )
	[< :mung >] verb? if
		"Vandalism is not the answer! Think of your position. How would
		it look for a famous police inspector to be arrested?" tell-line
		1 exit
	then
	[< :brush >] verb? if
		"You think you're clever, don't you? The window is so dirty that
		it isn't easily cleaned." tell-line
		1 exit
	then
	[< :look-inside >] verb? if
		"The window is dirty and impossible to see through clearly." tell-line
		1 exit
	then
	0 ;

: window-handler ( context -- result ) drop dirty-window ;

' window-handler :window handles

\ a knock on the window of a room someone is in
: window-knock ( room -- result )
	inhabited? not if 0 exit then
	"Someone looks up at you disgustedly." tell-line
	1 ;

\ the people in a room, each told as being there when asked
: population ( room tell? -- n )
	| room tell? |
	room contents-of ( item | item :person flag? ) filter to people
	tell? if people ( person | person tell-name " is there." tell-line ) each then
	people size ;

\ how many people can be seen through a window into a room
: window-shop ( room text -- )
	| room text |
	room false population to n
	n 0 = if end-line exit then
	" You can vaguely see " tell
	n 1 = if "someone" tell else n tell-number " people" tell then
	" inside the " tell text tell "." tell-line ;

: kitchen-window-handler ( context -- result )
	drop
	[< :mung :brush >] verb? if dirty-window exit then
	[< :open >] verb? if "The window can't be opened." tell-line 1 exit then
	[< :knock >] verb? if here :kitchen = if :orchard else :kitchen then window-knock exit then
	[< :look-inside >] verb? if
		here :kitchen = if
			"You can barely see through the thick leaves of the grape arbor,
			but a lawn and lake can be seen in the distance." tell-line
		else
			"You can see the kitchen beyond the tangle of trees and branches." tell
			:kitchen "kitchen" window-shop
		then
		1 exit
	then
	0 ;

' kitchen-window-handler :kitchen-window handles

: shed-window-handler ( context -- result )
	drop
	[< :mung :brush >] verb? if dirty-window exit then
	[< :open >] verb? if "The window can't be opened." tell-line 1 exit then
	:secret-meeting state to meeting
	[< :listen >] verb? meeting 0 > and if "You can't make out any of the words." tell-line 1 exit then
	[< :look-inside >] verb? not if 0 exit then
	here :shed-room = if
		"Although the window is grimy, you can make out the lawn outside. " tell
		:east-lawn "east lawn" window-shop
	else meeting 4 = if
		"Mr. Baxter seems furious and about to strike Ms. Dunbar, then calms himself.
		Ms. Dunbar starts to cry and is embraced by Mr. Baxter." tell-line
	else meeting 2 > if
		"Mr. Baxter and Ms. Dunbar are inside. Although you can't hear them, it's
		clear from their gestures that a serious argument is occurring. Dunbar appears
		very upset and breaks into tears. Baxter remains composed, but tense and  perhaps
		angry -- you can't be sure." tell-line
	else meeting 0 > if
		"Through the grimy window you see Mr. Baxter and Ms. Dunbar talking. Dunbar
		is doing most of the talking, barely restraining tears. Baxter is listening,
		nodding grimly, and occassionally saying a few words. Unfortunately, you can't
		make any of them out." tell-line
	else
		"You can vaguely make out the inside of the shed through the grime. " tell
		:shed-room "shed" window-shop
	then then then then
	1 ;

' shed-window-handler :shed-window handles

: dining-room-window-handler ( context -- result )
	drop
	[< :mung >] verb? if dirty-window exit then
	[< :open >] verb? if "The window can't be opened." tell-line 1 exit then
	[< :look-inside >] verb? not if 0 exit then
	here :rose-garden = if
		"You can see the dining room through the window." tell
		:dining-room "dining room" window-shop
	else here :in-roses = if
		"You can see the dining room pretty clearly through the window." tell-line
		:dining-room true population drop
	else
		"Through the window, the rose garden can be seen, and, off to
		the north, a wide lawn ending on a blue lake." tell-line
	then then
	1 ;

' dining-room-window-handler :dining-room-window handles

: guest-window-handler ( context -- result )
	drop
	[< :look-inside >] verb? if
		"From here you have a good view of the east lawn, a shed, and the
		lake in the background." tell-line
		512 :guest-room :corridor property!
		look-along-corridors
		:i-window-look 2 queue enable
		1 exit
	then
	[< :open >] verb? if "This window cannot be opened." tell-line 1 exit then
	0 ;

' guest-window-handler :guest-window handles

\ the view from the guest room window lasts two minutes
: window-look-ends ( context -- result )
	drop
	0 :guest-room :corridor property!
	0 ;

' window-look-ends :i-window-look handles

: corridor-window-handler ( context -- result )
	drop
	[< :look-inside >] verb? not if 0 exit then
	"You can see the west lawn through the window." tell-line
	1 ;

' corridor-window-handler :corridor-window handles

\ === the house ===

: global-house-handler ( context -- result )
	drop
	[< :walk-around >] verb? not if 0 exit then
	"Use directions to move around inside the house." tell-line
	1 ;

' global-house-handler :global-house handles

: global-room-handler ( context -- result )
	drop
	[< :through >] verb? if do-walk-around exit then
	[< :knock >] verb? if
		here :upstairs-closet = if
			"The wall to the north here sounds unusually hollow."
		else here :line property outside-line = if
			"You're acting very strangely!"
		else
			"Knocking on the walls reveals nothing unusual."
		then then tell-line
		1 exit
	then
	[< :look-inside >] verb? here :corridor-2 = and if
		"From here, it looks quite ordinary." tell-line
		1 exit
	then
	[< :search :examine >] verb? not if 0 exit then
	here :line property outside-line = if
		10
	else here corridor-bits 0 = not if
		3
	else
		here :size property 2 +
	then then to minutes
	"An exhaustive search of even a single room would take hours. A more
	productive approach would be to examine or search various items of interest
	within the room. A cursory search would take on the order of " tell minutes tell-number "
	minutes, but it wouldn't reveal much. Would you like to do it anyway? (Y/N)" tell
	yes? if
		minutes int-wait if
			"Your brief search revealed nothing that was not obvious before." tell-line
		else
			"You didn't get a chance to finish looking over the room." tell-line
		then
	else
		"Ok." tell-line
	then
	1 ;

' global-room-handler :global-room handles

: global-here-handler ( context -- result )
	drop
	[< :what :ask-about >] verb? not if 0 exit then
	here contents-of ( item | item :person flag? item :player = not and ) filter to others
	others ( person | person true 0 describe-object ) each
	others size 0 = if "There's nobody else here." tell-line then
	1 ;

' global-here-handler :global-here handles

: portraits-handler ( context -- result )
	drop
	[< :examine >] verb? if
		"There are five portraits: two on each side of and one above the bay window.
		The fading portraits are of members of the Phillips family, among the oldest
		in New England." tell-line
		1 exit
	then
	[< :take >] verb? if no-touch tell-line 1 exit then
	0 ;

' portraits-handler :portraits handles

: living-room-cabinets-handler ( context -- result )
	drop
	[< :examine >] verb? not if 0 exit then
	"The cabinets are beautifully handworked walnut and mahogany." tell-line
	1 ;

' living-room-cabinets-handler :lr-cabinets handles

: seurat-handler ( context -- result )
	drop
	[< :examine >] verb? if
		"The painting by Seurat is a cheerful design which suits the bright decor of
		the dining room. It must be worth a fortune." tell-line
		1 exit
	then
	[< :take >] verb? if no-touch tell-line 1 exit then
	0 ;

