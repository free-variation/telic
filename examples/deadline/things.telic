\ === the library, the hidden closet and the balconies ===

: bookshelves-handler ( context -- result )
	drop
	[< :take >] verb? indirect :bookshelves = and if
		"That would make an ungodly pile of books on the floor and take most of
		the day." tell-line
		1 exit
	then
	[< :take >] verb? if
		"You have better things to do than taking books from the shelves." tell-line
		1 exit
	then
	[< :read >] verb? if
		"Reading, while educational, will not help you solve this case." tell-line
		1 exit
	then
	[< :look-behind >] verb? if
		"It would take all day to look behind all of the books." tell-line
		1 exit
	then
	[< :examine :search >] verb? not if 0 exit then
	"The shelves contain many books and manuscripts covering a wide range of
	subjects. They are meticulously arranged." tell-line
	:george-moves-books state :books-moved state adverb "carefully" key-is? and or if
		"One book is out of place, however, leaving a gap in one row. On closer
		inspection, a small black button can be seen at the back of this gap." tell-line
		true :button-revealed state!
		:library-button :invisible clear-flag
	then
	1 ;

' bookshelves-handler :bookshelves handles

: library-button-handler ( context -- result )
	drop
	[< :push >] verb? not if 0 exit then
	:hidden-door-l :open flag? if
		"The bookshelf on the left quietly swings shut." tell-line
		:hidden-door-l :open clear-flag
	else
		"The leftmost shelf quietly swings out against the balcony window." tell-line
		:hidden-door-l :open set-flag
	then
	1 ;

' library-button-handler :library-button handles

: red-button-handler ( context -- result )
	drop
	[< :push >] verb? not if 0 exit then
	:hidden-door-l :open flag? if
		:hidden-door-l :open clear-flag
		"The wall to the west silently closes." tell-line
	else
		:hidden-door-l :open set-flag
		"The wall to the west swings open, revealing the library on the other
		side." tell-line
	then
	1 ;

' red-button-handler :red-button handles

: blue-button-handler ( context -- result )
	drop
	[< :push >] verb? not if 0 exit then
	:hidden-door-b :open flag? if
		:hidden-door-b :open clear-flag
		"The wall to the east swings closed." tell-line
		1 exit
	then
	:hidden-door-b :open set-flag
	"The wall to the east swings open, revealing the master bedroom on the
	other side." tell-line
	:hc-robner state not :mrs-robner :master-bedroom inside? and if
		"Mrs. Robner, sitting on her bed, appears stunned. She walks over and peeks
		in, speaks of her complete surprise at the presence of such a place, and
		returns to her bed, somewhat shaken." tell-line
		true :hc-robner state!
	then
	1 ;

' blue-button-handler :blue-button handles

: safe-handler ( context -- result )
	drop
	[< :open >] verb? :safe :open flag? not and if "The safe is locked." tell-line 1 exit then
	[< :close :lock >] verb? :safe :open flag? and if
		"The safe closes and locks." tell-line
		:safe :open clear-flag
		1 exit
	then
	[< :lock >] verb? if "It already is." tell-line 1 exit then
	[< :unlock >] verb? if "You don't know the combination." tell-line 1 exit then
	[< :look-inside :examine >] verb? if :baxter-papers :invisible clear-flag then
	0 ;

' safe-handler :safe handles

: library-desk-handler ( context -- result )
	drop
	[< :look-inside >] verb? not if 0 exit then
	"There's nothing of interest in the desk." tell-line
	1 ;

' library-desk-handler :library-desk handles

: library-carpet-handler ( context -- result )
	drop
	[< :look-under >] verb? if
		"The carpeting is wall-to-wall so you can't look under it." tell-line
		1 exit
	then
	[< :examine >] verb? not if 0 exit then
	"The carpet is an expensive affair, and quite clean, except for
	a few small areas of dried mud in the vicinity of the desk.
	There are no other stains or markings that you can see." tell-line
	:mud-spot :invisible clear-flag
	1 ;

' library-carpet-handler :library-carpet handles

: desk-calendar-handler ( context -- result )
	| context ^action |
	[< :read :examine >] verb? indirect :intnum = and if
		parsed-number 0 = parsed-number 30 > or if
			"Why?  Is it your birthday?" tell-line
		else
			"You flip the pages until you find the page." tell-line
			parsed-number :calendar-page state!
		then
	then
	[< :close >] verb? if
		"It's not worth the effort." tell-line
	else [< :turn >] verb? indirect null? and if
		:calendar-page state 31 = if
			"You have reached the end of the book." tell-line
			1 exit
		then
		:calendar-page state 1+ :calendar-page state!
		:read to action
	then then
	:calendar-page state to page
	context :object-description = if
		"A desk calendar is here, open to July " tell page tell-number "." tell-line
		1 exit
	then
	[< :read :examine >] verb? if
		"It is open to July " tell page tell-number "." tell-line
		page 8 = if
			"There is only one notation here, in the 9AM spot:
			""Call Coates: Will completed""." tell-line
		else page 7 = if
			"The only listing here is an appointment with Baxter at 2PM
			at the Robner Corp. office." tell-line
		else
			"Nothing of interest is scheduled on this date." tell-line
		then then
		1 exit
	then
	[< :turn >] verb? not if 0 exit then
	indirect :intnum = not if
		"Huh?" tell-line
	else parsed-number 30 > if
		"Thirty days hath September,{nl}April, June, and November,{nl}All the rest have " tell
		parsed-number tell-number "???" tell-line
	else parsed-number 0 = if
		"Do you suppose that would be June 30?" tell-line
	else
		parsed-number :calendar-page state!
		"The calendar is now open to July " tell parsed-number tell-number "." tell-line
	then then then
	1 ;

' desk-calendar-handler :desk-calendar handles

\ the lines that come out of the pad when it is shaded, spaced as they were written
[ "  Baxter," ""
  "                  st time"
  " nsist             op       merg"
  "       mnidy               Oth"
  "          forc"
  "         ocumen     y poss"
  "  plica     y      Focus s"
  "          recons"
  "late!"
  "                              rsha"
  ""
] to pad-impressions

\ the writing pressed into the note pad from the sheet above, revealed by a method
: read-impressions ( method -- )
	| method |
	true :note-read state!
	method tell
	" reveals impressions left by writing on the previous sheet. The writer must
	have borne down heavily, but only a few words come out clearly:" tell-line
	end-line
	pad-impressions ( line | line tell-raw end-line ) each ;

: note-paper-handler ( context -- result )
	drop
	[< :read :examine >] verb? if
		:note-read state if
			"Examination of the paper" read-impressions
		else adverb "carefully" key-is? if
			"There are some indentations on the paper. Something may have been
			written on the previous sheet." tell-line
		else
			"There doesn't seem to be anything written on the pad." tell-line
		then then
		1 exit
	then
	[< :rub >] verb? if
		indirect null? if
			"You should try rubbing or shading the pad with something." tell-line
			1 exit
		then
		indirect :pencil = not if 0 exit then
		"Shading the paper with the pencil" read-impressions
		1 exit
	then
	[< :run-over >] verb? object :pencil = and if
		"Running the pencil over the paper" read-impressions
		1 exit
	then
	[< :hold-up >] verb? indirect :global-light = and if
		"Looking at the pad against the light" read-impressions
		1 exit
	then
	0 ;

' note-paper-handler :note-paper handles

: trash-handler ( context -- result )
	drop
	[< :take :read :examine >] verb? if
		:trash :touched set-flag
		:trash-basket :touched set-flag
	then
	0 ;

' trash-handler :trash handles

: telephone-handler ( context -- result )
	drop
	[ :library :master-bedroom :living-room ] here position-of 0 < if
		"There's no telephone here." tell-line
		1 exit
	then
	[< :find >] verb? if "You are the detective, after all." tell-line 1 exit then
	[< :take :listen :reply >] verb? not if 0 exit then
	:call-ring state if
		"You take the phone and hear an unfamiliar man's voice
		say ""Hello?  Is Leslie there?""  You start to reply, but Mrs. Robner" tell
		here :living-room = if
			" enters and takes the phone from you. ""Thank you, inspector,"" she says, and
			then into the telephone: ""Hello? Oh, hi. I can't really talk now. I'll call
			you back soon, OK? Bye."" She hangs up and starts toward the door." tell-line
		else
			" picks up the phone from another extension and hears you. ""I've got it,
			inspector,"" she says. ""Hello? Oh, it's you. I can't talk now. I'll call
			you back soon. Bye!"" You hear two clicks and the line goes dead." tell-line
		then
		false :call-ring state!
		:mrs-robner :living-room move-to
		call-from-bedroom
		1 exit
	then
	:call-in-progress state if
		"You can hear Mrs. Robner and a man whose voice you don't recognize.
		Robner: ""...much too early to consider it.""{nl}Man's Voice: ""But we couldn't
		have planned it better. You're free.""{nl}Robner: ""Yes, but it will...Wait a
		second...I think...""{nl}""Click."" You realize that the call has been
		disconnected." tell-line
		true :call-overheard state!
		false :call-in-progress state!
		:i-call 0 queue drop
		:mrs-robner unprioritize
		1 exit
	then
	"All you hear is a dial tone." tell-line
	1 ;

' telephone-handler :telephone handles

: global-call-handler ( context -- result )
	drop
	[< :listen >] verb? not if 0 exit then
	:secret-meeting state 0 = not [ :behind-shed :east-lawn ] here position-of 0 >= and if
		"The voices from within the shed are too quiet to make out." tell-line
	else :call-in-progress state here :corridor-1 = and if
		"You can't make out the conversation through the door." tell-line
	else
		"You can't hear any conversation." tell-line
	then then
	1 ;

' global-call-handler :global-call handles

