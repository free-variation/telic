		:i-tune-off 30 queue enable
		:tune-on state tell "." tell-line
		1 exit
	then
	[< :examine >] verb? if
		"George's collection of tapes is large and quite odd in its variety of
		music." tell-line
		1 exit
	then
	0 ;

' tapes-handler :tapes handles

