\ === evidence ===

: cup-handler ( context -- result )
	drop
	[< :examine :look-inside >] verb? if
		"The cup is painted with a scene from Greek mythology and has a brown
		discoloration at the bottom." tell-line
		1 exit
	then
	[< :smell >] verb? if "The cup smells faintly of tea." tell-line 1 exit then
	[< :fingerprint >] verb? if
		"There don't seem to be any fingerprints on the cup." tell-line
		1 exit
	then
	[< :analyze >] verb? object :cup = and if analyze-in-laboratory exit then
	0 ;

