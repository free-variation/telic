	:drunk-flag state if
		"It's one thing to take a bracer on occasion, but you must resist
		the temptation to indulge too often." tell-line
	else
		"You take a small swig of the golden fluid, which burns as it goes
		down." tell-line
		true :drunk-flag state!
	then
	1 ;

' liquor-handler :liquor handles

: stereo-handler ( context -- result )
	drop
	[< :lamp-on >] verb? if
		"The stereo is now on." tell-line
		true :stereo-on state!
		1 exit
	then
	[< :lamp-off >] verb? if
		:tune-on state :george here inside? and if
			"George turns toward you in disgust as you turn off the " tell :tune-on state tell "." tell-line
		else
			"The stereo is now off." tell-line
		then
		false :stereo-on state!
		false :tune-on state!
		:i-tune-off 0 queue drop
		1 exit
	then
	[< :turn-up >] verb? if
		:tune-on state if
			"The " tell :tune-on state tell " is already quite loud. Any louder would probably
			disturb the rest of the house." tell-line
		else
			"It's not on!" tell-line
		then
		1 exit
	then
	[< :turn-down >] verb? if
		:tune-on state not if
			"It's not on!" tell-line
		else :george here inside? if
			"George stops you from turning down the volume. He is practically
			addicted to the " tell :tune-on state tell "." tell-line
		else
			"You can't." tell-line
		then then
		1 exit
	then
	[< :listen >] verb? if
		:tune-on state if "You can hardly avoid it." else "Nothing's playing." then tell-line
		1 exit
	then
	0 ;

' stereo-handler :stereo handles

: records-handler ( context -- result )
	drop
	[< :play :listen >] verb? if
		"You pick a record at random and start it playing. It is a " tell
		record-table pick-one :tune-on state!
		:tune-on state tell "." tell-line
		:i-tune-off 20 queue enable
		1 exit
	then
	[< :examine >] verb? if
		"This is a large collection, with many different types of music represented.
		George is evidently not very particular when it comes to music." tell-line
		1 exit
	then
	0 ;

' records-handler :records handles

: tapes-handler ( context -- result )
