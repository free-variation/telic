: paintings-handler ( context -- result )
	drop
	[< :examine >] verb? if
		"The paintings are by various artists. They are brightly colored (but not
		overly loud) works of cheerful outdoor scenes and still-lifes. They give the
		room a light and pleasant feel." tell-line
		1 exit
	then
	[< :take >] verb? if no-touch tell-line 1 exit then
	0 ;

' paintings-handler :paintings handles

: appliance-handler ( context -- result )
	drop
	[< :take :use >] verb? not if 0 exit then
	"The appliances here are useful in preparing meals, cleaning dishes, and the
	like. It is unlikely that Mrs. Rourke would like you using them." tell-line
	1 ;

' appliance-handler :appliance handles

: silverware-handler ( context -- result )
	drop
	[< :take >] verb? if
		"Although the set would make a fine addition to your home, you resist the
		temptation. You would never get away with it anyway, as Mrs. Robner will no
		doubt count the silverware upon your departure." tell-line
		1 exit
	then
	[< :count >] verb? if "There are 16 complete sets of silver." tell-line 1 exit then
	[< :examine >] verb? if "The silver is of the finest quality and design." tell-line 1 exit then
	0 ;

' silverware-handler :silverware handles

: glasses-handler ( context -- result )
	drop
	[< :count >] verb? if "There are at least two dozen." tell-line 1 exit then
	[< :take >] verb? if no-touch tell-line 1 exit then
	0 ;

' glasses-handler :glasses handles

: foods-handler ( context -- result )
	drop
	[< :eat >] verb? not if 0 exit then
	"Although manners are not taught at the Academy, surely your mother must have
	given you some sense of proper behavior." tell-line
	1 ;

' foods-handler :foods handles

: random-meal-handler ( context -- result )
	drop
	[< :eat :find >] verb? if
		"Although rather hungry, you realize that the case is too important
		for you to be eating meals." tell-line
	else
		"What a strange notion!" tell-line
	then
	1 ;

' random-meal-handler :random-meal handles

\ the fine china in the kitchen, used only by Mr. Robner
: fine-china ( -- result )
	[< :take :rub :move >] verb? if
		"These items are very rare and delicate, and were used only by Mr.
		Robner himself.  You shouldn't even be touching them." tell-line
		1 exit
	then
	[< :examine >] verb? if
		"Each one is hand-painted and depicts a scene from Greek mythology." tell-line
		true :china-examined state!
		1 exit
	then
	[< :mung >] verb? not if 0 exit then
	75 probability if
		"As you reach for the " tell object tell-name ", you think of the pension awaiting you
		upon retirement. ""Is it worth it?"" you think, to be booted off the force
		for an impulse of anger and stupidity. Fortunately, you calm your temper." tell-line
		1 exit
	then
	"With a sweep of your hand, you smash all of them!
	Mrs. Rourke runs into the room, screaming." tell-line
	gone-crazy
	1 ;

\ a piece of the china, which counts as the text says
: china-piece ( count-text -- result )
	| count-text |
	[< :take :rub :move :examine :mung >] verb? if fine-china exit then
	[< :count >] verb? not if 0 exit then
	count-text tell-line
	1 ;

