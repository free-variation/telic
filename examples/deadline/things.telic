: saucer-handler ( context -- result )
	drop
	[< :examine >] verb? if
		"The saucer is hand-painted with a mythological scene. It has a couple of
		small areas of brown discoloration." tell-line
		1 exit
	then
	[< :smell >] verb? if "There is a faint smell of tea." tell-line 1 exit then
	[< :fingerprint >] verb? if false send-to-laboratory exit then
	[< :analyze >] verb? if analyze-in-laboratory exit then
	0 ;

' saucer-handler :saucer handles

: sugar-bowl-handler ( context -- result )
	drop
	[< :taste >] verb? if "The powder tastes like sugar." tell-line 1 exit then
	[< :smell >] verb? if "There is no high from sniffing this powder." tell-line 1 exit then
	[< :eat >] verb? if
		"You eat some, but it is cloyingly sweet, so you stop." tell-line
		1 exit
	then
	[< :fingerprint >] verb? if false send-to-laboratory exit then
	[< :analyze >] verb? if analyze-in-laboratory exit then
	0 ;

' sugar-bowl-handler :sugar-bowl handles

: global-fingerprints-handler ( context -- result )
	drop
	[< :take >] verb? object :global-fingerprints = and not if 0 exit then
	indirect null? if
		"You must specify what to take the fingerprints from." tell-line
		1 exit
	then
	:fingerprint indirect null perform drop
	1 ;

' global-fingerprints-handler :global-fingerprints handles

\ the item in the financial pages about the merger
: read-second-section ( -- )
	true :newspaper-read state!
	"In your study of the second section, a small item in the financial section
	catches your eye. A merger between Robner Corp. and Omnidyne is set to be
	concluded shortly. There is a picture of Mr. Baxter with Omnidyne president
	Starkwell, both smiling broadly. Baxter is quoted as saying that the deal
	will enable the financially ailing Robner Corp. to continue to produce the
	highest-quality products. The article points out that Marshall Robner, who
	founded Robner Corp. but is no longer its major stockholder, had been found
	dead yesterday morning, an apparent suicide victim. Baxter is quoted as
	saying that Robner was in full agreement with the terms of the merger." tell-line ;

: newspaper-handler ( context -- result )
	drop
	[< :examine :read :open >] verb? not if 0 exit then
	adverb "carefully" key-is? adverb "slowly" key-is? or if
		read-second-section
		1 exit
	then
	"The Daily Herald is a local paper in two sections. In your cursory look at
	the first, you find a brief obituary for Mr. Robner. It details his career,
	including the formation of Robner Corp. A few years ago, Mr. Robner and the
	Robner Corp. were given a prestigious award for works in the community. At
	that time Robner said ""I am proud to accept this award for the Corporation.
	Robner Corp is my whole life, and I will continue to guide it for the public
	interest as long as I live."" Robner himself had won great public acclaim for
	his charitable works." tell-line
	1 ;

' newspaper-handler :newspaper handles

: second-section-handler ( context -- result )
	drop
	[< :take >] verb? if
		:newspaper winner inside? if
			"You already have the whole newspaper." tell-line
		else
			:take :newspaper null perform drop
		then
		1 exit
	then
	:newspaper winner inside? not if "You don't have the newspaper." tell-line 1 exit then
	[< :examine :read >] verb? if read-second-section 1 exit then
	[< :drop >] verb? if
		"You shouldn't leave pieces of the paper lying around. At least
		leave the whole thing." tell-line
		1 exit
	then
	0 ;

' second-section-handler :second-section handles

: envelope-handler ( context -- result )
	drop
	[< :open >] verb? if
		:mrs-robner location-of here = if
			"Mrs. Robner grabs the envelope from you. ""That,"" she
			says, ""is none of your business!""" tell-line
			:envelope :mrs-robner move-to
			1 exit
		then
		true :envelope-opened state!
		:envelope winner inside? not if
			false itake 0 = not if "(Taken)" tell-line then
		then
		0 exit
	then
	[< :close >] verb? :envelope-opened state and if
		"You close the envelope carefully, but it still looks like it has been
		opened." tell-line
		:envelope :open clear-flag
		1 exit
	then
	0 ;

' envelope-handler :envelope handles

: letter-handler ( context -- result )
	drop
	[< :take >] verb? if :envelope :touched set-flag then
	0 ;

' letter-handler :letter handles

: pistol-handler ( context -- result )
	drop
	[< :examine >] verb? not if 0 exit then
	:pistol :touched flag? if
		"The pistol is bloody and has clearly been used recently." tell-line
	else
		"The pistol has bloodstains on it. It has recently been fired." tell-line
	then
	1 ;

' pistol-handler :pistol handles

: corpse-handler ( context -- result )
	drop
	[< :examine >] verb? if
		"The corpse is most gruesome. Ms. Dunbar was apparently shot in the
		head at close range, leaving a most distasteful mess." tell-line
		1 exit
	then
	[< :rub >] verb? if "The body is still quite warm." tell 1 exit then
	0 ;

' corpse-handler :corpse handles

: suicide-note-handler ( context -- result )
	drop
	[< :analyze >] verb? not if 0 exit then
	"The handwriting is very shaky and would be impossible to compare with samples
	on file. The blood makes the finding of fingerprints impossible." tell-line
	1 ;

' suicide-note-handler :suicide-note handles

: global-pen-handler ( context -- result )
	drop
	[< :find >] verb? if
		here :dunbar-room = if
			"It doesn't seem to be around here." tell-line
		else
			"There isn't one here." tell-line
		then
		1 exit
	then
	[< :ask-for :ask-about >] verb? if 0 exit then
	"There is no pen to be seen here." tell-line
	1 ;

' global-pen-handler :global-pen handles

: pen-handler ( context -- result )
	drop
	[< :write >] verb? not if 0 exit then
	"The pen makes a mark in a fine blue line." tell-line
	1 ;

' pen-handler :pen handles

: recursive-book-handler ( context -- result )
	drop
	[< :ask-for >] verb? object :baxter = and if
		indirect :undescribed clear-flag
		0 exit
	then
	[< :take >] verb? :recursive-book :baxter inside? and if
		object :undescribed clear-flag
		0 exit
	then
	[< :examine >] verb? if
		"This is a novelization of DEADLINE, a classic work of computer fiction." tell-line
		1 exit
	then
	[< :read :open >] verb? if
		"The book is a novelization of DEADLINE. You start to read it, and it seems
		oddly familiar, as if you had lived it." tell-line
		1 exit
	then
	0 ;

' recursive-book-handler :recursive-book handles

\ === things spoken of ===

[ null null
  """Murder? My dear inspector, I believe you are reading too many bad detective
  stories. It's clear that he committed suicide."""
  "Ms. Dunbar turns toward you, looking quite confused. ""Murder? But...but how
  do you know it was murder? I'm sure..."" She stops short, looking frightened."
  """My father killed himself, as everyone knows. Please leave me alone."""
  """That's odd that you should say murder. Surely you don't suspect foul play,
  Inspector. My husband was devoted to his business, and its decline led him to
  take his life. The whole affair is tragic enough without your melodramatic
  insinuations."""
  """Was it a murder, then?"" She bounces with excitement. ""In the book I've
  been reading, the jealous wife did it, but I don't know about this. A whole
  batch of suspects, this group here. What do you know? A murder. Here!"" Her
  enjoyment is barely concealed."
  null
] to murder-reactions

\ asked about murder or suicide
: global-murder-handler ( context -- result )
	drop
	[< :ask-about >] verb? not if 0 exit then
	indirect :global-murder = not if
		"""I told everything I know about it to the other detectives.""" tell-line
		1 exit
	then
	murder-reactions object :character property @i to reaction
	reaction null? if 0 exit then
	reaction tell-line
	1 ;

' global-murder-handler :global-murder handles

: global-mr-robner-handler ( context -- result )
	drop
	[< :follow >] verb? if "Is this what they call a death wish?" tell-line 1 exit then
	[< :call >] verb? if "You are, for the moment, not with him." tell-line 1 exit then
	0 ;

' global-mr-robner-handler :global-mr-robner handles

: global-red-herrings-handler ( context -- result )
	drop
	:george :dining-room inside? if
		[< :eat :take :move >] verb? if
			"You reach for the juicy herrings, but George forces you away. He
			is a killer where herrings are concerned." tell-line
			1 exit
		then
		[< :find >] verb? if "There are more in this room than elsewhere." tell-line 1 exit then
		0 exit
	then
	[< :find >] verb? if "They're all around you." tell-line 1 exit then
	[< :what >] verb? if "That would be telling." tell-line 1 exit then
	0 ;

' global-red-herrings-handler :global-red-herrings handles

: global-ending-handler ( context -- result )
	drop
	:recursive-book :player inside? if
		[< :read :what :turn >] verb? not if 0 exit then
		"You thumb to the last page and start to read the ending, in which the
		protagonist reads the plot of the story and kills himself in disgust.
		Disgustedly, you reach into your pocket, remove a gun, and end your life." tell-line
		quit-game
	then
	[< :what >] verb? if "That's up to you!" tell-line 1 exit then
	"You don't have the book that tells the ending." tell-line
	1 ;

' global-ending-handler :global-ending handles

: today-handler ( context -- result )
	drop
	[< :what >] verb? not if 0 exit then
	"Today is Friday, July 10." tell-line
	1 ;

' today-handler :today handles

: global-warrant-handler ( context -- result )
	drop
	[< :take :find >] verb? not if 0 exit then
	"Knowing the courts, it would take weeks to get one." tell-line
	1 ;

' global-warrant-handler :global-warrant handles
