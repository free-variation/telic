\ === tables of 3-byte entries ===

\ search a table of 3-byte entries for a key (9D12): the entry, or the 0xFF terminator
: table-entry ( key table -- entry )
	| key table |
	table to entry
	begin entry b@ dup key = swap 255 = or not while entry 3 + to entry repeat
	entry ;

\ the entry is a match, not the terminator
: found? ( entry -- flag ) b@ 255 = not ;

\ the 16-bit value an entry holds
: entry-value ( entry -- value ) 1+ w@ ;

\ the address of room A's record (9B0C), or 0 for 80 and above
: room-record ( room -- address )
	| room |
	room 80 >= if 0 exit then
	room 2 * 0xB8D0 + w@ ;

\ the address of object A's record (9B25)
: object-record ( object -- address ) 0xBF53 table-entry entry-value ;

\ the object numbers in the object index, in order
: object-numbers ( -- numbers )
	[ ] to numbers
	0xBF53 to entry
	begin entry b@ 255 = not while numbers entry b@ add-last! drop entry 3 + to entry repeat
	numbers ;

\ === random numbers ===

\ a random number from -range to +range (9BFD): a byte mixed from the seed
\ and memory at a moving counter, never the same as the last, halved until it
\ is at most twice the range
: random-in-range ( range -- n )
	| range |
	range 2 * 255 min2 to limit
	begin
		random-counter 1+ b@ 1+ 256 mod random-counter 1+ b!
		random-counter 1+ b@ 0 = if random-counter b@ 1+ random-counter b! then
		random-counter w@ to address
		random-seed b@ address b@ + 256 mod address 1+ 65535 bit-and b@ bit-xor to byte
		byte random-seed b@ =
	while
	repeat
	byte random-seed b!
	begin byte limit > while byte 1 rshift to byte repeat
	byte range - ;

\ a random number from 0 to range (9BF4): the size of one from -range to +range
: random-to ( range -- n ) random-in-range abs ;
