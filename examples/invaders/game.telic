\ Space Invaders: the art, the state, the synthesizer patches and music, the
\ rules and the 2D drawing, shared by examples/space-invaders.telic (2D) and
\ examples/space-invaders-3d.telic. Loading it defines everything and starts
\ nothing; the front end calls run-frames with its own frame word.

17 seed

224 256 screen-size 3 screen-zoom :black paper

\ === the art ===

"examples/assets/invaders.png" read-bitmap to sheet

\ the sheet's width by height block whose top-left corner is left top
: cut ( left top width height -- bitmap )
	| left top width height |
	sheet top top height + left left width + submatrix ;

\ a copy of a white bitmap with every visible pixel in the named color
: tint ( bitmap name -- bitmap )
	| bitmap name |
	bitmap 0 * colors name @ + ;

[ 4 52 8 8 cut 20 52 8 8 cut ] to squid-poses
[ 34 52 11 8 cut 50 52 11 8 cut ] to crab-poses
[ 66 52 12 8 cut 82 52 12 8 cut ] to octopus-poses
[ 96 52 16 8 cut :red tint 112 52 16 8 cut :red tint ] to saucer-lights
[ 128 52 16 8 cut :red tint ] to saucer-burst
[ 1 20 13 8 cut :lime tint ] to cannon-bitmaps
[ 33 20 13 8 cut :lime tint 49 20 13 8 cut :lime tint ] to cannon-burst
[ 1 80 1 4 cut ] to laser-bitmaps
[ 82 84 12 8 cut ] to invader-burst
[ 115 84 10 8 cut ] to splat
[ [ 16 80 3 7 cut 20 80 3 7 cut 24 80 3 7 cut 28 80 3 7 cut ]
  [ 32 80 3 7 cut 36 80 3 7 cut 40 80 3 7 cut 44 80 3 7 cut ]
  [ 48 80 3 7 cut 52 80 3 7 cut 56 80 3 7 cut 60 80 3 7 cut ] ] to shot-kinds

[ "....##############...."
  "...################..."
  "..##################.."
  ".####################."
  "######################"
  "######################"
  "######################"
  "######################"
  "######################"
  "######################"
  "######################"
  "######################"
  "#######........#######"
  "######..........######"
  "#####............#####"
  "#####............#####" ] { "#" string>symbol :lime } art>bitmap to bunker-bitmap

\ each formation row's poses and points, top row first
[ [ squid-poses 30 ] [ crab-poses 20 ] [ crab-poses 20 ] [ octopus-poses 10 ] [ octopus-poses 10 ] ] to row-kinds

\ each level's colors, from level 1, repeating after six: the five formation rows, the bunkers, the paper
[ [ [ :white :white :white :white :white ] :lime :black ]
  [ [ :deepskyblue :springgreen :springgreen :gold :gold ] :springgreen :midnightblue ]
  [ [ :orchid :orange :orange :turquoise :turquoise ] :gold :black ]
  [ [ :tomato :yellow :yellow :lawngreen :lawngreen ] :dodgerblue :indigo ]
  [ [ :violet :aqua :aqua :salmon :salmon ] :orange :black ]
  [ [ :gold :hotpink :hotpink :lightskyblue :lightskyblue ] :orchid :navy ] ] to level-palettes

\ === the state ===

{ :mode :title :running 1 :paused 0 :drone-root null :hat-pending 0 :high 0 :score 0 :lives 3 :level 1 :note-offs [ ] :bursts [ ] :labels [ ] } to game

\ a sprite showing bitmaps as its :main animation, its anchor at the middle of its top edge
: make-sprite ( bitmaps x y -- sprite )
	| bitmaps x y |
	bitmaps 0 @i dim nip 2 / truncate to half
	{ :animations { :main bitmaps } :animation :main :x x :y y :anchor [ half 0 ] } ;

\ set one key of the game state
: game! ( value key -- )
	| value key |
	game value key ! drop ;

\ the game state's value at key
: game@ ( key -- value ) game swap @ ;

\ === the synthesizer ===

\ march: a filtered saw and a phase-modulated sine, short and dry
{ :oscillators [
    { :wave :saw :level 0.6 :attack 0.002 :decay 0.12 :sustain 0 :release 0.05 }
    { :level 0.8 :attack 0.002 :decay 0.2 :sustain 0 :release 0.05 }
    { :ratio 2 :level 1 :attack 0.001 :decay 0.08 :sustain 0 :release 0.05 } ]
  :modulation [ [ 2 1 2.5 ] ]
  :carriers [ 0 1 ]
  :cutoff 600 :resonance 1.5 :drive 2 :filter-envelope { :attack 0.001 :decay 0.1 :sustain 0 :release 0.05 :amount 2 }
  :level 0.5 } :march instrument-patch!

\ laser: a pulse and a phase-modulated sine, the pitch swept by a key-synced saw
{ :oscillators [
    { :wave :pulse :width 0.3 :level 0.5 :attack 0.001 :decay 0.12 :sustain 0 :release 0.05 }
    { :level 0.7 :attack 0.001 :decay 0.15 :sustain 0 :release 0.05 }
    { :ratio 1.5 :level 1 :attack 0.001 :decay 0.06 :sustain 0 :release 0.05 } ]
  :modulation [ [ 2 1 4 ] ]
  :carriers [ 0 1 ]
  :lfo { :shape :saw :rate 6 :key-sync 1 :pitch-depth 12 }
  :level 0.22 } :laser instrument-patch!

\ boom: white noise through a resonant ladder whose envelope falls, over a fixed low triangle
{ :oscillators [
    { :wave :white :level 1 :attack 0.001 :decay 0.18 :sustain 0 :release 0.1 }
    { :wave :triangle :fixed-hz 110 :level 0.5 :attack 0.001 :decay 0.1 :sustain 0 :release 0.1 } ]
  :carriers [ 0 1 ]
  :cutoff 1200 :resonance 1.2 :filter-envelope { :attack 0.001 :decay 0.15 :sustain 0 :release 0.1 :amount 3 }
  :level 0.35 } :boom instrument-patch!

\ death: brown noise, a saw an octave down and a burst of white noise through a ringing ladder
{ :oscillators [
    { :wave :brown :level 1 :attack 0.005 :decay 0.9 :sustain 0 :release 0.4 }
    { :wave :saw :ratio 0.5 :level 0.6 :attack 0.005 :decay 0.7 :sustain 0 :release 0.4 }
    { :wave :white :level 0.4 :attack 0.001 :decay 0.25 :sustain 0 :release 0.2 } ]
  :carriers [ 0 1 2 ]
  :cutoff 300 :resonance 3.2 :drive 3 :filter-envelope { :attack 0.001 :decay 0.6 :sustain 0 :release 0.4 :amount 4 }
  :lfo { :shape :sample-and-hold :rate 18 :pitch-depth 7 :cutoff-depth 1 }
  :level 0.6 } :death instrument-patch!

\ saucer: a unison pulse with the LFO on its pitch and width, held while the mothership flies
{ :oscillators [
    { :wave :pulse :width 0.25 :lfo-width 0.2 :level 0.5 :attack 0.05 :decay 0.1 :sustain 1 :release 0.15 }
    { :wave :triangle :ratio 2 :level 0.3 :attack 0.05 :sustain 1 :release 0.15 } ]
  :carriers [ 0 1 ]
  :cutoff 2500 :resonance 1
  :lfo { :shape :triangle :rate 7 :pitch-depth 3 }
  :unison 2 :unison-detune 12 :unison-spread 0.5
  :level 0.16 } :saucer instrument-patch!

\ bonus: a phase-modulated bell, three unison copies spread across the stereo field
{ :oscillators [
    { :attack 0.002 :decay 0.4 :sustain 0 :release 0.3 }
    { :ratio 3 :level 0.6 :attack 0.001 :decay 0.2 :sustain 0 :release 0.2 } ]
  :modulation [ [ 1 0 1.5 ] ]
  :unison 3 :unison-detune 14 :unison-spread 0.6
  :level 0.3 } :bonus instrument-patch!

\ lead: a pulse whose width the LFO moves beside a phase-modulated sine, delayed vibrato, a little glide
{ :oscillators [
    { :wave :pulse :width 0.35 :lfo-width 0.1 :level 0.6 :attack 0.005 :decay 0.3 :sustain 0.6 :release 0.15 }
    { :level 0.5 :attack 0.005 :decay 0.4 :sustain 0.5 :release 0.15 }
    { :ratio 2 :level 0.8 :attack 0.002 :decay 0.2 :sustain 0.3 :release 0.15 } ]
  :modulation [ [ 2 1 1.8 ] ]
  :carriers [ 0 1 ]
  :cutoff 3500 :resonance 0.8 :filter-envelope { :attack 0.005 :decay 0.25 :sustain 0.3 :release 0.2 :amount 1.2 }
  :lfo { :shape :sine :rate 5.5 :delay 0.2 :fade 0.3 :pitch-depth 0.25 }
  :glide 0.03 :unison 2 :unison-detune 8 :unison-spread 0.3
  :level 0.16 :pan -0.1 } :lead instrument-patch!

\ pad: a saw and a pulse an octave down, three detuned copies, the cutoff breathing with a slow LFO
{ :oscillators [
    { :wave :saw :level 0.5 :attack 0.4 :decay 1 :sustain 0.8 :release 0.6 }
    { :wave :pulse :ratio 0.5 :lfo-width 0.2 :level 0.3 :attack 0.5 :decay 1 :sustain 0.8 :release 0.6 } ]
  :carriers [ 0 1 ]
  :cutoff 1400 :resonance 0.6 :lfo { :shape :triangle :rate 0.3 :cutoff-depth 0.5 }
  :unison 3 :unison-detune 18 :unison-spread 0.8
  :level 0.07 :pan 0.1 } :pad instrument-patch!

\ bass-line: a saw over a triangle an octave down, a plucked filter envelope
{ :oscillators [
    { :wave :saw :level 0.6 :attack 0.003 :decay 0.2 :sustain 0.4 :release 0.08 }
    { :wave :triangle :ratio 0.5 :level 0.4 :attack 0.003 :decay 0.3 :sustain 0.6 :release 0.08 } ]
  :carriers [ 0 1 ]
  :cutoff 500 :resonance 2 :drive 2 :filter-envelope { :attack 0.002 :decay 0.12 :sustain 0 :release 0.1 :amount 2.5 }
  :level 0.28 } :bass-line instrument-patch!

\ kick: a sine struck by a fast modulator, its pitch dropped by a key-synced saw
{ :oscillators [
    { :attack 0.001 :decay 0.18 :sustain 0 :release 0.05 }
    { :ratio 4 :level 1 :attack 0.001 :decay 0.02 :sustain 0 :release 0.02 } ]
  :modulation [ [ 1 0 3 ] ]
  :lfo { :shape :saw :rate 8 :key-sync 1 :pitch-depth 12 }
  :level 0.6 } :kick instrument-patch!

\ hat: a tick of white noise
{ :oscillators [ { :wave :white :attack 0.001 :decay 0.03 :sustain 0 :release 0.03 } ]
  :cutoff 9000 :resonance 0.5 :level 0.12 :pan 0.25 } :hat instrument-patch!

\ drone: a pulse whose width the LFO moves and a detuned saw, a slow LFO sweeping the ladder
{ :oscillators [
    { :wave :pulse :width 0.4 :lfo-width 0.15 :level 0.5 :attack 1.2 :decay 1 :sustain 0.9 :release 0.8 }
    { :wave :saw :detune 7 :level 0.35 :attack 1.5 :decay 1 :sustain 0.9 :release 0.8 } ]
  :carriers [ 0 1 ]
  :cutoff 700 :resonance 1.4 :lfo { :shape :sine :rate 0.15 :cutoff-depth 1 }
  :unison 2 :unison-detune 10 :unison-spread 0.6
  :level 0.07 } :drone instrument-patch!

\ sparkle: a short phase-modulated bell
{ :oscillators [
    { :attack 0.001 :decay 0.25 :sustain 0 :release 0.15 }
    { :ratio 3.5 :level 0.7 :attack 0.001 :decay 0.1 :sustain 0 :release 0.1 } ]
  :modulation [ [ 1 0 2 ] ]
  :level 0.12 :pan 0.3 } :sparkle instrument-patch!

\ the effects every screen starts from
: settle-effects ( -- )
	0.15 :wet :chorus effect! 0.002 :depth :chorus effect! 0.5 :rate :chorus effect!
	0.12 :wet :reverb effect! 0.6 :decay :reverb effect! 1.1 :size :reverb effect! 0.5 :damping :reverb effect!
	0 :shimmer1-mix :reverb effect!
	0 :wet :delay effect! 0.18 :time :delay effect! 0.4 :feedback :delay effect! :ping-pong :mode :delay effect!
	0.85 :level :master effect! ;

\ release a note delay seconds from now
: note-off-later ( pitch instrument delay -- )
	| pitch instrument delay |
	:note-offs game@ [ now delay + pitch instrument ] add-last! drop ;

\ play a note for length seconds
: sound ( pitch velocity instrument length -- )
	| pitch velocity instrument length |
	pitch velocity instrument note-on
	pitch instrument length note-off-later ;

\ release every note whose time has come
: release-due-notes ( -- )
	now to moment
	:note-offs game@ to pending
	pending ( 0 @i moment <= ) filter ( dup 1 @i swap 2 @i note-off ) each
	pending ( 0 @i moment > ) filter :note-offs game! ;

\ queue a line of alternating pitches (or arrays of pitches) and lengths on an instrument
: queue-line ( notes instrument -- )
	| notes instrument |
	instrument sequence-instrument
	0 notes size 2 do k
		notes k @i to pitch
		pitch array? if pitch notes k 1+ @i sequence-chord else pitch notes k 1+ @i sequence-note then
	loop ;

\ the same note count times over
: repeated ( pitch length count -- notes )
	| pitch length count |
	[ ] to notes
	0 count 1 do k
		notes pitch add-last! length add-last! drop
	loop
	notes ;

\ === the title theme: eight bars in A minor at 132 beats per minute ===

[ :a1 1/8 :a1 1/8 :a2 1/8 :a1 1/8 :e2 1/8 :a1 1/8 :a2 1/8 :e2 1/8
  :a1 1/8 :a1 1/8 :a2 1/8 :a1 1/8 :e2 1/8 :a1 1/8 :a2 1/8 :e2 1/8
  :f1 1/8 :f1 1/8 :f2 1/8 :f1 1/8 :c2 1/8 :f1 1/8 :f2 1/8 :c2 1/8
  :g1 1/8 :g1 1/8 :g2 1/8 :g1 1/8 :d2 1/8 :g1 1/8 :g2 1/8 :d2 1/8
  :a1 1/8 :a1 1/8 :a2 1/8 :a1 1/8 :e2 1/8 :a1 1/8 :a2 1/8 :e2 1/8
  :a1 1/8 :a1 1/8 :a2 1/8 :a1 1/8 :e2 1/8 :a1 1/8 :a2 1/8 :e2 1/8
  :d2 1/8 :d2 1/8 :d3 1/8 :d2 1/8 :a2 1/8 :d2 1/8 :d3 1/8 :a2 1/8
  :e1 1/8 :e1 1/8 :e2 1/8 :e1 1/8 :b1 1/8 :e1 1/8 :e2 1/8 :g#1 1/8 ] to theme-bass

[ [ :a3 :c4 :e4 ] 1 [ :a3 :c4 :e4 ] 1 [ :f3 :a3 :c4 ] 1 [ :g3 :b3 :d4 ] 1
  [ :a3 :c4 :e4 ] 1 [ :a3 :c4 :e4 ] 1 [ :d3 :f3 :a3 ] 1 [ :e3 :g#3 :b3 ] 1 ] to theme-pad

[ :e5 1/4 :a4 1/8 :c5 1/8 :e5 1/4 :d5 1/8 :c5 1/8
  :b4 1/4 :c5 1/8 :b4 1/8 :a4 1/2
  :a4 1/4 :c5 1/8 :f5 1/8 :e5 1/4 :c5 1/4
  :d5 3/8 :b4 1/8 :g4 1/4 :b4 1/4
  :e5 1/4 :a5 1/4 :g5 1/8 :e5 1/8 :c5 1/4
  :d5 1/8 :e5 1/8 :c5 1/4 :a4 1/2
  :f5 1/4 :e5 1/8 :d5 1/8 :a4 1/4 :d5 1/4
  :g#4 1/4 :b4 1/4 :e5 1/2 ] to theme-lead

:c2 1/4 32 repeated to theme-kick
:c5 1/8 64 repeated to theme-hat

\ queue one pass of the title theme
: queue-theme ( -- )
	132 sequence-tempo 0.9 sequence-articulation
	0.8 sequence-velocity theme-bass :bass-line queue-line
	0.7 sequence-velocity theme-pad :pad queue-line
	0.9 sequence-velocity theme-lead :lead queue-line
	0.9 sequence-velocity theme-kick :kick queue-line
	0.5 sequence-velocity theme-hat :hat queue-line ;

\ the wave-cleared jingle: a rising arpeggio over the tonic chord
: queue-cleared-jingle ( -- )
	132 sequence-tempo 0.9 sequence-articulation 0.9 sequence-velocity
	[ :a4 1/16 :c5 1/16 :e5 1/16 :a5 1/16 :c6 1/16 :e6 1/16 :a6 1/4 ] :lead queue-line
	[ [ :a3 :c4 :e4 :a4 ] 1 ] :pad queue-line ;

\ the game-over jingle: a falling line to the tonic
: queue-over-jingle ( -- )
	100 sequence-tempo 0.95 sequence-articulation 0.9 sequence-velocity
	[ :e5 1/8 :d5 1/8 :c5 1/8 :b4 1/8 :g#4 1/4 :a4 1/2 ] :lead queue-line
	[ [ :e3 :g#3 :b3 ] 1/2 [ :a2 :e3 :a3 :c4 ] 1/2 ] :pad queue-line
	[ :e1 1/2 :a1 1/2 ] :bass-line queue-line ;

\ the extra-life arpeggio
: queue-bonus ( -- )
	160 sequence-tempo 1 sequence-articulation 1 sequence-velocity
	[ :e6 1/16 :g#6 1/16 :b6 1/16 :e7 1/8 ] :bonus queue-line ;

\ === the board ===

\ the current level's palette
: level-palette ( -- palette ) level-palettes :level game@ 1- 6 mod @i ;

\ the level a new game starts at: the whole number after --level on the command line, else 1
: starting-level ( -- level )
	args to arguments
	1 to level
	0 arguments size 1 do k
		arguments k @i "--level" = if
			k 1+ arguments size < if arguments k 1+ @i else "" then string>number to level
		then
	loop
	level null? if "expected --level followed by a whole number of 1 or more" throw then
	level 1 < level dup truncate = not or if "expected --level followed by a whole number of 1 or more" throw then
	level ;

starting-level to start-level

\ the formation for the current level, its top row one row lower per level up to six
: build-formation ( -- )
	[ ] to invaders
	:level game@ 1- 6 min2 8 * 48 + to top
	level-palette 0 @i to row-colors
	[ ] to row-poses
	0 5 1 do row
		row-kinds row @i to kind
		row-colors row @i to color
		kind 0 @i ( color tint ) map to poses
		row-poses poses add-last! drop
		0 11 1 do column
			poses column 16 * 24 + row 16 * top + make-sprite
			kind 1 @i :points ! 1 :rate ! row :row ! column :column !
			invaders swap add-last! drop
		loop
	loop
	row-poses :row-poses game!
	invaders :invaders game! ;

\ four fresh bunkers
: build-bunkers ( -- )
	[ ] to bunkers
	[ 31 76 121 166 ] to lefts
	level-palette 1 @i to color
	0 4 1 do k
		bunkers { :animations { :main [ bunker-bitmap color tint ] } :animation :main :x lefts k @i :y 184 } add-last! drop
	loop
	bunkers :bunkers game! ;

\ the cannon at the left, ready
: place-cannon ( -- )
	cannon-bitmaps 24 216 make-sprite { :main cannon-bitmaps :burst cannon-burst } :animations ! 8 :rate !
	:player game! ;

\ the state a new wave starts from
: start-wave ( -- )
	level-palette 2 @i paper
	build-formation
	build-bunkers
	place-cannon
	1 :direction game!
	0 :step-timer game!
	0 :step-count game!
	0 :note-time game!
	1.5 :fire-timer game!
	20 random 8 * + :saucer-timer game!
	[ ] :shots game!
	[ ] :bursts game!
	[ ] :labels game!
	null :player-shot game!
	null :saucer game!
	null :drone-root game!
	0 :hat-pending game!
	0 :paused game!
	:playing :mode game! ;

\ a new game from level 1
: start-game ( -- )
	silence-audio settle-effects
	0 :score game!
	3 :lives game!
	start-level :level game!
	0 :bonus-given game!
	start-wave ;

\ the title screen, its theme queued with the device closed so every part starts on the same sample
: enter-title ( -- )
	silence-audio audio-off settle-effects
	:black paper
	12 :shimmer1-shift :reverb effect! 0.1 :shimmer1-mix :reverb effect! 0.3 :wet :reverb effect!
	queue-theme
	audio-on
	:title :mode game! ;

\ a short-lived sprite showing bitmaps at x y
: add-burst ( bitmaps x y life -- )
	| bitmaps x y life |
	:bursts game@ bitmaps x y make-sprite life :life ! add-last! drop ;

\ add points to the score, granting the extra life at 1500
: add-score ( points -- )
	:score game@ + :score game!
	:score game@ 1500 >= :bonus-given game@ 0= and if
		1 :bonus-given game!
		:lives game@ 1+ :lives game!
		queue-bonus
	then ;

\ === bunker damage ===

\ the bitmap a bunker shows
: bunker-bitmap-of ( bunker -- bitmap ) :animations @ :main @ 0 @i ;

\ clear a ragged patch of a bunker around the screen point x y
: erode ( bunker x y -- )
	| bunker x y |
	bunker bunker-bitmap-of to bitmap
	bitmap dim to width to height
	x bunker :x @ - truncate to center-column
	y bunker :y @ - truncate to center-row
	center-row 3 - center-row 4 + 1 do row
		center-column 2 - center-column 3 + 1 do column
			row 0 >= row height < and column 0 >= and column width < and random 0.7 < and if
				bitmap null row column !i,j drop
			then
		loop
	loop ;

\ clear every bunker pixel under an invader's box
: crush-bunkers ( invader -- )
	| invader |
	invader sprite-box to box-height to box-width to box-y to box-x
	:bunkers game@ to bunkers
	0 bunkers size 1 do k
		bunkers k @i to bunker
		bunker bunker-bitmap-of to bitmap
		bitmap dim to width to height
		box-y bunker :y @ - truncate 0 max2 to first-row
		box-y box-height + bunker :y @ - truncate height min2 to last-row
		box-x bunker :x @ - truncate 0 max2 to first-column
		box-x box-width + bunker :x @ - truncate width min2 to last-column
		first-row last-row 1 do row
			first-column last-column 1 do column
				bitmap null row column !i,j drop
			loop
		loop
	loop ;

\ the bunker a shot's pixels touch, or null
: struck-bunker ( shot -- bunker )
	| shot |
	:bunkers game@ to bunkers
	0 bunkers size 1 do k
		bunkers k @i to bunker
		shot bunker sprites-overlap? if
			shot bunker sprites-collide? if bunker exit then
		then
	loop
	null ;

\ === the formation ===

\ the seconds between formation steps: one sixtieth per invader, shortened a little each level
: step-interval ( -- seconds )
	:invaders game@ size 60 /
	1 :level game@ 1- 0.05 * - 0.6 max2 *
	0.012 max2 ;

\ the leftmost and rightmost edges of the living invaders
: formation-edges ( -- left right )
	1000 to left
	-1000 to right
	:invaders game@ to invaders
	0 invaders size 1 do k
		invaders k @i sprite-box drop nip to box-width to box-x
		box-x left min2 to left
		box-x box-width + right max2 to right
	loop
	left right ;

\ the march's harmony: a root (a MIDI note) per sixteen steps, the chord on it, and the falling figure below it
[ 45 41 43 40 ] to march-roots
[ [ 0 3 7 12 ] [ 0 4 7 12 ] [ 0 4 7 12 ] [ 0 4 7 12 ] ] to march-chords
[ 0 -2 -4 -5 ] to march-figure

\ release the drone, if it sounds
: release-drone ( -- )
	:drone-root game@ to root
	root null? if exit then
	root 12 + :drone note-off
	root 19 + :drone note-off
	null :drone-root game! ;

\ hold the drone on the root and fifth above a root, moving it when the root changes
: hold-drone ( root -- )
	| root |
	:drone-root game@ root = if exit then
	release-drone
	root 12 + 0.7 :drone note-on
	root 19 + 0.6 :drone note-on
	root :drone-root game! ;

\ the march's cutoff: 600 Hz with the formation's lowest row where the first wave starts it (y 112),
\ rising to 3000 Hz at the cannon's row (y 208)
: march-cutoff ( -- )
	:invaders game@ ( :y @ ) map -1000 ( max2 ) reduce 112 - 96 / 0 1 clamp 2400 * 600 +
	:cutoff :march instrument! ;

\ one formation step's music: the march note, accented on each group's first,
\ and the layers the number of living invaders calls for
: march-voices ( step alive -- )
	| step alive |
	step 16 / truncate 4 mod to harmony
	march-roots harmony @i :level game@ 1- 4 mod + to root
	root march-figure step 4 mod @i + to pitch
	step 4 mod 0= if
		pitch 1 :march 0.25 sound
		pitch 12 - 0.8 :march 0.25 sound
	else
		pitch 0.75 :march 0.25 sound
	then
	alive 40 < if root hold-drone then
	alive 4 < if 3 else 1.5 then :resonance :march instrument!
	alive 10 < if
		march-chords harmony @i step 4 mod @i root + 24 + 0.6 :sparkle 0.2 sound
	then ;

\ move the formation one step and change every invader's pose, sounding the next march note
: step-formation ( -- )
	:invaders game@ to invaders
	:direction game@ to direction
	formation-edges to right to left
	direction 0 > right 2 + 220 > and direction 0 < left 2 - 4 < and or if
		invaders ( dup :y @ 8 + :y ! drop ) each
		direction negate :direction game!
	else
		invaders ( dup :x @ direction 2 * + :x ! drop ) each
	then
	invaders ( 1 advance-sprite ) each
	invaders ( dup :y @ 176 > if crush-bunkers else drop then ) each
	march-cutoff
	now :note-time game@ - 0.07 > if
		:step-count game@ invaders size march-voices
		now :note-time game!
		:step-count game@ 1+ :step-count game!
	then ;

\ step the formation when its interval has passed, ticking the hat halfway
\ between steps while fewer than 25 invaders remain and the steps are 0.14 s or longer apart
: march ( elapsed -- )
	:step-timer game@ swap - :step-timer game!
	:hat-pending game@ :step-timer game@ step-interval 2 / <= and if
		0 :hat-pending game!
		:invaders game@ size 25 < step-interval 0.14 >= and if :c5 0.6 :hat 0.05 sound then
	then
	:step-timer game@ 0 > if exit then
	step-interval :step-timer game!
	1 :hat-pending game!
	step-formation ;

\ === the cannon ===

\ move the cannon by the arrow keys held
: move-cannon ( elapsed -- )
	| elapsed |
	:player game@ to cannon
	0 to motion
	:left key-down? if motion 1- to motion then
	:right key-down? if motion 1+ to motion then
	cannon cannon :x @ motion 72 * elapsed * + 10 214 clamp :x ! drop ;

\ fire while space is held and no shot of the cannon's is in flight
: fire-cannon ( -- )
	:player-shot game@ null? not if exit then
	:space key-down? not if exit then
	laser-bitmaps :player game@ :x @ 212 make-sprite :player-shot game!
	:c6 0.9 :laser 0.15 sound ;

\ end the cannon's shot with a splat at its tip
: end-player-shot ( -- )
	:player-shot game@ to shot
	splat shot :x @ shot :y @ 4 - 0.2 add-burst
	null :player-shot game! ;

\ an invader dies: its burst, its points, a boom
: kill-invader ( invader -- )
	| invader |
	invader 1 :dead ! drop
	invader-burst invader :x @ invader :y @ 0.25 add-burst
	invader :points @ add-score
	:c3 1 :boom 0.3 sound ;

\ the mothership dies: its burst, a random score shown where it was
: kill-saucer ( -- )
	:saucer game@ to saucer
	[ 50 100 150 300 ] random 4 * truncate @i to points
	saucer-burst saucer :x @ saucer :y @ 0.5 add-burst
	:labels game@ { :text points "{0}" format :x saucer :x @ 8 - :y saucer :y @ :life 1.2 } add-last! drop
	points add-score
	:e4 :saucer note-off
	:c3 1 :boom 0.5 sound
	:c2 0.8 :boom 0.6 sound
	null :saucer game!
	0 :wet :delay effect!
	15 random 10 * + :saucer-timer game! ;

\ test the cannon's shot against everything it can hit; 1 when it ended
: player-shot-struck? ( -- flag )
	:player-shot game@ to shot
	shot :y @ 30 < if end-player-shot 1 exit then

	:saucer game@ to saucer
	saucer null? not if
		shot saucer sprites-overlap? if kill-saucer null :player-shot game! 1 exit then
	then

	:invaders game@ to invaders
	0 invaders size 1 do k
		invaders k @i to invader
		shot invader sprites-overlap? if
			shot invader sprites-collide? if
				invader kill-invader
				invaders ( :dead 0 @or not ) filter :invaders game!
				null :player-shot game!
				1 exit
			then
		then
	loop

	:shots game@ to shots
	0 shots size 1 do k
		shots k @i to bomb
		shot bomb sprites-overlap? if
			splat bomb :x @ bomb :y @ 0.2 add-burst
			shots ( bomb = not ) filter :shots game!
			null :player-shot game!
			1 exit
		then
	loop

	shot struck-bunker to bunker
	bunker null? not if
		bunker shot :x @ shot :y @ erode
		end-player-shot
		1 exit
	then
	0 ;

\ move the cannon's shot up in steps of at most 3 pixels, testing each
: move-player-shot ( elapsed -- )
	| elapsed |
	:player-shot game@ null? if exit then
	elapsed 300 * to distance
	distance 3 / truncate 1+ to n-steps
	0 n-steps 1 do k
		:player-shot game@ to shot
		shot shot :y @ distance n-steps / - :y ! drop
		player-shot-struck? if exit then
	loop ;

\ === the invaders' shots ===

\ the seconds until the next invader shot, shorter each level
: fire-interval ( -- seconds ) 1.1 :level game@ 1- 0.12 * - 0.3 max2 random 0.6 + * ;

\ the lowest invader in the column of a random living one fires, when fewer than three shots fly
: invader-fire ( elapsed -- )
	:fire-timer game@ swap - :fire-timer game!
	:fire-timer game@ 0 > if exit then
	fire-interval :fire-timer game!
	:invaders game@ to invaders
	:shots game@ size 3 >= invaders size 0= or if exit then
	invaders random invaders size * truncate @i :x @ to column-x
	invaders ( :x @ column-x = ) filter ( :y @ ) sort-by to column
	column column size 1- @i to shooter
	random 3 * truncate to kind
	shot-kinds kind @i shooter :x @ shooter :y @ 8 + make-sprite 12 :rate ! kind :kind ! to bomb
	:shots game@ bomb add-last! drop ;

\ the cannon is hit: its burst, the death sound, the reverb opened up
: kill-cannon ( -- )
	:player game@ :burst play-animation
	release-drone
	:dying :mode game!
	1.8 :timer game!
	[ ] :shots game!
	null :player-shot game!
	:lives game@ 1- :lives game!
	:c3 1 :death 1.4 sound
	0.45 :wet :reverb effect! 0.85 :decay :reverb effect! ;

\ an invader shot ends; 1 when it hit something
: bomb-struck? ( bomb -- flag )
	| bomb |
	bomb :y @ 7 + 234 > if splat bomb :x @ 230 0.2 add-burst 1 exit then
	bomb :player game@ sprites-collide? if kill-cannon 1 exit then
	bomb struck-bunker to bunker
	bunker null? not if bunker bomb :x @ bomb :y @ 7 + erode 1 exit then
	0 ;

\ move each invader shot down in steps of at most 3 pixels, animating it
: move-bombs ( elapsed -- )
	| elapsed |
	elapsed 80 :level game@ 6 * + * to distance
	distance 3 / truncate 1+ to n-steps
	[ ] to survivors
	:shots game@ to shots
	0 shots size 1 do k
		shots k @i to bomb
		bomb elapsed advance-sprite
		0 to struck
		0 n-steps 1 do step
			struck 0= :mode game@ :playing = and if
				bomb bomb :y @ distance n-steps / + :y ! drop
				bomb bomb-struck? to struck
			then
		loop
		struck 0= if survivors bomb add-last! drop then
	loop
	:mode game@ :playing = if survivors :shots game! then ;

\ === the mothership ===

\ send the mothership across from a random side, its sound held and the delay opened
: launch-saucer ( -- )
	random 0.5 < if 1 -8 else -1 232 then to start to heading
	saucer-lights start 34 make-sprite heading :heading ! 4 :rate ! :saucer game!
	:e4 0.8 :saucer note-on
	0.22 :wet :delay effect! ;

\ the mothership leaves the screen
: retire-saucer ( -- )
	:e4 :saucer note-off
	null :saucer game!
	0 :wet :delay effect!
	15 random 10 * + :saucer-timer game! ;

\ count down to the next mothership, or fly the current one, panning its sound with it
: update-saucer ( elapsed -- )
	| elapsed |
	:saucer game@ to saucer
	saucer null? if
		:saucer-timer game@ elapsed - :saucer-timer game!
		:saucer-timer game@ 0 <= :invaders game@ size 8 >= and if launch-saucer then
		exit
	then
	saucer saucer :x @ saucer :heading @ 45 * elapsed * + :x ! drop
	saucer elapsed advance-sprite
	saucer :x @ 112 - 112 / -1 1 clamp :pan :saucer instrument!
	saucer :x @ -10 < saucer :x @ 234 > or if retire-saucer then ;

\ === the rules ===

\ age the bursts and score labels, dropping the expired
: age-effects ( elapsed -- )
	| elapsed |
	:bursts game@ ( dup :life @ elapsed - :life ! drop ) each
	:bursts game@ ( :life @ 0 > ) filter :bursts game!
	:labels game@ ( dup :life @ elapsed - :life ! drop ) each
	:labels game@ ( :life @ 0 > ) filter :labels game! ;

\ an invader at the cannon's row ends the game
: check-invasion ( -- )
	:invaders game@ ( :y @ 8 + 216 >= ) any? if
		kill-cannon
		0 :lives game!
	then ;

\ the formation is gone: the jingle, then the next wave
: check-cleared ( -- )
	:invaders game@ size 0 > if exit then
	:saucer game@ null? not if retire-saucer then
	release-drone
	:cleared :mode game!
	3 :timer game!
	[ ] :shots game!
	null :player-shot game!
	queue-cleared-jingle ;

\ one frame of play
: update-playing ( elapsed -- )
	| elapsed |
	:p key-pressed? if :paused game@ 0= :paused game! then
	:paused game@ if release-drone exit then
	elapsed move-cannon
	fire-cannon
	elapsed move-player-shot
	elapsed march
	elapsed invader-fire
	elapsed move-bombs
	:mode game@ :playing = not if exit then
	elapsed update-saucer
	check-invasion
	:mode game@ :playing = if check-cleared then ;

\ the cannon's burst plays out; then the next life, or the end
: update-dying ( elapsed -- )
	| elapsed |
	:player game@ elapsed advance-sprite
	elapsed update-saucer
	:timer game@ elapsed - :timer game!
	:timer game@ 0 > if exit then
	settle-effects
	:saucer game@ null? not if 0.22 :wet :delay effect! then
	:lives game@ 0 > if
		place-cannon
		:playing :mode game!
		exit
	then
	:saucer game@ null? not if retire-saucer then
	:score game@ :high game@ max2 :high game!
	:over :mode game!
	4 :timer game!
	queue-over-jingle ;

\ a pause of timer seconds, then the next wave or the title
: update-waiting ( elapsed -- )
	:timer game@ swap - :timer game!
	:timer game@ 0 > if exit then
	:mode game@ :cleared = if
		:level game@ 1+ :level game!
		start-wave
		exit
	then
	enter-title ;

\ the title screen: return starts, the theme repeats
: update-title ( -- )
	:return key-pressed? if start-game exit then
	sequence-end 1 < if queue-theme then ;

\ === drawing ===

\ the score line
: draw-score-line ( -- )
	:white ink
	6 2 "SCORE" print-at
	86 2 "HI-SCORE" print-at
	176 2 "LEVEL" print-at
	6 14 :score game@ "{0:04}" format print-at
	86 14 :high game@ :score game@ max2 "{0:04}" format print-at
	176 14 :level game@ "{0}" format print-at ;

\ the score line, the ground and the spare cannons
: draw-hud ( -- )
	draw-score-line
	:lime ink
	0 238 224 1 fill-rect
	:mode game@ :title = if exit then
	6 242 :lives game@ "{0}" format print-at
	0 :lives game@ 1- 5 min2 1 do k
		cannon-bitmaps 0 @i k 16 * 20 + 244 draw-bitmap
	loop ;

\ the title and the score table, the invaders changing pose twice a second
: draw-title ( -- )
	now 2 * truncate 2 mod to pose
	:white ink
	58 44 "SPACE  INVADERS" print-at
	:red ink
	66 84 "* SCORE TABLE *" print-at
	saucer-lights 0 @i 64 110 draw-bitmap
	squid-poses pose @i 68 130 draw-bitmap
	crab-poses pose @i 67 150 draw-bitmap
	octopus-poses pose @i 66 170 draw-bitmap
	:white ink
	88 108 "= ? MYSTERY" print-at
	88 128 "= 30 POINTS" print-at
	88 148 "= 20 POINTS" print-at
	88 168 "= 10 POINTS" print-at
	now 1.5 * truncate 2 mod 0= if :gold ink 70 200 "PRESS RETURN" print-at then
	:gray ink
	34 216 "ARROWS MOVE  SPACE FIRE" print-at
	42 228 "P PAUSE  ESCAPE QUITS" print-at ;

\ the board: bunkers, invaders, shots, bursts, mothership, cannon, score labels
: draw-board ( -- )
	:bunkers game@ draw-sprites
	:invaders game@ draw-sprites
	:shots game@ draw-sprites
	:bursts game@ draw-sprites
	:player-shot game@ null? not if :player-shot game@ draw-sprite then
	:saucer game@ null? not if :saucer game@ draw-sprite then
	:mode game@ :over = not if :player game@ draw-sprite then
	:red ink
	:labels game@ ( label | label :x @ label :y @ label :text @ print-at ) each ;

\ the banner for a pause, a cleared wave or the end
: draw-banner ( -- )
	:gold ink
	:paused game@ :mode game@ :playing = and if 90 120 "PAUSED" print-at then
	:mode game@ :cleared = if 70 120 "WAVE CLEARED" print-at then
	:mode game@ :over = if :red ink 80 120 "GAME OVER" print-at then ;

\ === the loop ===

\ read the keys and advance the game by elapsed seconds
: advance ( elapsed -- )
	| elapsed |
	:escape key-pressed? if 0 :running game! exit then
	release-due-notes
	:mode game@ to mode
	mode :title = if update-title then
	mode :playing = if elapsed update-playing then
	mode :dying = if elapsed update-dying then
	mode :cleared = mode :over = or if elapsed update-waiting then
	:paused game@ not if elapsed age-effects then ;

\ one 2D screen frame: advance, then draw
: frame ( elapsed -- )
	advance
	cls
	draw-hud
	:mode game@ :title = if draw-title exit then
	draw-board
	draw-banner ;

\ run frame-word ( elapsed -- ) once per screen frame until escape, each
\ advanced by the measured time since the last, at most 1/20 s
: run-frames ( frame-word -- )
	| frame-word |
	enter-title
	now to last
	begin :running game@ while
		now to moment
		moment last - 0.05 min2 to elapsed
		moment to last
		elapsed frame-word screen-frame
	repeat
	silence-audio
	audio-off ;

\ the 2D game
: play ( -- ) ' frame run-frames ;

