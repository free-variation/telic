\ the window's pixels to each of the game's 640×480 on each axis
2 constant window-scale

640 window-scale * 480 window-scale * screen-size

: window-segment ( x0 y0 x1 y1 colour -- )
	| x0 y0 x1 y1 colour |
	colour ink
	x0 window-scale * y0 window-scale * x1 window-scale * y1 window-scale * line ;

: window-span ( x y w h colour -- )
	| x y w h colour |
	colour ink
	x window-scale * y window-scale * w window-scale * h window-scale * fill-rect ;

: window-text ( x y text colour -- )
	| x y text colour |
	colour ink
	window-scale text-scale
	x window-scale * y window-scale * text print-at
	1 text-scale ;

: window-disc ( x y radius colour -- )
	| x y radius colour |
	colour ink
	x window-scale * y window-scale * radius window-scale * fill-circle ;

: window-circle ( x y radius colour -- )
	| x y radius colour |
	colour ink
	x window-scale * y window-scale * radius window-scale * circle ;

' window-segment embodies draw-segment
' window-span embodies fill-span
' window-text embodies draw-text
' window-disc embodies fill-disc
' window-circle embodies draw-circle

: window-face ( x0 y0 x1 y1 x2 y2 colour -- )
	| x0 y0 x1 y1 x2 y2 colour |
	colour ink
	x0 window-scale * y0 window-scale * x1 window-scale * y1 window-scale * x2 window-scale * y2 window-scale * fill-triangle ;

' window-face embodies fill-face

\ run the flight until escape, each frame advanced by the time since the last, at most 1/15 s
: play ( -- )
	| ^scenery-collection |
	build-scenery to scenery-collection
	build-models
	define-sounds
	( audio-on ) catch if drop else settle-sound then
	0 show-title
	now to last
	begin :running game@ while
		now to moment
		moment last - frame-took
		moment last - 1 15 / min2 to elapsed
		moment to last
		elapsed ' frame-with-rate screen-frame
	repeat
	stop-sounds
	( audio-off ) catch if drop then ;

play
