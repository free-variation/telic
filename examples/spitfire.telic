"spitfire/game.telic" load

640 480 screen-size
2 screen-zoom

: window-segment ( x0 y0 x1 y1 colour -- )
	| x0 y0 x1 y1 colour |
	colour ink
	x0 y0 x1 y1 line ;

: window-span ( x y w h colour -- )
	| x y w h colour |
	colour ink
	x y w h fill-rect ;

: window-text ( x y text colour -- )
	| x y text colour |
	colour ink
	x y text print-at ;

: window-disc ( x y radius colour -- )
	| x y radius colour |
	colour ink
	x y radius fill-circle ;

: window-circle ( x y radius colour -- )
	| x y radius colour |
	colour ink
	x y radius circle ;

' window-segment embodies draw-segment
' window-span embodies fill-span
' window-text embodies draw-text
' window-disc embodies fill-disc
' window-circle embodies draw-circle

\ run the flight until escape, each frame advanced by the time since the last, at most 1/15 s
: play ( -- )
	| ^scenery-collection |
	build-scenery to scenery-collection
	build-models
	define-sounds
	( audio-on ) catch if drop else settle-sound then
	0 show-title
	now to last
	begin :running game@ while
		now to moment
		moment last - 1 15 / min2 to elapsed
		moment to last
		elapsed ' frame screen-frame
	repeat
	stop-sounds
	( audio-off ) catch if drop then ;

play
