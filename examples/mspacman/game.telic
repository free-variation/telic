      [ -4 12 ">>>>>>>vvv>>>vvvvvvv>>>>>>>>>vvvvvv<<<" ] [ 228 12 "<<<<<<<vvv<<<vvvvvvvvvvvvv<<<" ] ]
    [ "vvv>>>>>>>>vvv>>>>" "vvvvvv<<<<<^^^<<<<<<<<vvv<<<<" "<<<<<<<^^^^^^^^^^^^^<<<^^^<<<<<<<" "vvv>>>>>^^^^^^^^^^>>>>>^^^^^^<<<<<^^^>>>>>>>" ] ]
