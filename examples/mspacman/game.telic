      [ -4 68 ">>>>^^^^>>>vvvv>>>vvv>>>>>>>>>vvvvvv<<<" ] [ 228 68 "<<<<vvvvvvvvv<<<^^^<<<vvv<<<" ] ]
    [ "<vvv>>>>>>>>>^^^>>>>" "<<<<vvv<<<<<<<<<^^^<<<<" "<<<<<<<^^^^^^<<<<<<^^^<<<<" "<vvv>>>>>>>>>^^^^^^^^^^^^>>>>" ] ]
