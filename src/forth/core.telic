\ aliases
: true ( -- bool ) 1 ; inline
: false ( -- bool ) 0 ; inline
: print ( x -- ) . ; inline
: print-stack ( -- ) .s ; inline

\ load lib/<name> from beside the telic binary; ".telic" added if absent
: load-library ( name -- )
	dup "\.telic$" has? not if ".telic" + then
	binary-dir "/lib/" + swap + load ;

\ type predicates, one per type-of symbol; a bound logic var reports as its value
: float? ( a -- bool ) type-of :float = ; inline
: string? ( a -- bool ) type-of :string = ; inline
: symbol? ( a -- bool ) type-of :symbol = ; inline
: array? ( a -- bool ) type-of :array = ; inline
: set? ( a -- bool ) type-of :set = ; inline
: frame? ( a -- bool ) type-of :frame = ; inline
: matrix? ( a -- bool ) type-of :matrix = ; inline
: quantity? ( a -- bool ) type-of :quantity = ; inline
: exact? ( a -- bool ) type-of :exact = ; inline
: complex? ( a -- bool ) type-of :complex = ; inline
: xt? ( a -- bool ) type-of :xt = ; inline
: continuation? ( a -- bool ) type-of :continuation = ; inline
: stream? ( a -- bool ) type-of :stream = ; inline
: db? ( a -- bool ) type-of :db = ; inline
: ptr? ( a -- bool ) type-of :ptr = ; inline
: segment? ( a -- bool ) type-of :segment = ; inline
: wildcard? ( a -- bool ) type-of :wildcard = ; inline
: lvar? ( a -- bool ) type-of :lvar = ; inline

\ a matrix, or a quantity whose magnitude is a matrix
: matrix-valued? ( v -- f ) dup quantity? if magnitude then matrix? ; inline internal

: 2dup ( a b -- a b a b ) over over ;
inline

: -rot ( a b c -- c a b ) rot rot ;
inline

: tuck ( a b -- b a b ) swap over ;
inline

: 2drop ( a b -- ) drop drop ;
inline

\ prints the top without consuming it
: peek ( val -- val ) dup . ;
inline

\ is tos 1?
: 1= ( val -- bool ) 1 = ; inline

\ truthy: 1 when the value is truthy, the positive twin of 0=
: true? ( a -- bool ) 0= 0= ; inline

\ falsy: 1 when the value is falsy — 0= under a predicate name
: false? ( a -- bool ) 0= ; inline

\ low <= v <= high; element-wise mask on a matrix or
\ array operand, so * is the conjunction, not and (which tests whole values)
: between? ( v low high -- bool ) 2 pick >= -rot >= * ; inline

\ x limited to [low, high]: a float, quantity, or matrix
\ (element-wise, scalar bounds broadcast); an array clamps each element
: clamp ( x low high -- x' )
	| operand lower-bound upper-bound |
	operand array? if operand ( lower-bound upper-bound clamp ) map exit then
	operand lower-bound max2 upper-bound min2 ;

: , ( a -- a ) peek ; inline

\ element 0: an array's first element, a matrix's
\ first row-major element
: first ( arr/matrix -- v )
	dup matrix-valued? if 0 @e exit then
	0 @i ;

\ the final element: an array's, or a matrix's last row-major element
: last ( arr/matrix -- v )
	dup matrix-valued? if dup dim * 1- @e exit then
	dup size 1- @i ;

\ move the value at key old to key new in place; old absent
\ errors, an existing new is overwritten
: rename-key! ( fr old new -- fr )
	| target-frame old-key new-key |
	target-frame target-frame old-key @ new-key ! old-key delete-at ;

\ xt ( key value -- key' value' ) over each entry in key order,
\ the answered pairs collected into a new frame; the source frame is unchanged
: map-frame ( fr xt -- fr )
	| source body |
	source keys to source-keys
	source values to source-values
	[ ] to mapped-keys
	[ ] to mapped-values

	0 source-keys size 1 do i
		depth to entry-depth
		source-keys i @i  source-values i @i  body execute
		depth entry-depth - 2 = not if
			depth entry-depth - 2 -
			"map-frame: quotation must leave exactly two values per entry, but changed the stack by {0}"
			format throw
		then
		to mapped-value  to mapped-key
		mapped-keys mapped-key add-last! drop
		mapped-values mapped-value add-last! drop
	loop

	mapped-keys mapped-values frame ;

\ element 1
: second ( arr -- v ) 1 @i ; inline

\ the value paired with key, the first match by
\ structural equality: entries are [ key value ] arrays (first is the key,
\ second the value); null when the key is absent
: assoc ( entries key -- value )
	| entries key |
	entries ( first key = ) find-first
	dup null? not if second then ;

\ arithmetic words

\ integer quotient toward zero ( = % swap drop )
: quotient ( a b -- quotient ) % swap drop ;
inline

\ run xt, print elapsed CLOCK_MONOTONIC seconds, pass its results through
: timed ( xt -- ... ) now >r execute now r> - . cr ;

\ The identity function
: identity ( val -- val ) ; inline

\ a token running xt1 then xt2, each on the stack the other leaves
: compose ( xt1 xt2 -- xt )
	| first-step second-step |
	( first-step execute second-step execute ) ;

\ one { :name :value :type } frame per global, oldest first
: variables ( -- arr )
	(globals)
	( binding |
	   binding 1 @i to value
	   { :name binding 0 @i :value value :type value type-of } 
	) map ;
