\ logic words
\ (~ is registered in C as a primitive alias of unify, so cons ~ fuses to (cons~))

( v -- val ) \ resolve a logic var to its current binding
: ? deref ;
inline

( list goal -- ) \ run goal with each element of list in turn; commit to the first element for which goal succeeds, fail if none do
: choose
	| list goal |
	list null = if fail exit then
	list head-tail to list-tail to list-head
	list-tail null = if
		list-head goal execute
	else
		list-head goal ' execute 2curry
		list-tail goal ' choose 2curry
		amb
	then ;

( list goal -- arr ) \ goal's value for every element of the cons list it
\ succeeds on, in list order; answers snapshot through copy, and every
\ binding rolls back — choose collects all instead of committing to one
: solutions
	| list goal |
	[ ] to answers
	list
	[: element |
		element goal execute
		answers swap copy add-last! drop
		fail
	:]
	' choose 2curry
	
	' identity amb
	answers ;

( list goal n -- arr ) \ the first n solutions; the goal stops running once
\ n are collected, and bindings roll back as in solutions
: take-solutions
	| list goal n |
	[ ] to answers
	list
	[: element |
		answers size n >= if fail then
		element goal execute
		answers swap copy add-last! drop
		fail
	:]
	' choose 2curry
	
	' identity amb
	answers ;
