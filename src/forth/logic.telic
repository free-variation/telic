\ logic words

\ resolve a logic var to its current binding
: ? ( v -- val ) deref ;
inline

\ choose from element i on: the goal on element i, else
\ the same from i+1; the last element runs without a choice point
: choose-from ( items goal i -- )
	| items goal i |
	i items size >= if fail exit then
	i items size 1- = if
		items i @i goal execute
	else
		items i @i goal ' execute 2curry
		items goal i 1+ ' choose-from 3 ncurry
		amb
	then ; internal

\ run goal with each element of the array in turn; commit to the first element for which goal succeeds, fail if none do
: choose ( items goal -- ) 0 choose-from ;

\ goal's value for every element of the array it
\ succeeds on, in order; answers snapshot through copy, and every
\ binding rolls back — choose collects all instead of committing to one
: solutions ( items goal -- arr )
	| items goal |
	[ ] to answers
	items
	( element |
		element goal execute
		answers swap copy add-last! drop
		fail
	)
	' choose 2curry
	
	' identity amb
	answers ;

\ the first n solutions; the goal stops running once
\ n are collected, and bindings roll back as in solutions
: take-solutions ( items goal n -- arr )
	| items goal n |
	[ ] to answers
	items
	( element |
		answers size n >= if fail then
		element goal execute
		answers swap copy add-last! drop
		fail
	)
	' choose 2curry
	
	' identity amb
	answers ;
