\ Test vocabulary: expect assertions and a test runner, over catch/throw.
\ assert is taken (logic fact assertion), so the assertion word is expect.
\ A passing expect is silent; a failing one throws a message the enclosing
\ test turns into a FAIL line.

variable tests-passed internal
variable tests-failed internal

( flag -- ) \ pass silently when flag is truthy, else throw
: expect 
	not if "expectation was false" throw then ;

( actual expected -- ) \ deep equality via =; on mismatch throw "expected X, got Y"
: expect=
	2dup = not if
		render swap render
		"expected {1}, got {0}" format throw
	then 2drop ;

( actual expected tolerance -- ) \ pass when |actual - expected| <= tolerance; for matrix or
\ vector operands, when the largest element-wise absolute difference is within tolerance
: expect-near
	|> actual expected tolerance |
	actual expected - abs dup matrix? if max then tolerance <= not if
		actual render expected render tolerance render
		"expected {1} +/- {0}, got {2}" format throw
	then ;

( xt -- ) \ pass iff the quotation throws
: expect-throws
	catch if drop
	else
		"expected a throw" throw 
	then ;

( exception -- s ) \ a thrown value as a one-line reason: a runtime's error's :message else its render
: expect-reason
	dup frame? if
		dup :message has? if :message @ else render then
	else
		render 
	then ; internal

( baseline -- ) \ drop data-stack entries above baseline
: reset-depth
	|> baseline |
	begin depth baseline > while drop repeat ; internal

( name xt -- ) \ run xt under catch; print ok/FAIL, count it, restore the stack, continue past a failure
: test
	| >name >xt baseline reason |
	depth to baseline

	xt catch if
		expect-reason to reason
		baseline reset-depth
		name render reason "FAIL {1}: {0}" format print cr
		++ tests-failed
	else
		baseline reset-depth
		name render "ok {0}" format print cr
		++ tests-passed
	then ;

( -- ) \ print the tally ; throw when any failed so a program-file run exits non-zero
: test-report
	tests-passed tests-failed "{1} passed, {0} failed" format print cr
	tests-failed 0 > if "test failures" throw then ;


