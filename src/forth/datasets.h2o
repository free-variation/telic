\ datasets: rows, column frames, relations, resampling

( rows header? -- keys start) \ keys from row 0, or synthesized :col1 ..; start = first data-row index
: tsv-keys
	| >rows >header? keys |

	header? if
		rows 0 @i [: string>symbol :] map to keys
		keys 1
	else
		rows 0 @i size 1 swap range [: "col{0}" format string>symbol :] map to keys
		keys 0
	then ; internal

( cells -- column ) \ vector when uniformly numeric (none -> NaN) or one-unit quantities
: column-from-cells
	|> cells |
	cells size 0= if
		cells exit
	then

	cells [: dup float? swap none? or :] all? if
		cells vector exit
	then

	cells ' quantity? all? if
		cells ' unit-of map
		array>set size 1= if
			cells ' magnitude
			map vector
			cells 0 @i unit-of *
			exit
		then
	then

	cells ; internal

( rows header? -- dataset) \ column frame, each column typed by column-from-cells:
\ uniformly numeric cells become an nx1 vector (none -> NaN), else the cell array
: rows>dataset
	| >rows >header? keys start n-rows |

	rows size 0= if { } exit then

	rows header? tsv-keys to start to keys
	rows size start - to n-rows

	keys
	n-rows 0= if
		keys size iota [: drop [ ] :] map
	else
		rows  start rows size 1- range select-rows  transpose
		' column-from-cells map
	then
	frame ;

( path -- dataset ) \ a TSV file with a header row as a dataset (typed columns)
: read-tsv load-tsv true rows>dataset ; inline

( rows index-cols header? -- relation ) \ rows to deduped relation, indexed on index-cols
: rows>relation
	| >rows >index-cols >header? keys start n-rows row-indices row-frames |

	rows size 0= if index-cols relation exit then

	rows header? tsv-keys to start to keys
	rows size start - to n-rows
	n-rows 0= if [ ] else start rows size 1- range then to row-indices

	keys  rows row-indices select-rows  [: 2 pick swap frame :] map  nip to row-frames
	index-cols  row-frames
	[: 2 pick swap [: [: string>symbol :] update-at :] reduce :] map  nip to row-frames

	index-cols relation row-frames bulk-load ;

( dataset cols -- matrix ) \ K numeric columns -> NxK matrix, observations are rows;
\ a column may be an array, an n x 1 vector, or a dimensioned vector (magnitude taken)
\ the dataset arrives below cols, so the quotation reaches it at depth 2 under map
: dataset>matrix
	[: 2 pick swap @ magnitude dup matrix? if as-column else vector then :] map  nip
	dup 0 @i swap 1 skip swap
	' augment reduce ;

( n -- [indices] ) \ row indices drawn from [0, n) with replacement
: resample-indices
	| >n |
	n iota n true sample ;

( arr -- arr ) \ new array, elements uniformly permuted; input untouched
: shuffle  dup size false sample ;

( array/set -- array ) \ same-size draw with replacement
: resample
	dup size true sample ;

( v -- bool ) \ matrix-represented column, dimensioned included
: numeric-column?  dup matrix? swap quantity? or ; internal

( column -- arr ) \ a column in any representation as an array of its values
: column>array
	dup numeric-column? if matrix>array then ; 

( column -- set ) \ the set of the column's distinct values
: column>set
	column>array array>set ;

( dataset -- rows ) \ the inverse of true rows>dataset: row-arrays led by a header
\ row of the column names, columns in key order, cells through column>array
: dataset>rows
	| >dataset |
	dataset keys dup size 0= if drop [ ] exit then

	[: "{0}" format :] map 1 array
	dataset values ' column>array map transpose
	concat ;

( dataset path -- ) \ write a dataset as a TSV with a header row; read-tsv's inverse
: write-tsv swap dataset>rows swap save-tsv ; inline

\ The C select-rows gathers rows of a matrix and elements of an array, by an index
\ array or an index vector; only the dataset case is added here.
' select-rows constant (matrix-select-rows) internal

( dataset indices -- dataset ) \ every column gathered by the same row indices
\ dataset and indices are parked below the key array the map peeks, so the
\ quotation reaches them at depths 3 and 2
: dataset-select-rows
	| >dataset >indices column-names |
	dataset keys to column-names

	dataset indices column-names
	[: 3 pick swap @  2 pick (matrix-select-rows) execute :] map
	nip nip

	column-names swap frame ; internal

( dataset/matrix/arr indices -- same )
: select-rows
	over frame? if dataset-select-rows exit then
	(matrix-select-rows) execute ;

' dim constant (matrix-dim) internal 

( dataset -- rows columns ) \ rows from the first columns length, columns from key count
: dataset-dim 
	| >dataset n-columns |
	dataset keys size to n-columns
	n-columns 0= if 0 0 exit then
	dataset dup keys 0 @i @ size n-columns ; internal

( dataset/matrix -- rows columns ) \ dimensions of a matrix or dataset
: dim
	dup frame? if 
		dataset-dim
	else
		(matrix-dim) execute
	then ;

( dataset sym -- sym ) \ the named colum's type from its representation
: column-type
	@ dup matrix? if
		drop :numeric exit
	then
	
	dup quantity? if
		unit-of 1 s = if 
			:datetime
		else
			:quantity
		then
	else
		drop :text
	then ;

( dataset columns -- dataset ) \ the named columns as a new dataset
\ the dataset arrives below the column array, so the quotation reaches it at depth 3
\ under map, with the array present twice — once as the map source, once as the keys
: select-columns
	dup [: 3 pick swap @ :] map
	rot drop frame ;

( pairs value -- pairs ) \ extend the last run when the value repeats, else start one
: extend-run
	| >pairs >value last |
	pairs pairs size 1- @i to last
	last 0 @i value = if
		last 1  last 1 @i 1+  !i drop
	else
		pairs [ value 1 ] add-last! drop
	then
	pairs ; internal

( sorted -- pairs ) \ [ value n-values ] runs over a val_cmp-sorted array
\ the run being counted is the last pair, so the fold needs no state of its own
: value-runs
	| >sorted |
	sorted size 0= if [ ] exit then

	sorted 1 skip
	[ sorted 0 @i 1 ] 1 array
	' extend-run reduce ; internal

( column -- arr ) \ [ value [indices] ] per distinct value, in value order
( state run -- state ) \ state is [ pairs offset permutation ]: the run's indices are
\ the next run-length of the permutation, and the offset advances past them
: take-run
	| >state >run pairs offset permutation length indices |
	state 0 @i to pairs
	state 1 @i to offset
	state 2 @i to permutation
	run 1 @i to length

	null length array-of to indices
	indices 0  permutation offset 1 length  slice! drop
	pairs [ run 0 @i indices ] add-last! drop

	[ pairs  offset length +  permutation ] ; internal

: group-indices
	| >column permutation |
	column column>array to column
	column argsort to permutation

	column permutation (matrix-select-rows) execute value-runs
	[ [ ] 0 permutation ] ' take-run reduce
	0 @i ;

( dataset -- rows ) \ each row as a frame keyed by column name
\ the column names are parked below the transposed rows, so the quotation keying
\ each row reaches them at depth 2 under map
: dataset-rows
	| >dataset column-names |
	dataset keys to column-names
	column-names size 0= if [ ] exit then

	column-names
	dataset values ' column>array map transpose
	[: 2 pick swap frame :] map
	nip ; internal

( array/vector/dataset -- pairs ) \ occurrences of distinct values (dataset: whole rows), most frequent first
: count
	dup frame? if 
		dataset-rows
	else
		column>array
	then

	sort value-runs
	[: 1 @i negate :] sort-by ;

' filter constant (array-filter) internal

( dataset xt -- dataset) \ keep the rows whose filter satisfies xt ( row -- bool)
: dataset-filter
	|> dataset predicate |
	dataset dataset-rows 
	predicate map vector
	where
	dataset swap select-rows ; internal

( array/set/dataset xt -- same ) \ keep elements or rows satisfying xt
: filter
	over frame? if 
		dataset-filter 
	else
		(array-filter) execute
	then ;

( rows -- dataset ) \ uniform-key row frames as a dataset, keys from row 0
: frames>dataset
	| >rows |
	rows size 0= if { } exit then

	rows ' keys map array>set size 1= not if
		"rows have differing keys" throw
	then

	\ keys and values agree in order, so the columns are the transpose of the rows
	rows 0 @i keys
	rows ' values map transpose ' column-from-cells map
	frame ;

' map constant (array-map) internal

( dataset xt -- dataset ) \ xt maps each row frame to a new row frame
: dataset-map
	swap dataset-rows
	swap (array-map) execute
	frames>dataset ; internal

( array/set/dataset xt -- same ) \ map xt over elements, or over each dataset row frame
: map
	over frame? if
		dataset-map
	else
		(array-map) execute
	then ;

( dataset/matrix -- n ) \ number of rows
: n-rows dim drop ;

( dataset/matrix -- n ) \ number of columns
: n-columns dim nip ;

( dataset sym pred replacement -- ) \ replaces the column's cells passing pred, in place
\ read, mesh, store back — what update-at did, without a quotation reaching outward
: replace-where
	|> dataset column-name predicate replacement |
	dataset column-name
	dataset column-name @  dup predicate execute  replacement mesh
	! drop ;


( dataset key -- strings right? ) \ header + rendered cells; numeric columns align right
: column-cells
	| >dataset >key column-kind |
	dataset key column-type to column-kind
	dataset key @ column>array
	column-kind :datetime = if [: time>iso :] map else [: render :] map then
	[ key "{0}" format ] swap concat
	column-kind :text = not ; internal

( dataset leading-columns -- columns ) \ the leading columns first in the given order, then the remaining columns alphabetical by name; empty leading-columns orders all columns alphabetically
: ordered-columns
	| >dataset >leading-columns |
	leading-columns
	dataset keys array>set  leading-columns array>set  difference  set>array
	[: "{0}" format :] sort-by
	concat ; internal

( dataset key -- strings ) \ header and cells of one column, each padded to the widest
\ the width and the alignment flag are parked below the string array the map peeks
: padded-column
	| >dataset >key strings right? width |
	dataset key column-cells to right? to strings
	strings [: size :] map 0 ' max2 reduce to width

	width right? strings
	[: 3 pick 3 pick if pad-left else pad-right then :] map
	nip nip ; internal

( dataset n leading-columns -- ) \ print the first n rows as an aligned table; leading columns appear first in the given order, the rest alphabetical by name; empty leading-columns orders all columns alphabetically
\ the dataset is parked below the key array, and the padded columns below the row loop
: headn
	| >dataset >n >leading-columns columns ordered |
	dataset keys size 0= if exit then
	dataset n-rows n min2 to n
	dataset n iota select-rows to dataset
	dataset leading-columns ordered-columns to ordered

	dataset ordered [: 2 pick swap padded-column :] map nip to columns

	columns
	[: over [: 2 pick @i :] map "  " join . cr drop :]
	n 1+ i-times
	drop ;

( dataset -- ) \ print the first 10 rows as an aligned table
: head 10 [ ] headn ;
