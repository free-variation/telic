\ subprocess convenience

\ write the string to the child's stdin
: write-in ( string proc -- ) :in @ write ;

\ read all of the child's stdout
: read-out ( proc -- string ) :out @ read ;

\ read all of the child's stderr
: read-err ( proc -- string ) :err @ read ;

\ start a process from an argv string
: run ( string -- proc ) " +" split start-process ;

\ close a process's streams and reap it (graceful — waits for exit); the teardown mirror of start-process
: end-process ( proc -- )
	dup :in @ close
	dup :out @ close
	dup :err @ close
	:pid @ wait drop ;

\ run one argv array to completion; return { :out :err :status }; closes all streams and reaps (the singular of parallel-run)
: run-result ( argv -- result )
	start-process to proc
	{ :out proc read-out :err proc read-err :status proc :pid @ wait } to result
	proc :in @ close
	proc :out @ close
	proc :err @ close
	result ;

\ run each argv array in commands as a subprocess,
\ at most width at a time; collect { :out :err :status } per command in input
\ order, refilling a slot as soon as its child finishes (as-completed).
: parallel-run ( commands width -- results )
  | commands width |
  commands size to command-count
  width 1 < if 1 to width then
  width command-count < if width else command-count then to slot-count
  null command-count array-of to results
  null slot-count array-of to slotprocs
  0 slot-count array-of to slot-commands
  0 slot-count 1 do slot
    commands slot @i start-process to proc
    slotprocs proc slot !i drop
    slot-commands slot slot !i drop
  loop
  slot-count to next-command
  0 to completed-count
  begin completed-count command-count < while
    0 slot-count 1 do slot
      slotprocs slot @i to proc
      proc null = not if
        proc :pid @ running? not if
          slot-commands slot @i to command-index
          results { :out proc read-out :err proc read-err :status proc :pid @ wait } command-index !i drop
          completed-count 1 + to completed-count
          next-command command-count < if
            commands next-command @i start-process to proc
            slotprocs proc slot !i drop
            slot-commands next-command slot !i drop
            next-command 1 + to next-command
          else
            slotprocs null slot !i drop
          then
        then
      then
    loop
    0.005 sleep
  repeat
  results ;

: pmap ( array xt -- image ) >r num-cores 1 r> pmap-ext ;

: pfilter ( array predicate -- image ) >r num-cores 1 r> pfilter-ext ;

: pmap-reduce ( array identity map-xt combine-xt -- result ) >r >r >r num-cores 1 r> r> r> pmap-reduce-ext ;
