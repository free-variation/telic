\ string words

\ codepoint index of pat's first regex match in s, -1 if none
: index-of ( s pat -- i | -1 ) 2dup has? if split 0 @i size else 2drop -1 then ;

\ escape XML text and single-quoted attribute content
: xml-escape ( s -- s' )
	"&" "\&amp;" replace
	"<" "\&lt;" replace
	">" "\&gt;" replace
	"'" "\&apos;" replace ;

\ the path's last component
: basename ( path -- filename ) "^.*/" "" replace ; inline

\ a string of k spaces
: spaces ( k -- s ) " " swap array-of "" join ;

\ s left-padded with spaces to width
: pad-left ( s width -- s' )
	| text width |
	[ width text size - 0 max2 spaces text ] "" join ;

\ s right-padded with spaces to width
: pad-right ( s width -- s' )
	| text width |
	[ text width text size - 0 max2 spaces ] "" join ;
