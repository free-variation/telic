\ array words

\ the last n elements (n clamped to [0, length]);
\ a matrix answers its last n row-major elements as an nx1 vector
: nlast ( arr/matrix n -- arr'/vector )
	| source n |
	source quantity? if
		source magnitude n nlast source unit-of * exit
	then
	source matrix? if
		source dim * to n-elements
		n 0 n-elements clamp to n
		source n-elements 1 reshape n-elements n - n-elements 0 1 submatrix exit
	then
	source reverse n take reverse ;

\ all but the first n elements (clamped)
: skip ( arr n -- arr' ) over size swap - swap reverse swap take reverse ;

\ empty when n <= 0
: iota ( n -- [0..n-1] ) dup 0 <= if drop [ ] else 1- 0 swap range then ;

\ sum of xt ( i -- term ) over i in 0..n-1
: sum-times ( xt n -- total )
  | xt n |
  0 xt ' f+ n fold-times ;

\ product of xt ( i -- term ) over i in 0..n-1
: product-times ( xt n -- product )
  | xt n |
  1 xt ' f* n fold-times ;

\ does any element satisfy pred?
: any? ( items pred -- flag ) find-first null? not ;
inline

\ do all elements satisfy pred?
: all? ( items pred -- flag ) map 1 ' * reduce ;

\ one dimension: an array with every nested array spliced
\ in, recursively (a flat array answers itself); a matrix as a 1x(r*c) row
: flatten ( arr/mat -- arr/mat )
	dup array? if (flatten-array) exit then
	dup matrix? over quantity? or not if
		type-of "expected an array or matrix; got {0}" format throw
	then
	dup dim * 1 swap reshape ;

\ xt maps an element to an array; results concatenated
: flat-map ( items xt -- items' ) map flatten ;
inline


\ the set's elements as an array, already in val_cmp order
: set>array ( set -- arr ) sort ;
inline

\ sorted by the key xt ( element -- key ) extracts
\ the token a sort key stands for: a symbol reads that field from each
\ element, an xt already computes one
: key-xt ( key -- xt )
	dup symbol? if ' @ curry exit then
	dup xt? not if
		type-of "expected a symbol or execution token key; got {0}" format throw
	then ; internal

: (sort-by-key) ( items xt -- items' ) over swap map argsort select-rows ; internal

\ sorted by a key: a symbol names a field of each element frame, an xt
\ ( element -- key ) computes one, and an array of either sorts by each in
\ turn with the first key primary — argsort keeps the order of equal keys, so
\ the passes run from the last key backwards
: sort-by ( items key -- items' )
	| items key |
	key array? not if items key key-xt (sort-by-key) exit then

	key size 1- -1 -1 do k
		items key k @i key-xt (sort-by-key) to items
	loop
	items ;

\ elements satisfying pred, and the others
: partition ( items pred -- matches rest ) 
	2dup filter 
	-rot ( execute not ) curry 
	filter ;

\ group elements into { sym -> set }: a symbol key names the
\ field read from each element frame (one sorted pass in C); an xt key
\ ( element -- sym ) computes each element's group symbol
: group-by ( items key -- frame )
	dup symbol? if (group-by) exit then
	dup xt? not if
		type-of "expected a symbol or execution token key; got {0}" format throw
	then
	>side
	{ }
	(
		over over side-peek execute
		2dup has? not if 2dup [< >] swap ! drop then
		@ swap set-add! drop
	) reduce
	side-drop ;
