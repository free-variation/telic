\ matrix words

\ constructs a nx1 matrix from an array
: vector ( arr -- matrix ) dup size 1 matrix ; inline

\ dot product of two vectors
: dot ( v1 v2 -- float ) * sum ; inline

: identity-matrix ( s -- sxs-identity-matrix ) 1 swap diagonal-matrix ;

\ rows times columns
: num-elements ( m -- n ) dim * ; inline

\ mean of the non-NaN elements
: mean ( m -- mean )
	dup nonmissing-count dup 0= if "all elements are NaN (missing)" throw then
	swap sum swap / ;

\ each row's sum divided by the number of columns
: row-means ( m -- row-means ) dup dim swap drop swap row-sums swap / ;

\ each column's sum divided by the number of rows
: column-means ( m -- column-means ) dup dim drop swap column-sums swap / ;

\ v[i+1] - v[i] as an (n-1)x1 vector; one element answers 0x1
: successive-differences ( v -- differences )
	| values |
	values dim to n-columns to n-values
	n-columns 1 = not if
		n-values n-columns "expected a column vector (nx1); got {1}x{0}" format throw
	then
	values 1 n-values 0 1 submatrix
	values 0 n-values 1- 0 1 submatrix - ;

\ column-wise concatenation: vstack's twin, augment's numpy name
: hstack ( a b -- m ) augment ; inline

\ any vector shape as nx1
: as-column ( v -- v' ) dup dim * 1 reshape ; inline

\ the finite elements of a vector, NaNs dropped
: drop-nans ( v -- v' ) dup nan? 0 eq where select-rows ; inline

\ frobenius-norm under the short name
: norm ( m -- f ) frobenius-norm ; inline
