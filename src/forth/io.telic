\ filesystem and environment helpers

\ write a value to a file in Telic's binary value format
: save-value ( value path -- ) swap value>bytes swap write-file ;

\ read a value written by save-value
: load-value ( path -- value ) read-file bytes>value ;

\ { :kind :size :modified } with :modified an instant;
\ null when the path does not exist
: file-info ( path -- fr|null )
	| path |
	path (file-info) to info
	info null? if info exit then

	info@modified s info!modified
	info ;

\ copy a file's bytes; errors unless from is a regular file
: copy-file ( from to -- )
	| source target |
	source file-info to info
	info null? if source "cannot copy {0}: no such file" format throw then
	info@kind :file = 0= if source "cannot copy {0}: not a file" format throw then

	source read-file target write-file ;

\ unix names for the filesystem words, for hands that type them

\ make-directory
: mkdir ( path -- ) make-directory ; inline

\ delete-file
: rm ( path -- ) delete-file ; inline

\ delete-directory
: rmdir ( path -- ) delete-directory ; inline

\ rename-file
: mv ( from to -- ) rename-file ; inline

\ print the working directory, cwd's printing counterpart
: pwd ( -- ) cwd stdout write cr ; inline

\ write a file's bytes to stdout, read-file's printing counterpart
: cat ( path -- ) read-file stdout write ; inline

\ copy-file
: cp ( from to -- ) copy-file ; inline

\ touch-file
: touch ( path -- ) touch-file ; inline

\ absolute path of name on $PATH, or null if not found
: find-executable ( name -- path|null )
	| name |
	name "/" has? if null exit then
	"PATH" env dup null? if 
		drop null exit 
	then

	name swap ":" split
	( "/" + 2 pick + ) map nip
	' file-exists? find-first ;

\ the log file: TELIC_LOG_FILE, else derived from TELIC_LOG_DIR
\ at first use and stored there; null means stderr
: log-destination ( -- path|null )
	"TELIC_LOG_FILE" env dup null? not if exit then drop
	"TELIC_LOG_DIR" env dup null? if exit then to log-dir

	log-dir make-directory
	log-dir "/telic-log-" + wall-now "%Y-%m-%dT%H-%M-%SZ" format-time +
	dup "TELIC_LOG_FILE" env! ; internal

\ one line, <iso time> <level> <message>, to the log file or stderr
: log ( str level -- ) | message level |
	wall-now time>iso level message "{2} {1} {0}{nl}" format
	log-destination dup null? if drop stderr write exit then
	append-file ;
