\ :real for a vector column or all-float cells, else :text
: column-sql-type ( column -- sym )
	dup matrix? if drop :real exit then
	( null? not ) filter
	dup size 0= if drop :text exit then
	' float? all? if :real else :text then ; internal

\ sql identifier: embedded quotes doubled, wrapped in quotes
: sql-identifier ( name -- quoted )
	"""" """""" replace
	"""{0}""" format ; internal

\ is a declared sql type date-like?
: declared-instant? ( declaration -- flag )
	dup null? if drop false else "(?i)date|time" has? then ; internal

\ is a declared sql type numeric?
: declared-numeric? ( declaration -- flag )
	dup null? if drop false else "(?i)int|real|floa|doub|num" has? then ; internal

\ an epoch vector takes s directly; ISO text parses per cell
: column>instants ( column -- instants )
	dup matrix? if s exit then
	( dup null? if else iso>time 1 s / then ) map vector s ; internal

\ typed columns: numeric -> n x 1 vector (NaN for
\ NULL), declared date/time -> instant vector in s, text -> array; an empty
\ column declared numeric stays typed as an empty vector
: db-query ( db query params -- dataset )
	(db-query) to types to dataset

	dataset keys
	dataset values types values
	( column declaration |
		declaration declared-instant? if column column>instants exit then

		column array? column size 0= and declaration declared-numeric? and if
			[ ] vector
		else
			column
		then 
	) 2 nmap
	frame ;

: create-table-statement ( names types table -- statement )
	>r
	( name type | name sql-identifier type :real = if " REAL" else " TEXT" then + ) 2 nmap
	", " join

	r> sql-identifier "CREATE TABLE {0} ({1})" format ; internal

: insert-statement ( n-columns table -- statement )
	sql-identifier swap
	"?" swap array-of ", " join
	"INSERT INTO {1} VALUES ({0})" format ; internal

\ COUNT(DISTINCT) over the loaded column; empty cells don't count.
: column-distinct-count ( db table col-name -- num-distinct )
	sql-identifier swap sql-identifier

	"SELECT COUNT(DISTINCT {1}) AS ""distinct-count"" FROM {0}" format
	[ ] db-query :distinct-count @ 0 @e ; internal

\ the row's cells as the statement's parameters
: insert-row ( row db statement -- n ) rot db-exec ; internal

\ one column's entry in the import report
\ the context trails the mapped values, so ncurry can bind it
: column-info ( name type dataset db table -- info )
	| name type dataset db table |
	type :real = if
		{ :name name string>symbol
		  :type type
		  :summary dataset name string>symbol @ summary 
		} exit
	then

	{ :name name string>symbol
	  :type type
	  :distinct db table name column-distinct-count 
	} ; internal

\ imports a tsv. header row names the columns, types inferred by column
\ the dataset, connection and table name are parked below the combinators' sources
: tsv>db ( tsv-path db table -- info )
	| tsv-path db table |
	tsv-path load-tsv to rows
	rows size 0= if tsv-path "tsv>db: {0} has no header row" format throw then

	rows 0 @i to names
	rows ' size map array>set size 1= not if
		tsv-path "tsv>db: ragged rows in {0}" format throw
	then

	rows true rows>dataset to dataset
	dataset names ( string>symbol 2 pick swap @ column-sql-type ) map nip to types
	db names types table create-table-statement [ ] db-exec drop

	names size table insert-statement to statement
	db "BEGIN" [ ] db-exec drop
	rows 1 skip db statement ' insert-row 2 ncurry map drop
	db "COMMIT" [ ] db-exec drop

	names types dataset db table ' column-info 3 ncurry 2 nmap to columns

	{ :n-rows rows size 1-
	  :columns columns 
	} ;
	
