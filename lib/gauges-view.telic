\ A live view of another telic's gauges. That REPL loads this library and runs
\ `"path" publish-gauges`; thereafter its after-entry hook writes the gauges
\ frame to the path after every entry. A second telic in its own terminal runs
\ `"path" gauges-view`, which redraws the six-row table print-gauges prints
\ every half second from the latest file, with the age of the sample in the
\ footer. Rates compare consecutive published samples, so they describe the
\ REPL's work between two entries. Each cycle erases the screen and redraws
\ from the top, which is what a resize or a Ctrl-L needs; Ctrl-C ends the
\ viewer.

( -- path|null ) \ where entries publish their gauges; null when not publishing
variable gauges-publication internal
null to gauges-publication

( -- ) \ write the gauges, stamped with the monotonic and wall clocks, to the
\ publication path; nothing when not publishing
: publish-gauges-entry
	gauges-publication null? if exit then
	gauges now :sampled-at ! wall-now :published-at !
	gauges-publication save-value ; internal

' publish-gauges-entry embodies after-entry
' publish-gauges-entry embodies on-tick

( path -- ) \ publish the gauges to path after every REPL entry and every second
\ while an entry runs, for a gauges-view in another terminal; unpublish-gauges
\ stops it
: publish-gauges | ^gauges-publication | to gauges-publication 1 tick-every ;

( -- ) \ stop publishing the gauges
: unpublish-gauges | ^gauges-publication | null to gauges-publication 0 tick-every ;

( str -- ) \ the string's bytes, then a newline
: gauges-view-line string>codepoints ' emit each cr ; internal

( -- ) \ cursor home, screen erased
: gauges-view-clear 27 emit "[H" string>codepoints ' emit each 27 emit "[2J" string>codepoints ' emit each ; internal

( -- f|null ) \ the :sampled-at of the frame last drawn, so an unchanged file is
\ not drawn again (a repeated sample would read as a zero interval)
variable gauges-view-drawn internal
null to gauges-view-drawn

( path -- ) \ one redraw of the view: screen erased, then the table from the
\ published gauges at path and the sample's age, or a waiting line while the
\ file does not exist yet; a file holding the sample already drawn is skipped
: gauges-view-once
	| path ^gauges-view-drawn |
	path file-exists? not if
		gauges-view-clear path "waiting for {0}" format gauges-view-line exit
	then
	path load-value to published
	published :sampled-at @ gauges-view-drawn = if exit then
	published :sampled-at @ to gauges-view-drawn

	gauges-view-clear
	published gauges>rows ' gauges-view-line each
	wall-now published :published-at @ - 1 s / "{dim}sampled {0:.0f} s ago{plain}" format gauges-view-line ;

( path -- ) \ redraw the published gauges at path every half second until interrupted
: gauges-view
	| path |
	begin path gauges-view-once 0.5 sleep again ;
