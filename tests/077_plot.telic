\ lib/plot.telic: SVG plotting. Marks accumulate as data- or pixel-space frames;
\ figure>svg resolves the domain (pinned or padded auto-extent) into one affine
\ per axis and renders. Style comes from aes defaults, figure! overrides.
"lib/plot.telic" load

\ === full document: two points, auto domain, axes ===
320 240 figure
2 :ticks figure!
axes
[ 0 10 ] vector [ 0 10 ] vector scatter
figure>svg .
clear

\ === scatter: NaN points are skipped ===
640 480 figure
[ -1 1 4 ] vector ln [ 1 2 3 ] vector scatter
figure>svg "circle" split size 1 - . cr                      \ 2
clear

\ === deferred mapping: pin the domain after drawing; the point moves ===
640 480 figure
[ 5 ] vector [ 5 ] vector scatter
figure>svg "cx='320' cy='240'" has? . cr                     \ 1 (auto: centered)
0 :xmin figure! 10 :xmax figure! 0 :ymin figure! 10 :ymax figure!
figure>svg "cx='320' cy='240'" has? . cr                     \ 1 (5 = mid of [0,10])
0 :xmin figure! 20 :xmax figure!
figure>svg "cx='180' cy='240'" has? . cr                     \ 1 (5 = quarter of [0,20])
clear

\ === histogram: [1 1 2 3] in 2 bins -> counts [2 2], domain [1,3]x[0,2] ===
640 480 figure
[ 1 1 2 3 ] vector 2 histogram
figure>svg
dup "rect" split size 2 - . cr                               \ 2 (two bars, besides the canvas rect)
dup "x='40' y='40' width='280' height='400'" has? . cr       \ 1 (first bar)
"x='320' y='40' width='280' height='400'" has? . cr          \ 1 (second bar)
clear

\ === histogram: constant data takes the range value +/- 1 ===
[ 5 5 5 ] vector 4 histogram-plot "rect" split size 3 - . cr \ 4 (bars, besides border and canvas)
clear

\ === barchart: heights drawn in input order (not sorted), baseline y=0, one label per bar ===
640 480 figure
[ 3 1 2 ] vector [ "a" "b" "c" ] barchart
:parts figure@ [: :kind @ :rect = :] filter [: :ys @ 1 @e :] map .a cr    \ [ 3 1 2 ]
:parts figure@ [: :kind @ :text = :] filter [: :label @ :] map .a cr      \ [ "a" "b" "c" ]
:xmin figure@ . :xmax figure@ . :ymin figure@ . cr                        \ 0.5 3.5 0
:x-categorical figure@ . cr                                               \ 1 (barchart marks x categorical, so axes/panel drop the numeric x-ticks)
figure>svg "<rect" split size 1 - . cr                                    \ 4 (3 bars + canvas)
clear

\ === count-barchart: frequencies from raw values, most frequent first ===
640 480 figure
[ "north" "south" "north" "north" "west" ] count-barchart
:parts figure@ [: :kind @ :rect = :] filter [: :ys @ 1 @e :] map .a cr    \ [ 3 1 1 ]
:parts figure@ [: :kind @ :text = :] filter [: :label @ :] map .a cr      \ [ "north" "south" "west" ]
clear

\ === complete bar charts render bars, a border, and the canvas ===
[ 3 1 2 ] vector [ "a" "b" "c" ] barchart-plot "<rect" split size 1 - . cr    \ 5 (3 bars + border + canvas)
clear
[ "north" "south" "north" ] count-barchart-plot "<rect" split size 1 - . cr   \ 4 (2 bars + border + canvas)
clear

\ === stacked-barchart: rows are categories (bars), columns are series (segments from y=0) ===
640 480 figure
[ 3 1 2 4 ] vector 2 2 reshape [ "A" "B" ] [ "steelblue" "orange" ] stacked-barchart
\ [bottom top] per segment, row-major (A:s0, A:s1, B:s0, B:s1) — cumulative within each bar
:parts figure@ [: :kind @ :rect = :] filter [: :ys @ matrix>array :] map .a cr   \ [ [ 0 3 ] [ 3 4 ] [ 0 2 ] [ 2 6 ] ]
:parts figure@ [: :kind @ :rect = :] filter [: :fill @ :] map .a cr              \ [ "steelblue" "orange" "steelblue" "orange" ]
:xmin figure@ . :xmax figure@ . :ymin figure@ . cr                               \ 0.5 2.5 0
figure>svg
dup ">A</text>" has? . cr                                                        \ 1
dup ">B</text>" has? . cr                                                        \ 1
"<rect" split size 1 - . cr                                                      \ 5 (4 segments + canvas)
clear

\ === rect-at: a rectangle in data coordinates, mapped through the domain, current fill ===
640 480 figure
0 :xmin figure! 10 :xmax figure! 0 :ymin figure! 10 :ymax figure!
"tomato" fill
0 0 5 5 rect-at
figure>svg
dup "x='40' y='240' width='280' height='200'" has? . cr     \ 1 (data corners through the affine)
"fill='tomato'" has? . cr                                    \ 1 (current fill)
clear

\ === y-categories: names along the y axis at 1..n, no numeric y-ticks; pins y to [0.5,n+0.5] ===
640 480 figure
0 :xmin figure! 10 :xmax figure!
[ "apples" "pears" "figs" ] y-categories
:ymin figure@ . :ymax figure@ . cr             \ 0.5 3.5
figure>svg
dup ">apples</text>" has? . cr                 \ 1
dup ">figs</text>" has? . cr                   \ 1
dup "x='32'" has? . cr                         \ 1 (left of the axis, margin - 8)
"text-anchor='end'" split size 1 - . cr        \ 3 (three right-anchored labels)
clear

\ === y-categories composes with axes: numeric y-ticks suppress, names remain, no collision ===
640 480 figure
0 :xmin figure! 10 :xmax figure!
[ "a" "b" "c" ] y-categories
axes
figure>svg
dup ">a</text>" has? . cr                      \ 1 (category name kept)
">3</text>" has? . cr                          \ 0 (numeric y-tick 3 suppressed; x-ticks step by 2)
clear

\ === boxplot: [1 2 3 4 100] -> fences [-1,7], one outlier, whiskers 1 and 4 ===
640 480 figure
[ 1 2 3 4 100 ] vector boxplot
figure>svg
dup "circle" split size 1 - . cr                             \ 1 (the outlier)
dup "rect" split size 2 - . cr                               \ 1 (the box, besides the canvas rect)
"line" split size 1 - . cr                                   \ 3 (median + 2 whiskers)
clear

\ === series: a NaN gap splits the polyline; 1-point runs draw nothing ===
640 480 figure
[ 1 2 3 4 ] vector [ 1 2 3 4 ] vector series
figure>svg "polyline" split size 1 - . cr                    \ 1 (one 4-point line)
640 480 figure
[ 1 2 3 4 5 ] vector [ 1 2 -1 3 4 ] vector ln series
figure>svg "polyline" split size 1 - . cr                    \ 2 (split at ln -1)
clear

\ === intervals: a horizontal segment lo..hi at each y position, one polyline per interval ===
640 480 figure
0 :xmin figure! 10 :xmax figure! 0 :ymin figure! 4 :ymax figure!
[ 1 2 3 ] vector [ 5 7 9 ] vector [ 1 2 3 ] vector intervals
figure>svg
dup "polyline" split size 1 - . cr             \ 3 (one 2-point line per interval)
"points='96,340 320,340'" has? . cr            \ 1 (first interval: lo=1,hi=5 at y=1)
clear

\ === abline: y = x on [0,10]x[0,5] clips at (5,5) ===
640 480 figure
0 :xmin figure! 10 :xmax figure! 0 :ymin figure! 5 :ymax figure!
1 0 abline
figure>svg "x1='40' y1='440' x2='320' y2='40'" has? . cr     \ 1
640 480 figure
0 :xmin figure! 10 :xmax figure! 0 :ymin figure! 5 :ymax figure!
1 20 abline
figure>svg "line" has? . cr                                  \ 0 (entirely above)
clear

\ === pixel-space primitives ignore the domain; text is escaped ===
640 480 figure
1 2 3 4 svg-line
100 200 "<b>&nasty' label" svg-text
figure>svg
dup "x1='1' y1='2' x2='3' y2='4'" has? . cr                  \ 1
"&lt;b&gt;&amp;nasty&apos; label" has? . cr                  \ 1
clear

\ === style: aes defaults, figure! overrides, both captured per mark ===
{ :point-radius 5 } aes!
640 480 figure
"tomato" :point-fill figure!
[ 1 2 ] vector [ 1 2 ] vector scatter
"black" :point-fill figure!
[ 3 ] vector [ 3 ] vector scatter
figure>svg
dup "r='5' fill='tomato'" split size 1 - . cr                \ 2 (first scatter)
"r='5' fill='black'" split size 1 - . cr                     \ 1 (second scatter)
:margin figure@ . cr                                         \ 40
{ :point-radius 3 } aes!
clear

\ === round ticks: a [0,1]-pinned y domain steps by 0.2, no padded endpoints ===
640 480 figure
0 :ymin figure! 1 :ymax figure! 0 :xmin figure! 10 :xmax figure!
axes
figure>svg
dup ">0.2</text>" has? . cr                                  \ 1
dup ">0.8</text>" has? . cr                                  \ 1
dup ">1</text>" has? . cr                                    \ 1
dup ">1.05</text>" has? . cr                                 \ 0 (padded endpoint unticked)
">-0.05</text>" has? . cr                                    \ 0
clear

\ === tick labels: whole thousands render as integers (default :tick-format {0:g}), not scientific ===
640 480 figure
2000 :xmin figure! 2010 :xmax figure! 0 :ymin figure! 1 :ymax figure!
axes
figure>svg
dup ">2000</text>" has? . cr                                 \ 1 (not 2e+03)
dup ">2010</text>" has? . cr                                 \ 1 (step 2 makes 2010 a tick)
"e\+" has? . cr                                              \ 0 (no scientific notation anywhere)
clear

\ === :tick-format overrides the default (two-decimal fixed) ===
640 480 figure
0 :xmin figure! 1 :xmax figure! 0 :ymin figure! 1 :ymax figure!
"{0:.2f}" :tick-format figure!
axes
figure>svg ">0.20</text>" has? . cr                          \ 1 (default {0:g} would give 0.2)
clear

\ === axis titles: x centered below, y rotated ===
640 480 figure
"bookings" x-label
"ecdf" y-label
figure>svg
dup "x='320' y='472'" has? . cr                              \ 1 (x title placement)
dup ">bookings</text>" has? . cr                             \ 1
dup "rotate\(-90 12 240\)" has? . cr                         \ 1 (y title rotated)
">ecdf</text>" has? . cr                                     \ 1
clear

\ === panel: filled ground, white grid at the tick steps, no border ===
640 480 figure
0 :xmin figure! 10 :xmax figure! 0 :ymin figure! 1 :ymax figure!
panel
figure>svg
dup "fill='gainsboro' stroke='none'" has? . cr               \ 1 (the ground)
dup "stroke='white'" split size 1 - . cr                     \ 22 (12 major + 10 minor gridlines)
"fill='none' stroke='gray'" has? . cr                        \ 0 (no border rect)
clear

\ (versioned save-figure lives in 140_save_figure, which needs mkdir via a
\ subprocess and is skipped under WASI)

\ === annotate: text placed at a data point renders into the SVG ===
640 480 figure [ 1 2 3 ] vector [ 1 4 9 ] vector scatter
2 4 "peak-here" annotate
figure>svg "peak-here" has? . cr               \ 1  (annotation text present)
clear

\ === :ink recolors text; the default is black ===
640 480 figure "crimson" :ink figure! "b" x-label figure>svg "fill='crimson'" has? . cr   \ 1
640 480 figure "b" x-label figure>svg "fill='black'" has? . cr                             \ 1  (default ink)
clear

\ === legend: a strip reserved to the right narrows the plot; swatches and labels render ===
640 480 figure
0 :xmin figure! 10 :xmax figure! 0 :ymin figure! 10 :ymax figure!
axes
[ "new" "old" ] [ "steelblue" "crimson" ] legend
:right-pad figure@ 0 > . cr                    \ 1 (a strip is reserved)
figure>svg
dup "width='560'" has? . cr                    \ 0 (plot narrowed from the full-width 560)
dup "fill='steelblue'" has? . cr               \ 1 (first swatch)
dup "fill='crimson'" has? . cr                 \ 1 (second swatch)
dup ">new</text>" has? . cr                    \ 1
">old</text>" has? . cr                        \ 1
clear

\ === no legend: the plot keeps its full width (no right strip reserved) ===
640 480 figure axes figure>svg "width='560'" has? . cr   \ 1
clear

\ === errors (thrown; caught here to show the message) ===
[: [ 1 2 ] vector [ 1 2 3 ] vector scatter :] [: . cr :] try-catch   \ (length mismatch)
[: [ 1 2 ] vector [ 1 ] vector series :] [: . cr :] try-catch        \ (length mismatch)
[: [ 1 2 ] vector 0 histogram :] [: . cr :] try-catch                \ (no bins)
[: [ -1 ] vector ln boxplot :] [: . cr :] try-catch                  \ (no finite values)
[: [ -1 ] vector ln [ 1 ] vector data-domain :] [: . cr :] try-catch \ (no finite x)
[: [ [ 1 ] vector ] [ ] boxplots :] [: . cr :] try-catch             \ (label mismatch)
[: [ 1 2 ] vector [ "a" ] barchart :] [: . cr :] try-catch           \ (barchart label mismatch)
[: [ ] vector [ ] barchart :] [: . cr :] try-catch                   \ (barchart no heights)
[: [ "a" "b" ] [ "red" ] legend :] [: . cr :] try-catch              \ (legend color mismatch)
[: [ ] [ ] legend :] [: . cr :] try-catch                           \ (legend no labels)
[: [ 1 2 ] vector [ 5 ] vector [ 1 2 ] vector intervals :] [: . cr :] try-catch  \ (intervals length mismatch)
[: [ 1 2 3 4 ] vector 2 2 reshape [ "A" ] [ "x" "y" ] stacked-barchart :] [: . cr :] try-catch      \ (row/label mismatch)
[: [ 1 2 3 4 ] vector 2 2 reshape [ "A" "B" ] [ "x" ] stacked-barchart :] [: . cr :] try-catch      \ (column/color mismatch)
