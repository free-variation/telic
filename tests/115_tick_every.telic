\ ==== tick-every ( seconds -- ), on-tick ====

\ A periodic timer runs the deferred word on-tick once per tick, at an op
\ boundary of the running code or inside a sleep, which then resumes for its
\ remaining time. Nothing ticks until armed; 0 disarms.

variable ticks 0 to ticks
: count-tick | ^ticks | ++ ticks ;
' count-tick embodies on-tick

\ -- unarmed: a sleep sees no tick
1.2 sleep ticks . cr                                 \ 0

\ -- armed at 1 s: a 2.5 s sleep is interrupted twice and still lasts 2.5 s
1 tick-every
now 2.5 sleep now swap - 2.4 > . cr                  \ 1
ticks . cr                                           \ 2

\ -- ticks land between ops of running code too
: spin 0 to total 0 300000000 1 do i i total + to total loop total ;
0 to ticks
0.25 tick-every
spin drop
ticks 3 >= . cr                                      \ 1   a loop of about 1.5 s at 0.25 s ticks

\ -- disarmed: no further ticks
0 tick-every
0 to ticks
1.2 sleep ticks . cr                                 \ 0

\ -- a hook that leaves the stack alone; one that errors reports and continues
: noisy-tick 1 0 / drop ;
' noisy-tick embodies on-tick
1 tick-every 1.2 sleep 0 tick-every
depth . cr                                           \ 0   (stderr carried "on-tick: division by zero")

\ errors
-1 tick-every                                        \ (a negative interval)
