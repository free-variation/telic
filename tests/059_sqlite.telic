\ SQLite: db-open / db-exec / db-query / db-close with bound parameters. In-memory database, so the test leaves no files.

variable db
":memory:" db-open to db

\ === db-exec: DDL returns 0; bound DML returns the affected-row count ===
db "CREATE TABLE t (id INTEGER, name TEXT, score REAL, note TEXT)" [ ] db-exec . cr
db "INSERT INTO t VALUES (?,?,?,?)" [ 1 "alice" 9.5 "hi" ] db-exec . cr
db "INSERT INTO t VALUES (?,?,?,?)" [ 2 "o'brien" 8.0 null ] db-exec . cr
db "INSERT INTO t VALUES (?,?,?,?)" [ 3 "alice" 7.0 "yo" ] db-exec . cr
db "UPDATE t SET score = score + 1 WHERE name = ?" [ "alice" ] db-exec . cr
db "DELETE FROM t WHERE id = ?" [ 3 ] db-exec . cr
\ table is now: (1,alice,10.5,hi) (2,o'brien,8.0,NULL)

\ === db-query: a dataset with typed columns; a bag, duplicates and NULL kept ===
variable rel
db "SELECT id,name,score,note FROM t ORDER BY id" [ ] db-query to rel
rel n-rows . cr                                                     \ 2
rel :id @ 0 @e . cr                                                 \ 1
rel :score @ 0 @e . cr                                              \ 10.5
rel :note @ 0 @i . cr                                               \ hi
rel :note @ 1 @i . cr                                               \ null

\ === bound parameter: an apostrophe survives with no escaping ===
rel :name @ 1 @i . cr                                               \ o'brien
db "SELECT name FROM t WHERE id = ?" [ 2 ] db-query :name @ 0 @i . cr   \ o'brien

\ === a symbol binds as its text ===
db "SELECT count(*) AS n FROM t WHERE name = ?" [ :alice ] db-query :n @ 0 @e . cr   \ 1

\ === query the result by a string column ===
rel { :name "alice" } query n-rows . cr                             \ 1

\ === empty result set ===
db "SELECT * FROM t WHERE id = ?" [ 99 ] db-query n-rows . cr       \ 0

\ === duplicates preserved (a bag, not a set) ===
db "SELECT name FROM t UNION ALL SELECT name FROM t" [ ] db-query n-rows . cr   \ 4

\ === more rows; query narrows the dataset by a column value ===
db "INSERT INTO t VALUES (?,?,?,?)" [ 3 "alice" 1.0 "z" ] db-exec drop
db "INSERT INTO t VALUES (?,?,?,?)" [ 4 "carol" 2.0 "w" ] db-exec drop
\ names now (id order): alice, o'brien, alice, carol
db "SELECT id,name FROM t ORDER BY id" [ ] db-query to rel
rel { :name "alice" } query n-rows . cr                             \ 2
rel { :name "carol" } query n-rows . cr                             \ 1
rel { :name "alice" } query :id @ transpose matrix>array . cr       \ [ 1 3 ]

\ === db-query: the same rows as a column-oriented dataset ===
\ table (id order): (1,alice,10.5,hi) (2,o'brien,8.0,NULL) (3,alice,1.0,z) (4,carol,2.0,w)
variable ds
db "SELECT id,name,score,note FROM t ORDER BY id" [ ] db-query to ds
ds keys . cr
ds :id @ . cr
ds :name @ . cr
ds :score @ . cr
ds :note @ 1 @i null? . cr
ds [ :id :score ] dataset>matrix dim swap . . cr

\ === db-query: empty result keeps its columns; duplicate name keeps one ===
db "SELECT id,name FROM t WHERE id = ?" [ 99 ] db-query dup keys . :id @ size . cr
db "SELECT name, name FROM t" [ ] db-query dup keys . :name @ size . cr

\ === corner cases: each error recovers and the run continues ===
db "SELECT * FROM t WHERE id = ?" [ ] db-query drop
db "SELECT * FROM t" [ 1 ] db-query drop
db "SELECT ?" [ [< 1 2 >] ] db-query drop
42 db-close
db "SELCT oops" [ ] db-query drop
db "SELCT oops" [ ] db-query drop
42 "SELECT 1" [ ] db-query drop
db "INSERT INTO nope VALUES (1)" [ ] db-exec drop

\ === closed database: query errors, re-close is a silent no-op ===
variable db2
":memory:" db-open to db2
db2 db-close
db2 "SELECT 1" [ ] db-query drop
db2 db-close

db db-close
bye
