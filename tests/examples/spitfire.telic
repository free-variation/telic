\ examples/spitfire.telic's flight model against the Spitfire Mk I's published
\ figures, without a window: the level speed at full throttle at 5,669 m (582
\ km/h published), the climb at full throttle from 300 m holding 75 m/s (770
\ m/min published), these two with the wings held level and the ball
\ centred against the propeller's torque and swirl, and a take-off from
\ Turnhouse on its wheels from the tail-down attitude, the rudder trimmed
\ right, the throttle opened as the speed builds and the swing held on the
\ rudder and, at full rudder, the brakes, the stick eased back from 45 m/s,
\ the engine already running; then starting on the runway and
\ stopping with the slow-running cut-out, the revolutions and whether the
\ engine runs after each step; then the Lysander's take-off, whose Perseus
\ turns the other way, trimmed for take-off with the stick neutral: the
\ heading's change with the rudder free after 6 s, right positive, and with
\ the heading held on the rudder alone, no brakes, the heading's greatest
\ stray, the most rudder used and the lift-off speed (65 mph published);
\ then the Gladiator's level speed at 4,450 m and 300 m and its climb.
\ Each line gives the model's figure, rounded.

[ "geography" "town-streets" "norway-terrain" "narvik" "norway-coarse" "scotland-terrain" "space" "shapes" "render" "world" "cities" "aircraft-types" "flight" ] ( name | "examples/spitfire/" name + ".telic" + load ) each
build-scenery drop

\ the test pilot's hands and feet against the propeller's torque and swirl: the ailerons against the bank and the roll rate, the rudder against the sideslip
: hold-level ( plane -- )
	| plane |
	plane@attitude@right second asin negate to bank
	plane@velocity plane@attitude@right v-dot plane@velocity v-length 1 max2 / to slipping
	bank -2 * plane@rates first 0.5 * - -1 1 clamp controls swap :roll ! drop
	slipping 5 * -1 1 clamp controls swap :yaw ! drop ;

\ === level speed: the nose held so the height stays put, the stick against the climb and the pitch rate, the trim wound against the climb, the wings held level, the mixture leaned to the height's ideal ===
: level-speed ( height -- km/h )
	| height |
	[ 0 height 0 ] 0 120 false new-plane to aircraft
	aircraft 1 :throttle ! 1 :revolutions ! height ideal-mixture :mixture ! drop
	0 3000 1 do k
		aircraft hold-level
		aircraft@velocity second to climb
		climb -0.02 * aircraft@rates second 0.6 * - -1 1 clamp controls swap :pitch ! drop
		aircraft@trim climb 0.001 * - -1 1 clamp aircraft!trim
		aircraft 0.05 fly
	loop
	aircraft@velocity v-length 3.6 * round ;
5669 level-speed . cr                                      \ 576
300 level-speed . cr                                       \ 477
clear

\ === climb: the nose held so the speed stays at 75 m/s, the stick against the speed's excess, its growth and the pitch rate, the trim wound slowly against the excess, the wings held level, the mixture leaned to each height's ideal ===
: climb-rate ( -- m/min )
	[ 0 300 0 ] 0 80 false new-plane to climber
	climber 1 :throttle ! 1 :revolutions ! drop
	80 to previous
	0 1200 1 do k
		climber hold-level
		climber@position second ideal-mixture climber!mixture
		climber@velocity v-length to speed
		speed 75 - to excess
		speed previous - 0.05 / to growth
		speed to previous
		excess 0.03 * growth 0.08 * + climber@rates second 0.6 * - -1 1 clamp controls swap :pitch ! drop
		climber@trim excess 0.0002 * + -1 1 clamp climber!trim
		climber 0.05 fly
	loop
	climber@velocity second 60 * round ;
climb-rate . cr                                            \ 845
clear

\ === take-off from Turnhouse: the rudder trim fully right, the throttle opened as the speed builds, a third at rest and all of it by 20 m/s, the heading held on the rudder against the swing and, below 20 m/s with the rudder bar fully over, the brake lever squeezed whenever the heading strays more than 3°, the bar sending it all to the wheel on its side; the stick eased back from 45 m/s ===
: take-off ( -- seconds km/h metres )
	:turnhouse landmark-ground [ 0 wheel-height 0 ] v+ 60 0 true new-plane to runner
	runner true :magnetos ! true :running ! 0.2 :revolutions ! 0 :throttle ! 1 :rudder-trim ! drop
	runner@position to start
	0 to lifted-at
	0 1200 1 do k
		runner@velocity v-length to speed
		speed 30 / 0.33 + 1 min2 runner!throttle
		60 runner@attitude@forward heading-of - 540 + 360 mod 180 - to error
		error 0.15 * runner@rates 2 @i 3 * - -1 1 clamp to pedal
		error abs 3 > speed 20 < and pedal abs 0.99 > and to braking
		speed 45 > if 0.6 else 0 then controls swap :pitch ! 0 :roll ! pedal :yaw ! braking :brakes ! drop
		runner 0.05 fly
		lifted-at 0 = runner@on-ground not and if
			k 0.05 * to lifted-at
			runner@velocity v-length 3.6 * round to lift-off-speed
			runner@position start v- v-length round to run
			leave
		then
	loop
	controls false :brakes ! drop
	lifted-at lift-off-speed run ;
take-off . . . cr                                          \ 338 166 14.9
clear

\ === starting on the runway: the revolutions with no keys for 2 s; the magnetos on and the starter held 3 s; then the magnetos off for 3 s; the starter held 1 s with them off ===
: runway-seconds ( plane seconds starter -- )
	| plane seconds starter |
	0 seconds 20 * round 1 do k
		controls starter :starter ! true :brakes ! drop
		plane 0.05 fly
	loop ;
: rpm ( plane -- rpm ) :revolutions @ 3000 * round ;
: starting ( -- )
	:turnhouse landmark-ground [ 0 wheel-height 0 ] v+ 60 0 true new-plane to starter
	starter 2 false runway-seconds
	starter rpm . starter@running . cr                     \ 0 0
	starter true :magnetos ! drop
	starter 3 true runway-seconds
	starter rpm . starter@running . cr                     \ 271 1
	starter false :magnetos ! drop
	starter 3 false runway-seconds
	starter rpm . starter@running . cr                     \ 23 0
	starter 1 true runway-seconds
	starter rpm . starter@running . cr                     \ 77 0
	controls false :starter ! drop ;
starting
clear

\ === stopping with the slow-running cut-out: from idle, held 1 s and let go; then held 3 s, and the revolutions 6 s after the cut-out was first held ===
: cut-out-seconds ( plane seconds held -- )
	| plane seconds held |
	0 seconds 20 * round 1 do k
		controls held :cut-out ! true :brakes ! drop
		plane 0.05 fly
	loop ;
: stopping ( -- )
	:turnhouse landmark-ground [ 0 wheel-height 0 ] v+ 60 0 true new-plane to idler
	idler true :magnetos ! true :running ! 0.2 :revolutions ! drop
	idler 1 true cut-out-seconds
	idler 1 false cut-out-seconds
	idler rpm . idler@running . cr                         \ 600 1
	idler 3 true cut-out-seconds
	idler 3 false cut-out-seconds
	idler rpm . idler@running . cr                         \ 22 0
	controls false :cut-out ! drop ;
stopping
clear

\ === the Lysander's take-off from Turnhouse, fine pitch, the throttle opened as the Spitfire's, the tailplane trimmed to the take-off position and the stick neutral: with the rudder free, the heading's change after 6 s, degrees, right positive; with the heading held on the rudder alone, no rudder trim and no brakes, the greatest stray from the heading, degrees, the most rudder used, a share of its travel, and the lift-off speed, km/h ===
: lysander-run ( law seconds -- plane stray most-rudder )
	| law seconds |
	:turnhouse landmark-ground [ 0 wheel-height 0 ] v+ 60 0 true new-plane to runner
	runner lysander-mk-ii use-type
	runner true :magnetos ! true :running ! 0.2 :revolutions ! 0 :throttle ! :two-pitch :propeller ! 0.3 :trim ! drop
	0 to stray
	0 to most-rudder
	0 seconds 20 * round 1 do k
		runner@velocity v-length to speed
		speed 30 / 0.33 + 1 min2 runner!throttle
		60 runner@attitude@forward heading-of - 540 + 360 mod 180 - to error
		error runner law execute to pedal
		controls 0 :pitch ! 0 :roll ! pedal :yaw ! false :brakes ! drop
		runner 0.05 fly
		error abs stray max2 to stray
		pedal abs most-rudder max2 to most-rudder
		runner@on-ground not if leave then
	loop
	runner stray most-rudder ;
( 2drop 0 ) 6 lysander-run 2drop @attitude@forward heading-of 60 - round . cr   \ 17
( error plane | error 0.15 * plane@rates 2 @i 3 * - -1 1 clamp ) 60 lysander-run
100 * round 100 / . round . @velocity v-length 3.6 * round . cr                  \ 0.87 6 105
clear

\ === the Gladiator Mk II against its published figures: the level speed at full throttle at 4,450 m (414 km/h published) and at 300 m, and the climb from 300 m holding 50 m/s (788 m/min published), its fixed-pitch propeller as the two-pitch one, the wings level and the ball centred as the Spitfire's runs ===
: gladiator-level-speed ( height -- km/h )
	| height |
	[ 0 height 0 ] 0 100 false new-plane to aircraft
	aircraft gladiator-mk-ii use-type
	aircraft 1 :throttle ! 1 :revolutions ! :two-pitch :propeller ! height ideal-mixture :mixture ! drop
	0 3000 1 do k
		aircraft hold-level
		aircraft@velocity second to climb
		climb -0.02 * aircraft@rates second 0.6 * - -1 1 clamp controls swap :pitch ! drop
		aircraft@trim climb 0.001 * - -1 1 clamp aircraft!trim
		aircraft 0.05 fly
	loop
	aircraft@velocity v-length 3.6 * round ;
: gladiator-climb-rate ( -- m/min )
	[ 0 300 0 ] 0 50 false new-plane to climber
	climber gladiator-mk-ii use-type
	climber 1 :throttle ! 1 :revolutions ! :two-pitch :propeller ! drop
	50 to previous
	0 1200 1 do k
		climber hold-level
		climber@position second ideal-mixture climber!mixture
		climber@velocity v-length to speed
		speed 50 - to excess
		speed previous - 0.05 / to growth
		speed to previous
		excess 0.03 * growth 0.08 * + climber@rates second 0.6 * - -1 1 clamp controls swap :pitch ! drop
		climber@trim excess 0.0002 * + -1 1 clamp climber!trim
		climber 0.05 fly
	loop
	climber@velocity second 60 * round ;
4450 gladiator-level-speed . cr                            \ 422
300 gladiator-level-speed . cr                             \ 356
gladiator-climb-rate . cr                                  \ 748
clear
