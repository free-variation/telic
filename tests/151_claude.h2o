\ lib/claude.h2o: the pure words — message frames, the request body, the curl
\ argv, response classification, extraction, and pricing. Nothing here calls the
\ API: every result frame is synthesised, so the test needs no key and no network.

"lib/claude.h2o" load
"ANTHROPIC_API_KEY" "test-key" env!

\ === message frames ===
"hello" user-message . cr                    \ { :content hello :role user }
"sure" assistant-message . cr                \ { :content sure :role assistant }

clear

\ === request-body: the model and cap come from the globals ===
[ "hi" user-message ] request-body dup "claude-opus-4-8" has? . cr   \ 1
dup "65536" has? . cr                                               \ 1
"hello" has? . cr                                                   \ 0   the messages carry their own text

clear

\ === build-curl-argv: the header takes the key from the environment, the body
\ is the final argument ===
"BODY" build-curl-argv
dup 0 @i . cr                                        \ curl
dup dup size 1 - @i . cr                             \ BODY
dup [: "x-api-key: test-key" = :] any? . cr          \ 1
[: "anthropic-version: 2023-06-01" = :] any? . cr    \ 1

clear

\ === response-ok?: status 0 and a :content array ===
{ :status 0 :out "{""content"":[{""text"":""hi""}]}" } response-ok? . cr   \ 1
{ :status 1 :out "{""content"":[]}" } response-ok? . cr                   \ 0   non-zero status
{ :status 0 :out "{""error"":""nope""}" } response-ok? . cr               \ 0   no :content

clear

\ === extract-response: the text, the stderr, or the whole body re-rendered ===
{ :status 0 :out "{""content"":[{""text"":""the answer""}]}" } extract-response . cr  \ the answer
{ :status 7 :err "curl failed" } extract-response . cr                                \ curl failed
{ :status 0 :out "{""error"":""nope""}" } extract-response . cr                       \ {"error": "nope"}

clear

\ === pricing: rates are ¢ per token, so a call costs a fraction of a cent ===
"claude-opus-4-8" model-price :output @ . cr    \ 0.0075
"claude-sonnet-5" model-price :input @ . cr     \ 0.0003

{ :status 0
  :out "{""model"":""claude-opus-4-8"",""usage"":{""input_tokens"":1000,""output_tokens"":2000}}" }
response-cost . cr                              \ 16.5 ¢   1000*0.0015 + 2000*0.0075

{ :status 0 :out "{""model"":""claude-opus-4-8""}" } response-cost . cr   \ 0 $   no usage reported

cot-cost-ceiling . cr                           \ 491.52 ¢   65536 * 0.0075

clear

\ === errors ===
"no-such-model" model-price       \ (unpriced model)
