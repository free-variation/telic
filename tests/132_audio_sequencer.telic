\ ==== sequence-note ( pitch length -- ), sequence-chord ( pitches length -- ),
\      sequence-rest ( length -- ), sequence-tempo ( bpm -- ),
\      sequence-instrument ( n -- ), sequence-articulation ( fraction -- ),
\      sequence-velocity ( v -- ), sequence-end ( -- seconds ), wait-sequence ( -- ) ====

\ Lengths are fractions of a whole note, best written as exact rationals
\ (1/4, 3/8); at 120 bpm a whole note is 2 s, 96000 samples. Each instrument
\ keeps its own position, kept as an exact fraction of a sample so no length
\ ever drifts; a note starts where the instrument's previous note or rest
\ ended, or now when that is in the past. A note sounds for articulation x
\ its length (default 7/8). sequence-tempo, sequence-instrument,
\ sequence-articulation and sequence-velocity apply to the notes queued
\ after them. Onsets are measured here on white noise with no attack, whose
\ first sample is already loud.

11 seed

{ :oscillators [ { :wave :white :attack 0 :release 0 } ] } 0 instrument-patch!
{ :oscillators [ { :wave :white :attack 0 :release 0 } ] } 1 instrument-patch!
: loud ( stereo -- mask ) | stereo | stereo 0 stereo n-rows 0 1 submatrix abs 1e-12 > ;
: onsets ( stereo -- array ) loud to mask
	[ ] to found 0 to previous
	0 mask n-rows 1 do k
		mask k @e to current
		current previous > if found k add-last! drop then
		current to previous
	loop found ;
: offsets ( stereo -- array ) loud to mask
	[ ] to found 0 to previous
	0 mask n-rows 1 do k
		mask k @e to current
		current previous < if found k add-last! drop then
		current to previous
	loop found ;
: fresh ( -- ) silence-audio 120 sequence-tempo 0 sequence-instrument 0.875 sequence-articulation 1 sequence-velocity ;

\ === quarter notes at 120 bpm start 24000 samples apart ===
fresh :a4 1/4 sequence-note :a4 1/4 sequence-note :a4 1/4 sequence-note
sequence-end . cr                                \ 1.5
1.6 render-audio dup onsets . offsets . cr       \ [ 0 24000 48000 ] [ 21000 45000 69000 ] (7/8 of each)
clear

\ === other lengths, a rest, a float length ===
fresh :a4 3/8 sequence-note :a4 1/16 sequence-note 1/8 sequence-rest :a4 0.25 sequence-note
sequence-end . cr                                \ 1.625 (3/8 + 1/16 + 1/8 + 1/4 = 13/16 of a 2 s whole note)
1.7 render-audio onsets . cr                     \ [ 0 36000 54000 ] (the 1/8 rest leaves a gap before the last)
clear

\ === articulation ===
fresh 1 sequence-articulation :a4 1/4 sequence-note :b4 1/4 sequence-note
1.1 render-audio dup onsets . offsets . cr       \ [ 0 ] [ 48000 ] (legato: one continuous sound)
fresh 1/2 sequence-articulation :a4 1/4 sequence-note
0.6 render-audio offsets . cr                    \ [ 12000 ]
clear

\ === a chord starts all its pitches together and advances once ===
{ :oscillators [ { :attack 0 :release 0 } ] } 2 instrument-patch!
fresh 2 sequence-instrument [ :a4 :c#5 :e5 ] 1/2 sequence-chord :a3 1/2 sequence-note
2 render-audio to triad
: amp ( v hz -- a ) 48000 swap amplitude-at 0.70710678 / 100 * round 100 / ;
triad 1200 21600 0 1 submatrix to held
held 440 amp . held :c#5 pitch>hz amp . held :e5 pitch>hz amp . held 220 amp . cr   \ 1 1 1 0
triad 49200 69600 0 1 submatrix 220 amp . cr     \ 1 (the next note waits a half note)
clear

\ === a tempo change moves later onsets only ===
fresh :a4 1/4 sequence-note 60 sequence-tempo :a4 1/4 sequence-note :a4 1/4 sequence-note
sequence-end . cr                                \ 2.5 (0.5 s, then 1 s, then 1 s)
2.6 render-audio onsets . cr                     \ [ 0 24000 72000 ]
clear

\ === instruments keep separate positions and play together ===
fresh 0 sequence-instrument :a4 1/2 sequence-note 1 sequence-instrument :c4 1/4 sequence-note :c4 1/4 sequence-note
1.1 render-audio onsets . cr                     \ [ 0 ] (instrument 1's second note starts inside instrument 0's)
fresh 1/2 sequence-articulation 0 sequence-instrument :a4 1/2 sequence-note 1 sequence-instrument 3/8 sequence-rest :c4 1/4 sequence-note
1.1 render-audio dup onsets . offsets . cr       \ [ 0 36000 ] [ 24000 48000 ] (instrument 0 sounds 0-24000, instrument 1 36000-48000)
clear

\ === exact positions: 7000 rests of 1/7 at 120 bpm end at exactly 2000 s ===
fresh : sevenths ( -- ) 0 7000 1 do k 1/7 sequence-rest loop ; sevenths
sequence-end . cr                                \ 2000 (13714.2857... samples each, summed without drift)
clear

\ === velocity ===
{ :oscillators [ { :fixed-hz 1000 :attack 0 :release 0 } ] } 3 instrument-patch!
fresh 3 sequence-instrument 0.5 sequence-velocity :a4 1/2 sequence-note
0.5 render-audio 4800 19200 0 1 submatrix 1000 amp . cr   \ 0.5
clear

\ === silence-audio empties the queue and resets every instrument ===
fresh :a4 1/4 sequence-note :a4 1/4 sequence-note silence-audio
sequence-end . 0.6 render-audio abs max . cr     \ 0 0
wait-sequence "offline, wait-sequence returns at once" . cr   \ offline, wait-sequence returns at once
clear

\ === the schedule holds 8192 events: 4096 notes ===
fresh : many ( n -- ) 0 swap 1 do k :a4 1/64 sequence-note loop ; 4096 many
sequence-end . cr                                \ 128 (4096 x 1/64 x 2 s)
( :a4 1/64 sequence-note ) catch . drop sequence-end . cr   \ 1 128 (the 4097th is refused whole)
silence-audio clear

\ errors
:a4 0 sequence-note                              \ (zero length)
:a4 -1/4 sequence-note                           \ (negative length)
:a4 "long" sequence-note                         \ (not a number)
:h4 1/4 sequence-note                            \ (not a pitch)
[ ] 1/4 sequence-chord                           \ (no pitches)
:a4 1/4 sequence-chord                           \ (not an array)
0 sequence-rest                                  \ (zero length)
0 sequence-tempo                                 \ (tempo must be above 0)
1001 sequence-tempo                              \ (over 1000)
0 sequence-articulation                          \ (must be above 0)
1.5 sequence-articulation                        \ (over 1)
2 sequence-velocity                              \ (above 1)
16 sequence-instrument                           \ (instrument out of range)
