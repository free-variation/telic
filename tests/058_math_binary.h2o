\ log is base-10, ln is natural, ^ is polymorphic power ( base exp -- base^exp ).

\ ---- log base-10 ----
100 log .            \ 2
1000 log .           \ 3
1 log .              \ 0

\ ---- ln natural ----
1 ln .               \ 0
1 exp ln .           \ 1  (ln of e)

\ ---- ^ : scalar ----
2 10 ^ .             \ 1024
9 0.5 ^ .            \ 3
2 -1 ^ .             \ 0.5
5 0 ^ .              \ 1

\ ---- ^ : matrix ^ scalar (element-wise) ----
[ 1 2 3 4 ] 2 2 matrix 2 ^ .           \ [1 4 9 16]

\ ---- ^ : scalar ^ matrix ----
2 [ 0 1 2 3 ] 1 4 matrix ^ .           \ [1 2 4 8]

\ ---- ^ : matrix ^ matrix (element-wise, same shape) ----
[ 2 3 4 ] 1 3 matrix  [ 3 2 1 ] 1 3 matrix  ^ .   \ [8 9 4]

\ ---- failures ----
"x" 2 ^
[ 1 2 ] 1 2 matrix  [ 1 2 3 ] 1 3 matrix  ^

clear
\ % is Forth /mod: ( a b -- rem quot ), quotient on top.
\ Printing with `. .` shows quotient first (top of stack), then remainder.

17 5 % . . cr        \ 3 2     (quot 3, rem 2)
7 3 % . . cr         \ 2 1
-7 3 % . . cr        \ -2 -1   (remainder takes the sign of the dividend)
10 2 % . . cr        \ 5 0
5.5 2 % . . cr       \ 2 1.5

\ remainder alone (mod) via drop; quotient alone via swap drop
7 3 % drop . cr      \ 1   (the remainder)
7 3 % swap drop . cr \ 2   (the quotient)

\ % element-wise: remainder matrix under quotient matrix, scalar broadcast in
\ either position; swap prints the remainders first
[ 17 7 ] vector 5 % swap .a .a cr              \ rems 2 2 then quots 3 1
12 [ 5 7 ] vector % swap .a .a cr              \ rems 2 5 then quots 2 1
[ 17 7 ] vector [ 5 4 ] vector % swap .a .a cr \ rems 2 3 then quots 3 1

\ mod: the remainder alone, sign of the dividend; element-wise over a matrix
\ with scalar broadcast in either position, like the other arithmetic words
7 3 mod . cr                             \ 1
-7 3 mod . cr                            \ -1
7 -3 mod . cr                            \ 1
5.5 2 mod . cr                           \ 1.5
[ 5 7 9 ] vector 3 mod .a cr             \ 2 1 0 down a 3x1
12 [ 5 7 ] vector mod .a cr              \ 2 5   scalar dividend broadcasts
[ 5 7 ] vector [ 3 4 ] vector mod .a cr  \ 2 3   pairwise

\ min2/max2: <-ordered lesser and greater of two scalars
3 7 min2 . cr        \ 3
7 3 min2 . cr        \ 3
3 7 max2 . cr        \ 7
7 3 max2 . cr        \ 7
-2 -5 min2 . cr      \ -5
4 4 max2 . cr        \ 4
"apple" "pear" min2 . cr \ apple  (< is structural on strings)
2 s 3 s min2 . cr    \ 2 s   quantities order by magnitude in a common unit
nan 3 min2 . cr      \ null  NaN orders below every number
3 nan min2 . cr      \ null
nan 3 max2 . cr      \ 3     so max2 answers the number
[ 1 5 ] vector 3 min2 .a cr              \ 1 3   element-wise with broadcast
3 [ 1 5 ] vector min2 .a cr              \ 1 3   either position
[ 1 5 ] vector [ 4 2 ] vector max2 .a cr \ 4 5   pairwise
[ 1 nan ] vector 3 min2 .a cr            \ 1 null   NaN propagates per element
[ 1 nan ] vector 3 max2 .a cr            \ 3 3

\ failures
5 0 %
"x" 2 %

clear
\ Monomorphic float-only ops (f-prefixed): no tag check, depth-guarded.
\ The polymorphic versions (abs, sqrt, +, ^, ...) are tested elsewhere; these
\ are the fast unsafe counterparts and must match on float inputs.

\ unary functions
-3.0 fabs . cr        \ 3
9.0 fsqrt . cr        \ 3
0.0 fexp . cr         \ 1
1.0 fln . cr          \ 0
1000.0 flog . cr      \ 3
0.0 fsin . cr         \ 0
0.0 fcos . cr         \ 1
1.0 fatan . cr        \ 0.785398
2.7 fround . cr       \ 3
2.1 fround-up . cr    \ 3
2.9 fround-down . cr  \ 2
-2.9 ftruncate . cr   \ -2
5.0 fnegate . cr      \ -5
5.0 f1+ . cr          \ 6
5.0 f1- . cr          \ 4
5.0 fsq . cr          \ 25

\ binary
2.0 10.0 f^ . cr      \ 1024
-7.0 3.0 fmod . cr    \ -1
2.0 3.0 f+ . cr       \ 5
10.0 4.0 f- . cr      \ 6
3.0 4.0 f* . cr       \ 12
12.0 4.0 f/ . cr      \ 3

\ f++ / f-- : unsafe float local increment / decrement (immediate; named local)
: finc 0 to n  f++ n  f++ n  f++ n  n ;
finc . cr             \ 3
: fdec 10 to n  f-- n  f-- n  n ;
fdec . cr             \ 8
: fmix | x |  f++ x  f-- x  f-- x  x ;
5 fmix . cr           \ 4
: fnest 0 to n  [: f++ n :] execute  n ;   \ (f++ on the word's local from inside a quotation)

5 0 %                                    \ (zero divisor)
[ 1 2 ] vector [ 1 0 ] vector %          \ (zero element in the divisor)
[ 1 2 ] vector [ 1 2 3 ] vector %        \ (shapes differ)
"x" 3 %                                  \ (not a float or matrix)
5 0 mod                                  \ (zero divisor)
[ 1 2 ] vector 0 mod                     \ (zero scalar divisor over a matrix)
[ 1 2 ] vector [ 1 0 ] vector mod        \ (zero element in the divisor)
[ 1 2 ] vector [ 1 2 3 ] vector mod      \ (shapes differ)
"x" 3 mod                                \ (not a float or matrix)

\ depth guard (empty stack)
fsqrt
