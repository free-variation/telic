\ lib/plot.telic versioned save: save-figure writes images-<name>/N.svg, the
\ index advancing per save. Creating the directory shells out to `mkdir -p`
\ (a subprocess), so this is native-only; the wasm suite skips it. The SVG
\ rendering itself is covered by 131_plot, which runs everywhere.
"lib/plot.telic" load

\ === versioned figures: numbered saves, index advances (observed via the files) ===
[ "rm" "-rf" "/tmp/images-lf140" ] run-result drop
"/tmp" cd
"/tmp/images-lf140/1.svg" file-exists? . cr                 \ 0 (nothing saved yet)
640 480 figure [ 1 2 ] vector [ 3 4 ] vector scatter
"lf140" save-figure
"/tmp/images-lf140/1.svg" file-exists? . cr                 \ 1 (first save)
"/tmp/images-lf140/2.svg" file-exists? . cr                 \ 0 (only one so far)
"lf140" save-figure
"/tmp/images-lf140/2.svg" file-exists? . cr                 \ 1 (index advanced)
"/tmp/images-lf140/3.svg" file-exists? . cr                 \ 0 (only two saves)

\ === view-figure opens the viewer without saving a new version ===
\ point TELIC_BROWSER at a harmless executable so the open is a no-op, not a real browser
"TELIC_BROWSER" "/bin/echo" env!
"/tmp/images-lf140/index.html" file-exists? . cr            \ 0 (save-figure never writes it)
"lf140" view-figure
"/tmp/images-lf140/index.html" file-exists? . cr            \ 1 (view-figure wrote the viewer page)
"/tmp/images-lf140/3.svg" file-exists? . cr                 \ 0 (no new figure saved)
bye
