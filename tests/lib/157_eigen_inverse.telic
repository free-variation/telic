\ lib/statistics.telic: symmetric-eigen ( A -- values vectors ) via LAPACKE
\ dsyev and inverse ( A -- inverse ) via LAPACKE dgetrf and dgetri. The checks
\ are identities the answers must satisfy, since eigenvector signs are not
\ canonical: A·V = V·Λ, VᵀV = I, the eigenvalues summing to the trace, and
\ A·A⁻¹ = I.

"statistics" load-library

42 seed
: random-matrix ( rows cols -- mat )
	| rows cols |
	rows cols * iota ( drop random-normal ) map rows cols matrix ;

5 5 random-matrix to square-five
square-five dup transpose matmul 5 identity-matrix + to symmetric-five

new-tests

\ === symmetric-eigen ===
"eigenvalues of a 2x2, ascending" (
	[ 2 1 1 2 ] 2 2 matrix symmetric-eigen drop matrix>array [ 1 3 ] expect=
) test

"A V = V Lambda, V orthonormal, the values summing to the trace" (
	symmetric-five symmetric-eigen to vectors to values
	symmetric-five vectors matmul vectors values * - abs max 1e-10 < expect
	vectors transpose vectors matmul 5 identity-matrix - abs max 1e-12 < expect
	values sum symmetric-five diagonal sum 1e-10 expect-near
	values matrix>array dup sort expect=
) test

"only the upper triangle is read" (
	[ 1 5 0 1 ] 2 2 matrix symmetric-eigen drop [ -4 6 ] 1 2 matrix 1e-12 expect-near
) test

"the input is left unchanged" (
	symmetric-five copy to before
	symmetric-five symmetric-eigen 2drop
	symmetric-five before expect=
) test

"a non-square matrix throws" (
	( [ 1 2 3 4 5 6 ] 2 3 matrix symmetric-eigen ) expect-throws
) test

\ === inverse ===
"the inverse of a 2x2" (
	[ 4 7 2 6 ] 2 2 matrix inverse [ 0.6 -0.7 -0.2 0.4 ] 2 2 matrix 1e-12 expect-near
) test

"A A-inverse = I for a random 5x5" (
	square-five dup inverse matmul 5 identity-matrix - abs max 1e-10 < expect
) test

"the input is left unchanged" (
	square-five copy to before
	square-five inverse drop
	square-five before expect=
) test

"a singular matrix throws" (
	( [ 1 2 2 4 ] 2 2 matrix inverse ) catch 1 expect=
	"inverse: the matrix is singular" expect=
) test

"a non-square matrix throws" (
	( [ 1 2 3 4 5 6 ] 2 3 matrix inverse ) expect-throws
) test

test-report
