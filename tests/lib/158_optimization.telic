\ lib/statistics.telic: minimize ( x0 objective gradient max-iterations
\ tolerance -- fr ) by BFGS, numeric-gradient ( x objective -- gradient ) and
\ numeric-hessian ( x objective -- hessian ). The decisive check is a logistic
\ regression fitted by minimizing its negative log-likelihood: the estimate must
\ equal the plain maximum-likelihood fit, and the inverse of the numeric Hessian
\ at it must equal glm-covariance's covariance.

"statistics" load-library

: rosenbrock ( x -- f )
	| x |
	1 x 0 @e - sq 100 x 1 @e x 0 @e sq - sq * + ;

: rosenbrock-gradient ( x -- g )
	| x |

	x 0 @e to a
	x 1 @e to b
	[ -2 1 a - * 400 a * b a sq - * - 200 b a sq - * ] vector ;

: quadratic ( x -- f )
	| x |
	x 0 @e sq 3 * x 0 @e x 1 @e * 2 * + x 1 @e sq + 4 x 0 @e * - ;

: logistic-loss ( beta X y -- f )
	| beta features outcomes |

	features beta matmul to eta
	eta exp 1 + ln outcomes eta * - sum ;

[ 1 0  1 1  1 2  1 3  1 4  1 5  1 6  1 7 ] 8 2 matrix to design
[ 0 0 1 0 1 1 0 1 ] vector to outcome
( beta | beta design outcome logistic-loss ) to logistic-objective

new-tests

\ === minimize ===
"Rosenbrock with its gradient reaches (1, 1)" (
	[ -1.2 1 ] vector ' rosenbrock ' rosenbrock-gradient 500 1e-10 minimize to fit
	fit@converged 1 expect=
	fit@estimate [ 1 1 ] vector 1e-8 expect-near
	fit@value 0 1e-16 expect-near
) test

"Rosenbrock with numeric gradients reaches (1, 1)" (
	[ -1.2 1 ] vector ' rosenbrock null 500 1e-10 minimize to fit
	fit@converged 1 expect=
	fit@estimate [ 1 1 ] vector 1e-6 expect-near
) test

"the quadratic's minimum, solved by hand: (1, -1)" (
	[ 5 5 ] vector ' quadratic null 100 1e-10 minimize @estimate [ 1 -1 ] vector 1e-6 expect-near
) test

"the iteration limit stops without converging" (
	[ -1.2 1 ] vector ' rosenbrock null 2 1e-10 minimize to fit
	fit@iterations 2 expect=
	fit@converged 0 expect=
) test

"a 1xn start is taken as nx1" (
	[ -1.2 1 ] 1 2 matrix ' rosenbrock null 500 1e-10 minimize @estimate dim 1 expect= 2 expect=
) test

\ === numeric derivatives ===
"numeric-gradient equals the analytic gradient" (
	[ 1 2 ] vector ' rosenbrock numeric-gradient [ 1 2 ] vector rosenbrock-gradient 1e-5 expect-near
) test

"numeric-hessian equals the analytic Hessian" (
	[ 1 2 ] vector ' rosenbrock numeric-hessian [ 402 -400 -400 200 ] 2 2 matrix 1e-4 expect-near
	[ 0 0 ] vector ' quadratic numeric-hessian [ 6 2 2 2 ] 2 2 matrix 1e-5 expect-near
) test

\ === maximum likelihood ===
"a logistic fit equals the plain maximum-likelihood estimate" (
	[ 0 0 ] vector logistic-objective null 200 1e-10 minimize @estimate
	design outcome 50 1e-12 0 fit-logistic-ridge 1e-5 expect-near
) test

"the inverse numeric Hessian equals glm-covariance" (
	[ 0 0 ] vector logistic-objective null 200 1e-10 minimize @estimate to estimate
	estimate logistic-objective numeric-hessian inverse
	design outcome [ 1 1 1 1 1 1 1 1 ] vector estimate binomial-logit glm-covariance 1e-5 expect-near
) test

test-report
