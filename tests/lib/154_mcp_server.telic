\ lib/mcp.telic: the MCP stdio server, driven as a child process — this test
\ writes JSON-RPC requests to its input and reads its answers back, so every
\ assertion is on what a client would see. It lives in tests/lib because a
\ session is a subprocess and tool output is captured with stdout>string, both
\ native-only, and it validates itself with the test vocabulary rather than a
\ golden file. Two servers are started: the first for the protocol and session
\ behavior, the second with a cap of two sessions for the eviction case.

new-tests

variable server

( code -- proc ) \ a server child running the given startup source
: start-server
  | code |
  [ binary-dir "/telic" + "-e" code ] start-process ;

( -- fr ) \ the _meta every request carries
: request-meta
  { :io.modelcontextprotocol/protocolVersion "2026-07-28"
	:io.modelcontextprotocol/clientCapabilities { }
  } ;

( str -- ) \ send one line to the server
: send-line
  "{0}{nl}" format server :in @ write ;

( id method params -- ) \ send one request, with the required _meta filled in
: send-request
  | id method params |
  params :_meta request-meta ! drop
  { :jsonrpc "2.0" :id id :method method :params params } frame>json send-line ;

( id name arguments -- ) \ send one tools/call
: send-call
  | id name arguments |
  id "tools/call" { :name name :arguments arguments } send-request ;

( -- fr ) \ the server's next answer, with a bound on how long we wait for it
: next-answer
  [ server :out @ ] 20 wait-readable size 0 = if
	"the server did not answer within 20 seconds" throw
  then
  server :out @ read-line json>frame ;

( fr -- str ) \ the text of a tool result
: answer-text
  /result/content @ 0 @i :text @ ;

( fr -- bool ) \ whether a tool result reports a failure
: answer-failed?
  /result/isError @ :1 = ;

"""mcp"" load-library 3 to mcp-call-seconds mcp-serve" start-server to server

\ === discovery and the tool list ===

"server/discover names the revision it speaks" [:
  "d1" "server/discover" { } send-request
  next-answer /result/supportedVersions @ 0 @i "2026-07-28" expect=
:] test

"server/discover declares the tools capability" [:
  "d2" "server/discover" { } send-request
  next-answer /result/capabilities/tools @ frame? expect
:] test

"tools/list answers both tools in a fixed order" [:
  "l1" "tools/list" { } send-request
  next-answer /result/tools @ to tools
  tools 0 @i :name @ "telic-eval" expect=
  tools 1 @i :name @ "telic-help" expect=
  tools 0 @i /inputSchema/required @ 0 @i "code" expect=
:] test

"ping answers a result" [:
  "p1" "ping" { } send-request
  next-answer /result/resultType @ "complete" expect=
:] test

"every result identifies the server" [:
  "p2" "ping" { } send-request
  next-answer /result/_meta @ :io.modelcontextprotocol/serverInfo @ :name @ "telic" expect=
:] test

\ === evaluation in a session ===

"a call answers what the code printed" [:
  "e1" "telic-eval" { :session "a" :code "3 4 + . cr" } send-call
  next-answer answer-text "7 " expect=
:] test

"a definition survives into later calls on that session" [:
  "e2" "telic-eval" { :session "a" :code ": twice 2 * ; 21 twice . cr" } send-call
  next-answer answer-text "42 " expect=

  "e3" "telic-eval" { :session "a" :code "5 twice . cr" } send-call
  next-answer answer-text "10 " expect=
:] test

"another session cannot see that definition" [:
  "e4" "telic-eval" { :session "b" :code "twice . cr" } send-call
  next-answer to answer
  answer answer-failed? expect
  answer answer-text "unknown word: twice" has? expect
:] test

"a failure in evaluated code is a tool error, not a protocol error" [:
  "e5" "telic-eval" { :session "a" :code "1 0 /" } send-call
  next-answer to answer
  answer answer-failed? expect
  answer answer-text "division by zero" has? expect
  answer :error has? not expect
:] test

"the session keeps working after a failure" [:
  "e6" "telic-eval" { :session "a" :code "8 twice . cr" } send-call
  next-answer answer-text "16 " expect=
:] test

\ === the help tool ===

"telic-help answers a word's entry and needs no session" [:
  "h1" "telic-help" { :word "nip" } send-call
  next-answer to answer
  answer answer-failed? not expect
  answer answer-text "nip \( a b -- b \)" has? expect
:] test

"telic-help reports an unknown name" [:
  "h2" "telic-help" { :word "zzznotaword" } send-call
  next-answer to answer
  answer answer-failed? expect
  answer answer-text "unknown word" has? expect
:] test

"telic-help refuses a name with a space" [:
  "h3" "telic-help" { :word "a b" } send-call
  next-answer answer-failed? expect
:] test

\ === protocol errors ===

"an unknown tool is a protocol error" [:
  "t1" "nosuchtool" { } send-call
  next-answer /error/code @ -32602 expect=
:] test

"an unsupported version answers -32022 and lists what is supported" [:
  "{""jsonrpc"":""2.0"",""id"":""v1"",""method"":""ping"",""params"":{""_meta"":{""io.modelcontextprotocol/protocolVersion"":""1900-01-01"",""io.modelcontextprotocol/clientCapabilities"":{}}}}" send-line
  next-answer to answer
  answer /error/code @ -32022 expect=
  answer /error/data/supported @ 0 @i "2026-07-28" expect=
  answer /error/data/requested @ "1900-01-01" expect=
:] test

"a request without the required _meta is invalid params" [:
  "{""jsonrpc"":""2.0"",""id"":""v2"",""method"":""ping"",""params"":{}}" send-line
  next-answer /error/code @ -32602 expect=
:] test

"initialize is refused with a message naming the revision" [:
  "{""jsonrpc"":""2.0"",""id"":""v3"",""method"":""initialize"",""params"":{}}" send-line
  next-answer /error/message @ "2026-07-28" has? expect
:] test

"a malformed line answers a parse error" [:
  "{ this is not json" send-line
  next-answer /error/code @ -32700 expect=
:] test

"a notification is answered with nothing" [:
  "{""jsonrpc"":""2.0"",""method"":""notifications/whatever"",""params"":{}}" send-line
  "p3" "ping" { } send-request
  next-answer :id @ "p3" expect=
:] test

\ === concurrency and the deadline ===

"sessions run at the same time, so the quick answer arrives first" [:
  "slow" "telic-eval" { :session "s" :code "1 sleep 111 . cr" } send-call
  "quick" "telic-eval" { :session "q" :code "222 . cr" } send-call
  next-answer :id @ "quick" expect=
  next-answer :id @ "slow" expect=
:] test

"a call that overruns its deadline stops the session, and its queue fails with it" [:
  "spin" "telic-eval" { :session "x" :code ": spin begin 1 drop again ; spin" } send-call
  "queued" "telic-eval" { :session "x" :code "7 . cr" } send-call

  next-answer to stopped
  stopped :id @ "spin" expect=
  stopped answer-failed? expect
  stopped answer-text "exceeded" has? expect

  next-answer to dropped
  dropped :id @ "queued" expect=
  dropped answer-failed? expect
:] test

"the session starts fresh after being stopped" [:
  "again" "telic-eval" { :session "x" :code "7 . cr" } send-call
  next-answer answer-text "7 " expect=
:] test

server end-process

\ === the session cap ===

"""mcp"" load-library 2 to mcp-max-sessions mcp-serve" start-server to server

"reaching the cap closes the least recently used idle session" [:
  "c1" "telic-eval" { :session "one" :code ": marker 1 ; marker . cr" } send-call
  next-answer answer-text "1 " expect=

  "c2" "telic-eval" { :session "two" :code "2 . cr" } send-call
  next-answer answer-text "2 " expect=

  "c3" "telic-eval" { :session "three" :code "3 . cr" } send-call
  next-answer answer-text "3 " expect=

  "c4" "telic-eval" { :session "one" :code "marker . cr" } send-call
  next-answer to answer
  answer answer-failed? expect
  answer answer-text "unknown word: marker" has? expect
:] test

server end-process

\ === a host program's own tool ===

( -- proc ) \ a server whose host registers a tool of its own before serving
: start-host-server
  [ """mcp"" load-library"
	": greet-tool | id arguments | id ""hello "" arguments :who @ + false mcp-tool-result ;"
	"{ :name ""greet"" :title ""Greet someone"" :description ""Answer a greeting"""
	"  :inputSchema { :type ""object"" :properties { :who { :type ""string"" } } :required [ ""who"" ] }"
	"} ' greet-tool mcp-add-tool"
	"mcp-serve"
  ] "{nl}" format join "/tmp/telic-mcp-host.telic" write-file
  [ binary-dir "/telic" + "/tmp/telic-mcp-host.telic" ] start-process ;

start-host-server to server

"a host tool is listed after the built-in ones" [:
  "g1" "tools/list" { } send-request
  next-answer /result/tools @ to tools
  tools size 3 expect=
  tools 2 @i :name @ "greet" expect=
:] test

"a host tool answers its own call" [:
  "g2" "greet" { :who "world" } send-call
  next-answer to answer
  answer answer-failed? not expect
  answer answer-text "hello world" expect=
:] test

"the built-in tools still work beside it" [:
  "g3" "telic-eval" { :session "h" :code "6 7 * . cr" } send-call
  next-answer answer-text "42 " expect=
:] test

server end-process

test-report
