\ lib/claude.telic: the pure words — message frames, the request body, the API
\ headers, response classification, extraction, and pricing. Nothing here calls
\ the API: every response frame is synthesised, so the test needs no key and no
\ network. Responses are http-request's { :status :body } (lib/http.telic).

"lib/claude.telic" load
"test-key" "ANTHROPIC_API_KEY" env!

\ === message frames ===
"hello" user-message . cr                    \ { :content hello :role user }
"sure" assistant-message . cr                \ { :content sure :role assistant }

clear

\ === request-body: the model and cap come from the globals ===
[ "hi" user-message ] request-body dup "claude-opus-4-8" has? . cr   \ 1
dup "65536" has? . cr                                               \ 1
"hello" has? . cr                                                   \ 0   the messages carry their own text

clear

\ === claude-headers: the key comes from the environment ===
claude-headers
dup [: "x-api-key: test-key" = :] any? . cr          \ 1
dup [: "anthropic-version: 2023-06-01" = :] any? . cr \ 1
size . cr                                            \ 3

clear

\ === response-ok?: status 200 and a :content array ===
{ :status 200 :body "{""content"":[{""text"":""hi""}]}" } response-ok? . cr   \ 1
{ :status 429 :body "{""content"":[]}" } response-ok? . cr                   \ 0   non-2xx status
{ :status 200 :body "{""error"":""nope""}" } response-ok? . cr               \ 0   no :content

clear

\ === extract-response: the text, or the failed call's body ===
{ :status 200 :body "{""content"":[{""text"":""the answer""}]}" } extract-response . cr  \ the answer
{ :status 401 :body "{""error"":""bad key""}" } extract-response . cr                    \ {"error":"bad key"} verbatim
{ :status 200 :body "{""error"":""nope""}" } extract-response . cr                       \ {"error": "nope"} re-rendered

clear

\ === pricing: rates are ¢ per token, so a call costs a fraction of a cent ===
"claude-opus-4-8" model-price :output @ . cr    \ 0.0075
"claude-sonnet-5" model-price :input @ . cr     \ 0.0003

{ :status 200
  :body "{""model"":""claude-opus-4-8"",""usage"":{""input_tokens"":1000,""output_tokens"":2000}}" }
response-cost . cr                              \ 16.5 ¢   1000*0.0015 + 2000*0.0075

{ :status 200 :body "{""model"":""claude-opus-4-8""}" } response-cost . cr   \ 0 $   no usage reported

cot-cost-ceiling . cr                           \ 491.52 ¢   65536 * 0.0075

clear

\ === errors ===
"no-such-model" model-price       \ (unpriced model)
