\ spectral_norm — matrix-based port using dgemm.
\ A is materialized as an NxN matrix at init; the inner mat-vec products run as
\ dgemm calls instead of through the interpreter. The statistics library is
\ loaded first so those calls reach the platform BLAS: binding is early, so the
\ load has to precede the definitions below for them to bind to the BLAS-backed
\ dgemm words rather than the built-in kernels. Native-only, as the FFI is.

"statistics" load-library

\ N is twice the scalar port's 130, so each BLAS call moves 4x the data, and the
\ loop count is high enough that the 40 calls per iteration dominate: what the row
\ measures is per-call cost, since both sides reach the same platform BLAS.
1000 to iterations
260 constant n

variable a-mat
variable u-mat
variable v-mat
variable zero-col

: eval-a ( i j -- a_ij )
  | i j |
  i j +  dup f1+ *  2 /  i +  1 +  1.0 swap / ;

( j i flat -- ) \ flat[i*n + j] = A_ij
: set-a
  | j i flat |
  flat  i n * j +  i j eval-a  !i drop ; internal

( i flat -- ) \ fill row i
: set-a-row
  ' set-a 2 ncurry  n i-times ; internal

: build-a ^a-mat |
  0 n n * array-of to flat
  flat ' set-a-row curry  n i-times
  flat n n matrix to a-mat ;

: build-u ^u-mat |
  1 n array-of  n 1 matrix to u-mat ;

: prep ^zero-col |
  n 1 0-matrix to zero-col
  build-a ;

\ ata-times ( x -- AtA*x ): compute A*x with dgemv-n, then At*(...) with dgemv-t.
\ These reach cblas_dgemv, which has less per-call setup than entering dgemm with
\ an n x 1 column.
: ata-times
  | x |
  1 a-mat x  0 zero-col  dgemv-n
  1 a-mat rot 0 zero-col dgemv-t ;

: one-loop
  build-u
  [: ^u-mat ^v-mat |
     u-mat ata-times to v-mat
     v-mat ata-times to u-mat :] 10 times ;

( sum i -- sum' ) \ add u_i * v_i
: add-uv  | sum i |  u-mat i 0 @i,j  v-mat i 0 @i,j  *  sum + ; internal

( sum i -- sum' ) \ add v_i squared
: add-vv  | sum i |  v-mat i 0 @i,j  dup *  sum + ; internal

: spectral-norm-run ( loops -- )
  to n_loops
  prep
  now to t0
  [: one-loop :] n_loops times
  "elapsed: " . now t0 - . "s" . cr

  0  ' add-uv  n i-times  to vBv
  0  ' add-vv  n i-times  to vv
  "spectral norm estimate: " . vBv vv / sqrt . cr ;

iterations spectral-norm-run
bye
