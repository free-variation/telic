\ nqueens — iterative permutation enumeration via itertools-style cycles
\ algorithm. No recursion; one swap (or one rotate) per generated permutation.

8 constant queens
45 constant loops
variable solutions
variable board
variable cycles

: bswap ( a b -- )
  | a b |
  board a @i
  board  board b @i  a  !i drop
  board swap b !i drop ;

: valid?
  [< [: i | board i @i i + :] queens i-times >] size queens =
  [< [: i | board i @i i - :] queens i-times >] size queens =
  * ;

: check-perm ^solutions |
  valid? if f++ solutions then ;

: rotate-left ( i -- )
  | i |
  i queens 1 - = if
    \ single-element rotate is a no-op
  else
    board i @i to tmp
    i to j
    begin
      board  board j f1+ @i  j  !i drop
      ++ j
      j queens 1 - =
    until
    board tmp  queens 1 -  !i drop
  then ;

: init-arrays ^board ^cycles |
  0 queens array-of to board
  [: k | board k k !i drop :] queens i-times
  0 queens array-of to cycles
  [: k | cycles  queens k -  k  !i drop :] queens i-times ;

: permute-all
  init-arrays
  check-perm
  0 to done
  begin
    queens 1 - to i
    0 to yielded
    0 to inner-done
    begin
      cycles  cycles i @i 1 -  i  !i drop
      cycles i @i 0 = if
        i rotate-left
        cycles  queens i -  i  !i drop
        i 1 - to i
      else
        cycles i @i to j
        i  queens j -  bswap
        check-perm
        1 to yielded
      then
      yielded if 1 to inner-done then
      i 0 < if 1 to inner-done then
      inner-done
    until
    yielded 0 = if 1 to done then
    done
  until ;

: nqueens-run ^solutions |
  now to t0
  0 loops 1 do rep
     0 to solutions
     permute-all
  loop
  "elapsed: " . now t0 - . "s" . cr
  "solutions: " . solutions . cr ;

nqueens-run
bye
