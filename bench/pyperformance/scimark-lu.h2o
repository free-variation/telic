\ scimark LU factorization (dense, partial pivoting), N=100 — direct port of
\ pyperformance bm_scimark's LU kernel. A is an array of row-arrays (so the
\ pivot row-swap is an O(1) reference swap, as in the reference's ArrayList).
\ Each cycle copies the pristine matrix into lu and factors it in place, exactly
\ like bench_LU. Cycle count comes from iterations.
\
\ The input is filled from scimark's Random(7) LCG; its initialized 17-element
\ state for seed 7 is hardcoded here (so the matrix matches the reference and
\ the factorization checksum is verifiable: 633.719856 at N=100).

100 to iterations
variable rm  variable ri  variable rj
2147483647.0 constant m1
4.656612875245797e-10 constant dm1

: rng-init ^rm ^ri ^rj |
  [ 253932.0 731212090.0 468995992.0 1775900326.0 1784309764.0 636090706.0
    606937648.0 841957950.0 1453856540.0 1744446058.0 305151944.0 1494977238.0
    896709940.0 1989340290.0 810774624.0 217839726.0 200215116.0 ] to rm
  4 to ri  16 to rj ;

: rng-next ( -- d ) ^ri ^rj |
  rm ri @i  rm rj @i  f-  to k
  k 0 < if  k m1 f+ to k  then
  rm rj k !i drop
  ri 0 = if 16 to ri else ri f1- to ri then
  rj 0 = if 16 to rj else rj f1- to rj then
  dm1 k f* ;

: build-empty ( n -- a )
   to n
  n  n iota  [: drop 0 2 pick array-of :] map  nip ;

( i a n -- ) \ fill row i of a with n random doubles
: fill-row
  | i a n |
  a i @i to arow
  0 n 1 do k
    arow k rng-next !i drop
  loop ;

: build-filled ( n -- a )
   to n  n build-empty to a
  0 n 1 do r  r a n fill-row  loop
  a ;

( i src dst n -- ) \ copy n elements of row i, element by element
: copy-row
  | i src dst n |
  src i @i to srow
  dst i @i to drow
  0 n 1 do k
    drow k  srow k @i  !i drop
  loop ;

: copy-into ( src dst n -- )
   to n to dst to src
  0 n 1 do r  r src dst n copy-row  loop ;

: lu-factor ( a n -- )
  to n  to a
  0 n 1 do j
    j to jp
    a j @i j @i fabs to t
    j 1+ n 1 do i
      a i @i j @i fabs  dup t > if i to jp to t else drop then
    loop
    j jp = 0 = if
      a j @i to rowj  a j  a jp @i  !i drop  a jp  rowj  !i drop
    then
    1.0 a j @i j @i f/ to recp
    j 1+ n 1 do i
      a i @i  j  a i @i j @i recp f*  !i drop
    loop
    j 1+ n 1 do ii
      a ii @i j @i to aiij  a ii @i to aii  a j @i to aj
      j 1+ n 1 do jj
        aii jj  aii jj @i aiij aj jj @i f* f-  !i drop
      loop
    loop
  loop ;

( sum i a n -- sum' ) \ add row i's n elements to the running sum
: add-row
  | sum i a n |
  a i @i to arow
  sum
  0 n 1 do k
    arow k @i f+
  loop ;

: checksum ( a n -- s )
   to n to a
  0
  0 n 1 do r  r a n add-row  loop ;

( a lu n -- ) \ one measured round: refresh lu from a, then factor it
: lu-round
  | a lu n | a lu n copy-into  lu n lu-factor ;

: lu-bench ( n cycles -- )
   to cycles to n
  rng-init  n build-filled to a  n build-empty to lu
  now to t0
  0 cycles 1 do c  a lu n lu-round  loop
  "elapsed: " . now t0 - . "s" . cr
  lu n checksum "checksum: {0}" format . cr ;

100 iterations lu-bench
bye
