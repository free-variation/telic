\ fannkuch_redux — port of pyperformance bm_fannkuch.
\ For all N! permutations of [0..N-1], compute "pancake flip count":
\ repeatedly reverse PERM[0..PERM[0]] until PERM[0] = 0. Return max count.
\
\ Permutations are generated via the cycle-rotation algorithm (same family
\ as itertools.permutations).

9 constant n
6 constant loops
variable perm1
variable perm
variable count
variable max-flips

: init-arrays ^perm1 ^perm ^count |
  0 n array-of to perm1
  [: dup perm1 swap rot !i drop :] n i-times
  0 n array-of to perm
  [: dup perm swap rot !i drop :] n i-times
  0 n array-of to count
  [: dup f1+ swap count -rot !i drop :] n i-times ;

: copy-perm1
  perm1 0 1 n perm 0 slice! drop ;
inline

: flip-perm ( k -- )        \ reverse perm[0..k] inclusive, matching Python's perm[:k+1] = perm[k::-1]
  perm swap -1 over f1+ perm 0 slice! drop ;

: count-flips ( -- flips )
  0
  begin perm 0 @i dup while
    flip-perm
    f1+
  repeat
  drop ;

: rotate-perm1 ( r -- )
  dup 0 = if
    drop
  else
    perm1 0 @i >r
    >r
    perm1 1 1 r@ perm1 0 slice! drop
    perm1 r> r> swap !i drop
  then ;
inline

: update-max ( flips -- ) ^max-flips |
  dup max-flips > if to max-flips else drop then ;

: fannkuch ^max-flips |
  0 to max-flips
  init-arrays
  n to r

  begin
    \ Reset COUNT[r-1..0]
    begin r 1 > while
      count r  r f1-  !i drop
      f-- r
    repeat

    \ Skip equivalent perms
    perm1 0 @i if
      perm1 n f1- @i n f1- = 0 = if
        copy-perm1
        count-flips update-max
      then
    then

    \ Advance permutation
    0 to all-done
    begin
      r n = if
        1 to all-done
        -1
      else
        r rotate-perm1
        count  count r @i f1-  r  !i drop
        count r @i 0 > if
          -1
        else
          f++ r
          0
        then
      then
    until

    all-done
  until ;

: fannkuch-run
  now to t0
  0 loops 1 do rep  fannkuch  loop
  "elapsed: " . now t0 - . "s" . cr
  "max flips: " . max-flips . cr ;

fannkuch-run
bye
