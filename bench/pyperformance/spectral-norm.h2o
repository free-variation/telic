\ spectral_norm — port of the pyperformance benchmark.
\ Computes the spectral norm of an infinite-dimensional matrix A where
\ A(i,j) = 1.0 / ((i+j)*(i+j+1)/2 + i + 1)
\
\ Algorithm: power iteration on AtA. Start u = [1]*N, loop 10 times:
\   v = AtA * u;  u = AtA * v
\ where AtA*x = At*(A*x).
\
\ vBv / vv at the end is the spectral norm estimate (printed for verification;
\ not part of the timed work in pyperformance).

50 to iterations
130 constant n

: eval_A ( i j -- A_ij )
  over f+  dup f1+ f*  2 f/  f+  f1+  1.0 swap f/ ;
inline

\ fold-times keeps the running sum in the combinator: the body maps an index to
\ one term and `' f+` combines, so the sum never reaches the data stack. i and u
\ are parked below the index and read by depth. No swap in the body: a swap in a
\ hot body measured 7.6 ns against ~1.2 for an ordinary op
: part_A_times_u ( i u -- partial_sum )
  | i u |
  i u
  0 [: 2 pick 1 pick eval_A  2 pick 2 pick @i  f*  nip :] ' f+ u size fold-times
  nip nip ;

: part_At_times_u ( i u -- partial_sum )
  | i u |
  i u
  0 [: dup 3 pick eval_A  2 pick 2 pick @i  f*  nip :] ' f+ u size fold-times
  nip nip ;

\ eval_times_u: apply func to each (i, u) for i in 0..len(u)-1, gather into a new array.
: eval_times_u ( u xt -- new-u )
  | u xt |
  0 u size 1 do i
     i u xt execute
  loop
  u size array ;

: eval_AtA_times_u ( u -- new-u )
  ' part_A_times_u eval_times_u
  ' part_At_times_u eval_times_u ;

: spectral-norm-run ( loops -- )
  to n_loops
  now to t0
  0 n_loops 1 do loop-round
     1 n array-of to u
     0 10 1 do it
        u eval_AtA_times_u to v
        v eval_AtA_times_u to u
     loop
     \ vBv = sum u_i * v_i, vv = sum v_i * v_i (correctness check)
     0 to vBv  0 to vv
     0 n 1 do index
        u index @i  v index @i  *  vBv + to vBv
        v index @i  dup *  vv + to vv
     loop
  loop
  "elapsed: " . now t0 - . "s" . cr
  "spectral norm estimate: " . vBv vv / sqrt . cr ;

iterations spectral-norm-run
bye
