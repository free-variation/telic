\ scimark FFT — port of pyperformance bm_scimark's 1D complex FFT kernel
\ (radix-2 Cooley-Tukey, in place). DATA holds N complex points as 2N interleaved
\ doubles (real, imag, ...). Each outer loop copies the RNG-seeded input, then
\ runs cycles forward+inverse round-trips. The reference's `<<1` / `>>1` are
\ shifts by one — i.e. ·2 and //2 — so no bitwise operator is needed.
\
\ Input is scimark's Random(7) RandomVector (as in the reference). Checksum is the
\ sum of DATA after the timed loop (a forward+inverse pair is the identity up to
\ rounding, accumulated identically in both runtimes). Build is untimed.

5 to loops
50 to cycles
variable rand-m  variable ri  variable rj
2147483647.0 constant m1
1.0 2147483647.0 f/ constant dm1

variable init  variable data
1024.0 constant npts          \ complex points
2048.0 constant nlen          \ data length = 2·NPTS

: rng-init ( seed -- )
  | seed ^rand-m ^ri ^rj |
  seed fabs to seed
  seed m1 < 0= if m1 to seed then
  seed 2.0 mod 0.0 = if seed 1.0 f- to seed then
  9069.0 65536.0 mod to k0
  9069.0 65536.0 f/ to k1
  seed 65536.0 mod to j0
  seed 65536.0 f/ to j1
  17.0 double-segment to rand-m
  0 17 1 do slot
     j0 k0 f* to jseed
     jseed 65536.0 f/  j0 k1 f* f+  j1 k0 f* f+  32768.0 fmod to j1
     jseed 65536.0 mod to j0
     rand-m slot  j0 65536.0 j1 f* f+  !i drop
  loop
  4.0 to ri  16.0 to rj ;

: next-double ( -- d ) ^ri ^rj |
  ri to ii  rj to jj
  rand-m ii @i  rand-m jj @i f- to k
  k 0.0 < if k m1 f+ to k then
  rand-m jj k !i drop
  ii 0.0 = if 16.0 to ii else ii 1.0 f- to ii then  ii to ri
  jj 0.0 = if 16.0 to jj else jj 1.0 f- to jj then  jj to rj
  dm1 k f* ;

: int-log2 ( n -- log )
  | n |
  1.0 to k  0.0 to power
  begin k n < while  k 2.0 f* to k  power 1.0 f+ to power  repeat
  power ;

: fft-bitreverse ( -- )            \ permute DATA into bit-reversed order
  nlen 2.0 / to n
  n 1.0 f- to nm1
  0.0 to j
  0 nm1 1 do i
     i 2.0 f* to ii
     j 2.0 f* to jj
     n 2.0 / ftruncate to k
     i j < if
        data ii @i to tr
        data ii 1.0 f+ @i to ti
        data ii  data jj @i  !i drop
        data ii 1.0 f+  data jj 1.0 f+ @i  !i drop
        data jj tr !i drop
        data jj 1.0 f+ ti !i drop
     then
     begin j k < 0= while  j k f- to j  k 2.0 / ftruncate to k  repeat
     j k f+ to j
  loop ;

: fft-transform-internal ( direction -- )
  | direction |
  nlen 2.0 / to n
  n 1.0 = if exit then
  n int-log2 to logn
  fft-bitreverse
  1.0 to dual
  0 logn 1 do bit
     1.0 to wr  0.0 to wi
     2.0 direction f* PI f* 2.0 dual f* f/ to theta
     theta fsin to sine
     theta 2.0 f/ fsin to t
     2.0 t f* t f* to sine-squared
     0 n dual 2.0 f* do b
        b 2.0 f* to ii
        ii dual 2.0 f* f+ to jj
        ii 1.0 f+ to ii1
        jj 1.0 f+ to jj1
        data jj @i to wdr
        data jj1 @i to wdi
        data ii @i to xr
        data ii1 @i to xi
        data jj   xr wdr f-  !i drop
        data jj1  xi wdi f-  !i drop
        data ii   xr wdr f+  !i drop
        data ii1  xi wdi f+  !i drop
     loop
     1 dual 1 do a
        wr sine wi f* f-  sine-squared wr f* f-  to ii    \ reuse ii as tmp_real
        wi sine wr f* f+  sine-squared wi f* f-  to jj    \ reuse jj as tmp_imag
        ii to wr  jj to wi
        0 n dual 2.0 f* do b
           b a f+ 2.0 f* to ii
           ii dual 2.0 f* f+ to jj
           ii 1.0 f+ to ii1
           jj 1.0 f+ to jj1
           data jj @i to z1r
           data jj1 @i to z1i
           wr z1r f* wi z1i f* f- to wdr
           wr z1i f* wi z1r f* f+ to wdi
           data ii @i to xr
           data ii1 @i to xi
           data jj   xr wdr f-  !i drop
           data jj1  xi wdi f-  !i drop
           data ii   xr wdr f+  !i drop
           data ii1  xi wdi f+  !i drop
        loop
     loop
     dual 2.0 f* to dual
  loop ;

: fft-inverse ( -- )
  1.0 fft-transform-internal
  1.0  nlen 2.0 f/  f/ to scale
  0 nlen 1 do k
    data k  data k @i scale f*  !i drop
  loop ;

: fft-bench ^init ^data |
  nlen double-segment to init
  nlen double-segment to data
  7.0 rng-init
  0 nlen 1 do k  init k next-double !i drop  loop
  now to t0
  0 loops 1 do l0
     0 nlen 1 do k  data k  init k @i  !i drop  loop
     0 cycles 1 do c  -1.0 fft-transform-internal fft-inverse  loop
  loop
  now t0 - to t0
  0.0
  0 nlen 1 do k  data k @i f+  loop
  to checksum
  "elapsed: " . t0 . " s" . cr
  checksum "checksum: {0}" format . cr ;

fft-bench
bye
