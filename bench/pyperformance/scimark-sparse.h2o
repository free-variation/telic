\ scimark SparseMatMult — port of pyperformance bm_scimark's sparse matrix x
\ vector kernel. A compressed-row sparse matrix (N rows, NR nonzeros/row) times a
\ dense vector, repeated cycles times. The row/col sparsity structure matches the
\ reference exactly, and val and x are left zero as bench_SparseMatMult leaves
\ them, so this measures loop throughput and the checksum (sum of the result
\ vector) is 0; the matvec arithmetic on seeded data is checked by
\ tests/152_scimark_kernels.h2o. Build is untimed; only the cycles sweeps are
\ measured.

500 to cycles

variable row  variable col  variable val  variable x  variable y
1000.0 constant n
50000.0 constant nz
50.0 constant nr
50000.0 constant anz

: build-sparse ^row ^col ^val ^x ^y |
  n 1.0 f+ double-segment to row
  nz double-segment to col
  anz double-segment to val
  n double-segment to x
  n double-segment to y
  row 0.0 0.0 !i drop
  [: r |
     row r @i to rowr
     row r 1.0 f+  rowr nr f+  !i drop
     r nr / ftruncate to step
     step 1.0 < if 1.0 to step then
     rowr step
     [: dup 3 pick f+  col swap  rot 3 pick f*  !i drop :] nr i-times
     drop drop
  :] n i-times ;

: sparse-matmult
  [:
     [: r |
        row r @i to lo
        row r 1.0 f+ @i to hi
        lo 0.0
        [: k | 1 pick k f+ to i  x col i @i @i  val i @i f*  f+ :] hi lo f- i-times
        nip
        y r rot !i drop
     :] n i-times
  :] cycles times ;

: sparse-checksum ( -- s )

  0.0
  [: y swap @i f+ :] n i-times
  to total
  total ;

: sparse-bench
  build-sparse
  now to t0
  sparse-matmult
  now t0 - to t0
  "elapsed: " . t0 . " s" . cr
  sparse-checksum "checksum: {0}" format . cr ;

sparse-bench
bye
