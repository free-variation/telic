\ SQLite load test — stresses telic's result materialization and column
\ queries, NOT sqlite. A recursive CTE generates the rows, so sqlite does
\ negligible work; the load is db-query building an N-row dataset (a numeric
\ vector plus a string per cat cell), then query masking the text column and
\ group-indices sorting it.
\
\ Run:  ./telic -b < bench/load/sqlite-load.telic
\ The default 64M object ceiling is never hit, so the build just grows the
\ table. To force GC during the build — exercising the gc_root discipline
\ around the column arrays — lower the ceiling near the live set:
\   ./telic -b --max-objects 4000000 < bench/load/sqlite-load.telic

1000000 constant row-count

":memory:" db-open to db

\ --- db-query: materialize N rows from a cheap recursive CTE ---
now to t
db row-count "WITH RECURSIVE seq(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n < {0}) SELECT n AS id, 'cat' || (n % 50) AS cat FROM seq" format [ ] db-query to result
"db-query:     " . now t - . "s" . cr
result n-rows                                        "  rows materialized = {0}  (want 1000000)" format . cr
result :id @ sum                                     "  sum of ids       = {0}  (want 500000500000)" format . cr

\ --- query: mask the text column over N rows ---
now to t
result { :cat "cat7" } query n-rows                  "  cat7 rows        = {0}  (want 20000)" format . cr
"query:        " . now t - . "s" . cr

\ --- group-indices: sort the text column and cut it into runs ---
now to t
result :cat @ group-indices to groups
"group-indices:" . now t - . "s" . cr
groups size                                          "  distinct cats    = {0}  (want 50)" format . cr
groups 0 [: 1 @i size + :] reduce                    "  total indexed    = {0}  (want 1000000)" format . cr

db db-close
bye
